  # ═══════════════════════════════════════════════════════════════════════
  # TEG mTLS SIDECAR (§XFRAMETEG 2026-09-04)
  # ═══════════════════════════════════════════════════════════════════════
  # A PEER FRAME's registry dials this directly. `FX_RATE_MODE=pool` prices a
  # cross-frame move off BOTH frames' `fx_reserve`, so the source frame reads
  # `/api/v1/admin/fx/reserve` on the DESTINATION frame's TEG over mTLS. Without
  # this service that read had nowhere to land — `_resolve_dest_teg_mtls_base`
  # fell through to the peer's REGISTRY vhost, which 404s a TEG route, and every
  # cross-registry transfer between two fresh frames answered 503 "FX pool:
  # reserve read failed". Frame A has had `nginx-teg-a` on the identity network
  # all along; this template simply never carried the service.
  #
  # ⚠ ON BOTH NETWORKS, unlike the cloud-operator sidecar, which is deliberately
  # frame-local. A frame's TEG sidecar is peer-facing by design.
  # ⚠ NOT host-exposed: peers reach it by container DNS on the shared identity
  # net, so a host port would add surface without adding reach.
  {{REGISTRY_NAME}}-nginx-teg:
    image: nginx:1.30.5-alpine
    container_name: {{REGISTRY_NAME}}-nginx-teg
    restart: unless-stopped
    volumes:
      # §MTLSHOPS G1 (2026-09-15): mounted as a TEMPLATE; the entrypoint substitutes the TEG's proxy marker at start.
      - {{STACK_DIR}}/nginx-teg-frame-test.conf:/etc/nginx/templates/teg.conf.template:ro
      - {{STACK_DIR}}/nginx-entrypoint.sh:/opt/nginx-entrypoint.sh:ro
      - {{VOL_PREFIX}}_nginx_teg_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_sock_teg_{{TS}}:/sock/teg
    environment:
      CERT_DIR: ${FT_CERT_DIR}
      RELOAD_SEC: ${FT_NGT_RELOAD_SEC}
      SERVICE_NAME: ${FT_NGT_SERVICE_NAME}
      TEG_PROXY_TRUST_SECRET: ${FT_NGT_PROXY_TRUST_SECRET}
    entrypoint: ["/bin/sh", "-c", "envsubst '$$TEG_PROXY_TRUST_SECRET' < /etc/nginx/templates/teg.conf.template > /etc/nginx/conf.d/default.conf && exec /bin/sh /opt/nginx-entrypoint.sh"]
    networks:
      - {{NET_NAME}}
      - {{IDENTITY_NET_NAME}}
    depends_on:
      {{REGISTRY_NAME}}-cert-writer:
        condition: service_started
      {{REGISTRY_NAME}}-teg:
        condition: service_healthy
    healthcheck:
      # Plain-HTTP :8080 health server inside the conf. Deliberately NOT the
      # mTLS port: a healthcheck that needs a client cert reports the CERT's
      # state, not the proxy's, and would mark a working sidecar unhealthy.
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    labels:
      - "com.agentvault.service=nginx-teg-{{REGISTRY_NAME}}"
    logging: *default-logging

  # ═══════════════════════════════════════════════════════════════════════
  # EVENTSTORE mTLS SIDECAR (§MTLSGAP 2026-09-08)
  # ═══════════════════════════════════════════════════════════════════════
  # His word: *"everything is mtls enforced … not acceptable for sandbox, it should be a
  # realistic env."* Measured, the sandbox was exactly as realistic as production: this template
  # rendered `-nginx-federation` and `-nginx-teg` and NO ES equivalent, so no frame ever stood up
  # from it has had one, and every registry writes to its own ledger over plain http. The only ES
  # gateway in the fleet is Frame A's — on the frame being retired.
  #
  # ⚠ ALONGSIDE plain http, not instead of it. `FT_EVENT_STORE_URL` is unchanged by this service;
  # moving the writers onto the gateway is a separate deliberate step (§BATCH7: a bundle
  # snapshotted at boot is the trust set of that boot).
  # ⚠ NOT host-exposed. Callers reach it by container DNS on the frame's networks, so a host port
  # would add surface without adding reach — the same reasoning as the TEG sidecar above.
  {{REGISTRY_NAME}}-nginx-event-store:
    image: nginx:1.30.5-alpine
    container_name: {{REGISTRY_NAME}}-nginx-event-store
    restart: unless-stopped
    volumes:
      # Mounted as a TEMPLATE: the entrypoint wrapper substitutes the ONE proxy-marker variable into conf.d at start
      # (the secret stays in the env file and the container env, never in a rendered file at rest in the stack dir).
      - {{STACK_DIR}}/nginx-event-store-frame-test.conf:/etc/nginx/templates/event-store.conf.template:ro
      - {{STACK_DIR}}/nginx-entrypoint.sh:/opt/nginx-entrypoint.sh:ro
      - {{VOL_PREFIX}}_nginx_event_store_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_sock_event-store_{{TS}}:/sock/event-store
    environment:
      CERT_DIR: ${FT_CERT_DIR}
      RELOAD_SEC: ${FT_NGES_RELOAD_SEC}
      SERVICE_NAME: ${FT_NGES_SERVICE_NAME}
      ES_PROXY_TRUST_SECRET: ${FT_NGES_PROXY_TRUST_SECRET}
    entrypoint: ["/bin/sh", "-c", "envsubst '$$ES_PROXY_TRUST_SECRET' < /etc/nginx/templates/event-store.conf.template > /etc/nginx/conf.d/default.conf && exec /bin/sh /opt/nginx-entrypoint.sh"]
    networks:
      - {{NET_NAME}}
      - {{IDENTITY_NET_NAME}}
    depends_on:
      {{REGISTRY_NAME}}-cert-writer:
        condition: service_started
      {{REGISTRY_NAME}}-event-store:
        condition: service_started
    healthcheck:
      # Plain-HTTP :8080 health server inside the conf, deliberately NOT the mTLS port: a
      # healthcheck that needs a client cert reports the CERT's state, not the proxy's.
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    labels:
      - "com.agentvault.service=nginx-event-store-{{REGISTRY_NAME}}"
    logging: *default-logging

  # ═══════════════════════════════════════════════════════════════════════
  # EVENTSTORE
  # ═══════════════════════════════════════════════════════════════════════

  {{REGISTRY_NAME}}-event-store:
    # §SOVKIT: the driver names the store's image (--es-image, the runner's images.event_store allowlist), the same
    # shape as FT_REG_IMAGE / FT_TEG_IMAGE; the default is the last local build, for a hand-run standup only.
    image: ${FT_ES_IMAGE:-agentvault2-event-store-test:latest}
    container_name: {{REGISTRY_NAME}}-event-store
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql+asyncpg://eventstore:${PG_PASS_EVENT_STORE}@{{REGISTRY_NAME}}-es-db:5432/frame_test_events
      DATABASE_URL_SYNC: postgresql://eventstore:${PG_PASS_EVENT_STORE}@{{REGISTRY_NAME}}-es-db:5432/frame_test_events
      # §MTLSHOPS T3: asyncpg reads these four (verify-full against the data SVID's names); it reads the key as the
      # cert-writer writes it, so no private copy
      PGSSLMODE: ${FT_PGSSLMODE}
      PGSSLROOTCERT: ${FT_PGTLS_CERTS_ROOTCERT}
      PGSSLCERT: ${FT_PGTLS_CERTS_CERT}
      PGSSLKEY: ${FT_PGTLS_CERTS_KEY}
      INTERNAL_API_KEY: ${EVENT_STORE_INTERNAL_API_KEY}
      REDIS_URL: ${FT_ES_REDIS_URL}
      UVICORN_WORKERS: ${FT_ES_UVICORN_WORKERS}
      TRUSTED_SPIFFE_DOMAINS: ${FT_TRUSTED_SPIFFE_DOMAINS}
      CROSS_FRAME_REPLICATION_ENABLED: ${FT_ES_CROSS_FRAME_REPLICATION_ENABLED}
      CROSS_FRAME_PEERS: ${FT_ES_CROSS_FRAME_PEERS}
      KAFKA_ENABLED: ${FT_KAFKA_ENABLED}
      KAFKA_BOOTSTRAP_SERVERS: ${FT_KAFKA_BOOTSTRAP_SERVERS}
      EVENTSTORE_HTTP_VIA_KAFKA: ${FT_ES_EVENTSTORE_HTTP_VIA_KAFKA}
      # ── Fleet baseline (2026-09-04) ─────────────────────────────────────
      # WS clients present a SPIRE JWT-SVID; the ES validates it against the
      # registry's JWKS. Absent, the audience/JWKS are unset and the socket
      # cannot authenticate anyone — both live sandbox frames hand-added these.
      EVENTSTORE_JWT_AUDIENCE: ${FT_ES_EVENTSTORE_JWT_AUDIENCE}
      EVENTSTORE_JWT_JWKS_URL: ${FT_ES_EVENTSTORE_JWT_JWKS_URL}
      EVENTSTORE_WS_AUTH_REQUIRED: ${FT_ES_EVENTSTORE_WS_AUTH_REQUIRED}
      KNOWN_INTERNAL_SERVICES: ${FT_ES_KNOWN_INTERNAL_SERVICES}
      # §SOVKIT T2 (agentvault2-85): mTLS required from birth; the proxy marker its terminators must carry; its own td.
      ES_PROXY_TRUST_SECRET: ${FT_ES_ES_PROXY_TRUST_SECRET}
      EVENTSTORE_MTLS_REQUIRED: ${FT_ES_EVENTSTORE_MTLS_REQUIRED}
      ES_OWN_TRUST_DOMAIN: ${FT_ES_ES_OWN_TRUST_DOMAIN}
      KAFKA_CONSUMER_BATCH_SIZE: ${FT_ES_KAFKA_CONSUMER_BATCH_SIZE}
      KAFKA_CONSUMER_BATCH_TIMEOUT_MS: ${FT_ES_KAFKA_CONSUMER_BATCH_TIMEOUT_MS}
      # §SOVKIT K1 (2026-09-14, his word "2 yes"): the ONLY client of the ledger broker. SCRAM over TLS verified against
      # the frame's bundle (the broker serves the frame's SVID), and every record signed: the consumer takes a record only
      # when this store signed it (agentvault2-85's R1, ES_KAFKA_RECORD_AUTH=enforce from birth).
      KAFKA_SECURITY_PROTOCOL: ${FT_ES_KAFKA_SECURITY_PROTOCOL}
      KAFKA_SASL_MECHANISM: ${FT_ES_KAFKA_SASL_MECHANISM}
      KAFKA_SASL_USERNAME: ${FT_ES_KAFKA_SASL_USERNAME}
      KAFKA_SASL_PASSWORD: ${FT_ES_KAFKA_SASL_PASSWORD}
      KAFKA_SSL_CAFILE: ${FT_ES_KAFKA_SSL_CAFILE}
      ES_KAFKA_RECORD_AUTH: ${FT_ES_KAFKA_RECORD_AUTH}
      FRAME_CURRENCY: ${FT_FRAME_CURRENCY}
      PROMETHEUS_MULTIPROC_DIR: ${FT_ES_PROMETHEUS_MULTIPROC_DIR}
    volumes:
      - {{VOL_PREFIX}}_es_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_sock_event-store_{{TS}}:/sock/event-store
    tmpfs:
      - /tmp/prom_multiproc_es:size=16m,mode=1777
    # §MTLSHOPS T2 (S4, 2026-09-15): the store listens on a unix socket shared with nginx-event-store (the in-frame mTLS
    # lane) and nginx-edge (the host's door) alone; a multi-worker parent refuses a socket file a killed run left, so the
    # command removes it first. Its health is asked over that socket.
    networks:
      - {{NET_NAME}}
      - {{IDENTITY_NET_NAME}}
      - {{NET_NAME}}_ledger   # §SOVKIT K1: the broker's network; the store and the broker are its only members
    depends_on:
      {{REGISTRY_NAME}}-es-db:
        condition: service_healthy
      {{REGISTRY_NAME}}-redis:
        condition: service_healthy
      # §SOVKIT K1: the topics exist (explicit partitions, auto-create is off) before the store's first connect
      {{REGISTRY_NAME}}-redpanda-init:
        condition: service_completed_successfully
    command: ["sh", "-c", "umask 000 && rm -f /sock/event-store/event-store.sock && exec uvicorn src.main:app --uds /sock/event-store/event-store.sock --workers {{WORKERS_ES}}"]
    healthcheck:
      test: ["CMD", "python", "-c", "import http.client, socket, sys\nclass C(http.client.HTTPConnection):\n    def connect(self):\n        self.sock = socket.socket(socket.AF_UNIX); self.sock.settimeout(4); self.sock.connect('/sock/event-store/event-store.sock')\nc = C('localhost'); c.request('GET', '/health'); sys.exit(0 if c.getresponse().status == 200 else 1)"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging: *default-logging

  # ═══════════════════════════════════════════════════════════════════════
  # TEG LAYER
  # ═══════════════════════════════════════════════════════════════════════

  {{REGISTRY_NAME}}-teg:
    image: ${FT_TEG_IMAGE:-agentvault2-teg-layer-test:latest}
    container_name: {{REGISTRY_NAME}}-teg
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql://teg:${PG_PASS_TEG}@{{REGISTRY_NAME}}-teg-db:5432/frame_test_teg
      DATABASE_URL_SYNC: postgresql://teg:${PG_PASS_TEG}@{{REGISTRY_NAME}}-teg-db:5432/frame_test_teg
      # §MTLSHOPS T3: libpq and asyncpg read these four (verify-full against the data SVID's names), from the private copy
      # kit/data-tls/tls-client-sync.sh keeps, because libpq refuses the 0644 key the cert-writer writes
      PGSSLMODE: ${FT_PGSSLMODE}
      PGSSLROOTCERT: ${FT_PGTLS_COPY_ROOTCERT}
      PGSSLCERT: ${FT_PGTLS_COPY_CERT}
      PGSSLKEY: ${FT_PGTLS_COPY_KEY}
      ADMIN_API_KEY: ${TEG_ADMIN_API_KEY}
      # CB-049: the TEG checks the registry's exchange JWT with this key; the registry signs with its API_KEY_SECRET
      REGISTRY_JWT_SECRET: ${API_KEY_SECRET}
      # §MONEY-M3a (R26/R32, 2026-09-03): the TEG now REQUIRES these two with no default.
      # Missing ⇒ Settings() raises at import, the TEG never binds :8080, and the registry —
      # gated on `teg: service_healthy` — stays in `Created` forever.
      # ⚠ These come from the PROVISIONER (generated per run), not from
      # .env.frame-test — that file is .gitignore'd (`.env.*`), so it is NOT in
      # the repo and drifted out of step with this template: the two refs below
      # were added as ${...} by 0b097d8 and the env template never defined them.
      # A fresh provision therefore rendered them EMPTY, and secure_config.py
      # declares both `Field(..., min_length=32)` — pydantic raises at import,
      # the TEG never binds :8080, and the registry (gated on `teg:
      # service_healthy`) sits in `Created` for ever. Tracked placeholders make
      # the contract reproducible from the repo alone.
      TEG_TOKEN_SIGNING_KEY: ${FT_TEG_TEG_TOKEN_SIGNING_KEY}
      AVTP_SYSTEM_API_KEY: ${FT_TEG_AVTP_SYSTEM_API_KEY}
      EVENT_STORE_URL: ${FT_EVENT_STORE_MTLS_URL}  # §SOVKIT T5: the store's mTLS sidecar (the auditor keeps the plain hop)
      EVENT_STORE_API_KEY: ${EVENT_STORE_INTERNAL_API_KEY}
      REGISTRY_URL: ${FT_TEG_REGISTRY_URL}
      TEG_ID: ${FT_TEG_TEG_ID}
      # §MTLSHOPS G1: X-SSL-Client-* count only beside X-TEG-Proxy-Auth equal to this and a SUCCESS verdict.
      TEG_PROXY_TRUST_SECRET: ${FT_TEG_TEG_PROXY_TRUST_SECRET}
      # §SECFIX-2 (2026-09-25): the shared admin key no longer authenticates; every internal caller presents its SVID
      TEG_MTLS_REQUIRED: ${FT_TEG_MTLS_REQUIRED}
      MINTING_AUTHORITY: ${FT_MINTING_AUTHORITY}
      REDIS_URL: ${FT_TEG_REDIS_URL}
      PARTNER_TEGS: ${PARTNER_TEGS:-[]}
      CROSS_TEG_ENABLED: ${FT_TEG_CROSS_TEG_ENABLED}
      SPIFFE_ENDPOINT_SOCKET: ${FT_SPIFFE_ENDPOINT_SOCKET}
      SPIRE_TRUST_DOMAIN: ${FT_SPIRE_TRUST_DOMAIN}
      TRUSTED_SPIFFE_DOMAINS: ${FT_TRUSTED_SPIFFE_DOMAINS}
      # ── Money baseline (§MONEY-NS, 2026-09-04) ──────────────────────────
      # THE BALANCE OUTBOX IS THE ONLY WRITER OF THE ES BALANCE PROJECTION, and
      # its source default is "false". Absent, balance_ledger_journal fills and
      # NOTHING reaches the EventStore: the first issuance raises tokens_issued while
      # total_circulating stays 0 ⇒ Δ BREACH on a brand-new frame. It is also what
      # stamps `frame: <TEG_ID>` on every LedgerBalanceChanged — the key the ES
      # projection namespaces system accounts by — so without it this frame's
      # treasury/fee_collector rows never form at all. Both live sandbox frames
      # had to hand-add it at standup; that is what this line ends.
      TEG_BALANCE_OUTBOX_ENABLED: ${FT_TEG_TEG_BALANCE_OUTBOX_ENABLED}
      # §LEDGERGATE (2026-10-12, contract R40): the ledger gate refuses a money movement while the outbox above
      # cannot reach the store (off | shadow | enforce; the code default off). A TEG image without the gate ignores it.
      TEG_LEDGER_GATE_MODE: ${FT_TEG_TEG_LEDGER_GATE_MODE}
      # the TEG-to-TEG partner rule (enforce | shadow | off; the code default enforce, a frame born here shadow until its
      # trust with its peers is proven). A TEG image without the rule ignores it.
      CROSS_TEG_PARTNER_RULE_MODE: ${FT_TEG_CROSS_TEG_PARTNER_RULE_MODE}
      # ── the fresh posture, TEG side (D8 + the profile's TEG knobs) ──
      TEG_ONBOARDING_MINT_ENABLED: ${FT_TEG_TEG_ONBOARDING_MINT_ENABLED}
      TEG_STAKING_REWARD_CYCLE_ENABLED: ${FT_TEG_TEG_STAKING_REWARD_CYCLE_ENABLED}
      TEG_TRANSFER_MAX_AVT: ${FT_TEG_TEG_TRANSFER_MAX_AVT}
      TEG_MINT_MAX_AVT: ${FT_TEG_TEG_MINT_MAX_AVT}
      # Issuance is Registry-native (§MINTSECRET): the TEG accepts an issuance ONLY
      # behind the registry's issuance proxy. BOTH sides must carry the SAME secret —
      # the registry sends X-Mint-Proxy-Secret, the TEG compares it — so the
      # placeholder is rendered into this service AND the registry service.
      TEG_MINT_REQUIRE_PROXY: ${FT_TEG_TEG_MINT_REQUIRE_PROXY}
      MINT_PROXY_SECRET: ${FT_MINT_PROXY_SECRET}
      # §MONEY-R50 (2026-09-04): CROSS_TEG_FUND_ORIGIN_ALLOWLIST used to sit HERE — and the
      # TEG never reads it. Its only reader is the registry's origin guard
      # (routers/teg_integration.py), so it is rendered on the registry service below.
      TEG_HOME_FRAME_GUARD_ENABLED: ${FT_TEG_TEG_HOME_FRAME_GUARD_ENABLED}
      TEG_BULK_USE_ASYNC_DB: ${FT_TEG_TEG_BULK_USE_ASYNC_DB}
      ESCROW_RECONCILER_ENABLED: ${FT_TEG_ESCROW_RECONCILER_ENABLED}
      ESCROW_RECONCILER_DRY_RUN: ${FT_TEG_ESCROW_RECONCILER_DRY_RUN}
      FRAME_CURRENCY: ${FT_FRAME_CURRENCY}
      TEG_BATCH_WRITES: ${FT_TEG_TEG_BATCH_WRITES}
      TEG_BATCH_FLUSH_INTERVAL_MS: ${FT_TEG_TEG_BATCH_FLUSH_INTERVAL_MS}
      TEG_BATCH_MAX_SIZE: ${FT_TEG_TEG_BATCH_MAX_SIZE}
      PROMETHEUS_MULTIPROC_DIR: ${FT_TEG_PROMETHEUS_MULTIPROC_DIR}
    tmpfs:
      - /tmp/prom_multiproc_teg:size=16m,mode=1777
      - /run/pgtls:size=1m,mode=1777   # §MTLSHOPS T3: tls-client-sync's 0700 directory
    command: >
      sh -c "sh /opt/data-tls/tls-client-sync.sh & until [ -s /run/pgtls/client/bundle.0.pem ]; do sleep 1; done;
             echo 'Waiting for PostgreSQL...' &&
             cd /app &&
             python -m src.teg_core_service.migration_bridge &&
             alembic upgrade head &&
             echo 'DB migration complete, starting {{REGISTRY_NAME}}-teg...' &&
             umask 000 && rm -f /sock/teg/teg.sock && exec uvicorn src.teg_core_service.main:app --uds /sock/teg/teg.sock --workers {{WORKERS_TEG}}"
    volumes:
      - {{VOL_PREFIX}}_spire_socket_{{TS}}:/opt/spire/sockets:ro
      - {{VOL_PREFIX}}_teg_certs_{{TS}}:/certs:ro
      - {{STACK_DIR}}/kit/data-tls:/opt/data-tls:ro   # §MTLSHOPS T3
      - {{VOL_PREFIX}}_sock_teg_{{TS}}:/sock/teg
    # §MTLSHOPS T2 (S4, 2026-09-15): the TEG listens on a unix socket shared with its terminators alone (nginx-teg, and
    # nginx-federation's cross-teg location), not on the frame or identity network: its port 8080 answered every member
    # in plain. It stays on both networks for its OUTBOUND calls (its database, Redis, the store, peers' terminators),
    # with no alias: agentvault2-85 measured 24 h of access logs on four frames and nothing dialled teg-layer-<frame>.
    # The command removes the socket file before exec: uvicorn's --workers supervisor binds the path in its parent and
    # refuses one that exists, so a TEG killed before its own cleanup (SIGKILL, a stop past the grace period) left the file
    # and every restart exited 1 on Errno 98 while the terminators kept the volume mounted (measured). One container owns it.
    labels:
      - "com.agentvault.service=teg-core-{{REGISTRY_NAME}}"
    networks:
      {{NET_NAME}}: {}
      {{IDENTITY_NET_NAME}}: {}
    depends_on:
      {{REGISTRY_NAME}}-teg-db:
        condition: service_healthy
      {{REGISTRY_NAME}}-redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-fs", "-o", "/dev/null", "--unix-socket", "/sock/teg/teg.sock", "http://localhost/health"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging: *default-logging

  # ═══════════════════════════════════════════════════════════════════════
  # REGISTRY
  # ═══════════════════════════════════════════════════════════════════════

  {{REGISTRY_NAME}}-registry:
    # §FRAMELIC row 52 / D12 — topology only: the image is a VALUE and lives in .env.frame-test
    # (FT_REG_IMAGE). Pinning it here made a version move on a frame a compose edit PLUS two env
    # keys, and the DID-widening session hit exactly that.
    image: ${FT_REG_IMAGE:-agentvault2-registry-test:latest}
    container_name: {{REGISTRY_NAME}}-registry
    restart: unless-stopped
    # Internal only — registry-test reaches us via docker exec; no need for
    # a host port mapping. Strips a major source of Docker port-reservation
    # contention across rapid test runs.
    env_file: {{STACK_DIR}}/.env.frame-test
    environment:
      DATABASE_URL: postgresql+asyncpg://registry:${PG_PASS_REGISTRY}@{{REGISTRY_NAME}}-db:5432/frame_test_registry
      DATABASE_URL_SYNC: postgresql://registry:${PG_PASS_REGISTRY}@{{REGISTRY_NAME}}-db:5432/frame_test_registry
      # §MTLSHOPS T3: libpq and asyncpg read these four (verify-full against the data SVID's names), from the private copy
      # kit/data-tls/tls-client-sync.sh keeps, because libpq refuses the 0644 key the cert-writer writes
      PGSSLMODE: ${FT_PGSSLMODE}
      PGSSLROOTCERT: ${FT_PGTLS_COPY_ROOTCERT}
      PGSSLCERT: ${FT_PGTLS_COPY_CERT}
      PGSSLKEY: ${FT_PGTLS_COPY_KEY}
      TEG_LAYER_URL: ${FT_REG_TEG_LAYER_URL}
      TEG_API_BASE_URL: ${FT_REG_TEG_API_BASE_URL}
      EVENT_STORE_URL: ${FT_EVENT_STORE_MTLS_URL}  # §SOVKIT T5 (V0370, proven on orchard): every store caller on es_ssl_helper; the store's mTLS sidecar
      EVENT_STORE_API_KEY: ${EVENT_STORE_INTERNAL_API_KEY}
      REDIS_URL: ${FT_REG_REDIS_URL}
      REGISTRY_NAME: ${FT_REG_REGISTRY_NAME}
      MINTING_AUTHORITY: ${FT_MINTING_AUTHORITY}
      # §SOVKIT K1 (2026-09-14): no KAFKA_* here. The registry writes over HTTP through the store's mTLS sidecar; the
      # broker is the store's alone (V0371 holds no producer; the env_file's bare KAFKA_ENABLED is false for older images).
      SPIFFE_ENDPOINT_SOCKET: ${FT_SPIFFE_ENDPOINT_SOCKET}
      ALLOWED_ORIGINS: ${FT_REG_ALLOWED_ORIGINS}
      TEG_BULK_PROXY: ${FT_REG_TEG_BULK_PROXY}
      # ── Fleet baseline (2026-09-04) ─────────────────────────────────────
      # A freshly-provisioned frame must boot PRODUCTION-SHAPED, not as a stub.
      # Measured: 114 env keys that BOTH live sandbox frames needed were absent
      # from this template and hand-added at standup. This block carries the
      # subset that changes BEHAVIOUR (money, authority, identity); per-site
      # values (MAIL_*, API_TEST_*, SANDBOX_*) stay out on purpose.
      # NOTE: when a future feature adds registry env, add it HERE too — do not
      # rely on a later rollout script to backfill fresh frames.
      #
      # Same secret as the TEG's: the registry SENDS X-Mint-Proxy-Secret and the
      # TEG compares it. Rendering only one side silently refuses every issuance.
      MINT_PROXY_SECRET: ${FT_MINT_PROXY_SECRET}
      # `mainframe_gate.py` reads this; absent ⇒ issuance and operator
      # provisioning answer 503 on a frame that is in fact a mainframe.
      MAINFRAME_REGISTRY_NAMES: ${FT_REG_MAINFRAME_REGISTRY_NAMES}
      # ⚠ A frame absent from its OWN allowlist cannot fund its satellites and
      # answers a genesis-class 403 — measured on frame-b, which had to gain
      # itself. §MONEY-R50: the READER is this registry's origin guard
      # (routers/teg_integration.py), which compares the slug of REGISTRY_NAME
      # against these tokens; the value is rendered through that same slug rule
      # (core/registry_slug.py) under both the container name and the display
      # name. Own slug always first; the dual-frame orchestrator appends the peer.
      CROSS_TEG_FUND_ORIGIN_ALLOWLIST: ${FT_REG_CROSS_TEG_FUND_ORIGIN_ALLOWLIST}
      IS_CENTRAL_REGISTRY: ${FT_REG_IS_CENTRAL_REGISTRY}
      FRAME_CURRENCY: ${FT_FRAME_CURRENCY}
      FEDERATION_SYNC_INTERVAL_SECONDS: ${FT_REG_FEDERATION_SYNC_INTERVAL_SECONDS}
      # ⚠ THE PAIRING RULE (PART 14): AGENT_RBAC_MODE and AGENT_DELEGATION_MODE
      # must ALWAYS move together. With enforce+off, resolve_capability is never
      # consulted, so any agent whose authority rides an `att_` capability token
      # keeps only its (correctly empty) role set and is DENIED. Never flip one.
      AGENT_RBAC_MODE: ${FT_REG_AGENT_RBAC_MODE}
      AGENT_DELEGATION_MODE: ${FT_REG_AGENT_DELEGATION_MODE}
