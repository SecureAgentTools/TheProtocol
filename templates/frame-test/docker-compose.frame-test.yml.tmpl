      CENTRAL_REGISTRY_URL_FOR_OPERATORS: ${FT_REG_CENTRAL_REGISTRY_URL_FOR_OPERATORS}
      WS_EVENTS_PROXY_HOST: ${FT_REG_WS_EVENTS_PROXY_HOST}
      PROMETHEUS_MULTIPROC_DIR: ${FT_REG_PROMETHEUS_MULTIPROC_DIR}
      PYTHONPATH: ${FT_REG_PYTHONPATH}
      # WS3 federation handshake — what we advertise to peers in invitations.
      # Read by frame_invitations.py:_local_bundle_endpoint_url() / _local_name().
      # Single-frame defaults to per-frame DNS; dual-frame orchestrator overrides
      # to use the shared identity network's DNS names so alpha/beta resolve
      # each other.
      FRAME_LOCAL_BUNDLE_ENDPOINT_URL: ${FT_REG_FRAME_LOCAL_BUNDLE_ENDPOINT_URL}
      FRAME_LOCAL_FEDERATION_ENDPOINT_URL: ${FT_REG_FRAME_LOCAL_FEDERATION_ENDPOINT_URL}
      # §F6 stage 5 (2026-09-27, his words "finish f6 with the parallel session"): EVERY host job of this registry goes
      # to the frame runner. The registry holds no docker socket, no host stack, no nginx sites and no CA (R38), so each
      # switch's default ("local", docker exec on a socket it does not have; IRONHAND's "proxy" to a central registry)
      # would fail. HOST_REACH_PREFER=runner also closes the route on a frame rendered WITH host reach: the runner or a
      # refusal, never the socket by accident. Proven on sbx-beta: stage 3 (17:49:14Z) and the b1opb proof through it.
      HOST_REACH_PREFER: ${FT_REG_HOST_REACH_PREFER}
      FRAME_TRUST_SPIRE_VIA: ${FT_REG_FRAME_TRUST_SPIRE_VIA}
      IRONHAND_SPIRE_MODE: ${FT_REG_IRONHAND_SPIRE_MODE}
      OPERATOR_LIFECYCLE_VIA: ${FT_REG_OPERATOR_LIFECYCLE_VIA}
      CONTAINER_OBSERVE_VIA: ${FT_REG_CONTAINER_OBSERVE_VIA}
    tmpfs:
      - /tmp/prom_multiproc_reg:size=16m,mode=1777
      - /run/pgtls:size=1m,mode=1777   # §MTLSHOPS T3: tls-client-sync's 0700 directory
    volumes:
      # §PEERKEYROT (2026-09-05) — durable signer identity, the §AGENTDISC/V0183 shape
      # registry-a has carried since 08-16 and this template never had. /app/data holds
      # the Ed25519 bundle-signing key that guild work credentials, track-record receipts
      # and cross-registry IronKey credentials are signed with. Without a named volume the
      # key is container-local and EVERY recreate rotates it: measured on Sandbox Alpha,
      # three signer ids in one morning, and every peer worker that had cached the old one
      # answered 422 "could not be verified against the issuer-home pubkey" for good.
      - {{VOL_PREFIX}}_registry_data_{{TS}}:/app/data
      - {{VOL_PREFIX}}_spire_socket_{{TS}}:/opt/spire/sockets:ro
      # §XFRAMEMTLS (2026-09-04) — THE REGISTRY HAD NO SVID AND COULD NOT DO mTLS.
      # cert-writer, nginx-federation, event-store and teg all mounted this volume;
      # the registry did not, so `/certs` did not exist in it at all. Two failures
      # follow, and only the second is visible: with no bundle,
      # `es_ssl_helper.get_httpx_verify()` returns True (system CAs) and every dial
      # to a peer's SPIRE-served endpoint dies CERTIFICATE_VERIFY_FAILED; and with
      # no svid.0.pem there is no client cert to present to a sidecar running
      # `ssl_verify_client on` either. Measured: a cross-registry transfer between
      # the two sandbox frames answered 503 "FX pool: reserve read failed:
      # [SSL: CERTIFICATE_VERIFY_FAILED] unable to get local issuer certificate",
      # i.e. the federation's core money rail was dead on every fresh frame.
      # registry-a and every cloud operator mount it; this was the odd one out.
      - {{VOL_PREFIX}}_svid_certs_{{TS}}:/certs:ro
      - {{STACK_DIR}}/kit/data-tls:/opt/data-tls:ro   # §MTLSHOPS T3
      {{REGISTRY_HOST_MOUNTS}}
      # operator-bundles: bind-mounted (not named volume) so we can
      # pre-chmod 777 the host dir to avoid root-owned volume blocking
      # uid=1000 writes (docker named volumes inherit root:root).
      - {{STACK_DIR}}/operator-bundles:/app/operator-bundles
      # §F6 stage 5 (2026-09-27): NO x509pop CA here any more (it was `{{STACK_DIR}}/x509pop-certs:/opt/spire-ca:ro`, for
      # operator_provisioner's in-registry signing, the direct route). The runner's operator one-shot signs an operator's
      # attestation cert itself and takes the CA from this frame's own SPIRE server (its server.conf ca_bundle_path, the
      # key beside it in the stack dir; runner stack 01555e3), so the registry no longer holds the key that makes nodes.
      # nginx-templates — operator_provisioner.package_bundle reads
      # docker-compose.operator.yml, generate-operator-env.sh, pgbouncer.ini
      # from here when packaging a chained operator bundle.
      - {{NGINX_TEMPLATES_DIR}}:/app/nginx-templates:ro
      # §LANTERNT3 (2026-09-16, his decision "route it through the frame runner"): the OPERATOR socket, and
      # only that one. A frame's registry cannot provision its own cloud operator itself — the bundle is built
      # through the host Docker API and this template withholds that socket on purpose, because a docker socket
      # is unrestricted root on the host. The runner does that work instead, and this mount is how the frame
      # asks. What it is NOT is /run/theprotocol: the full socket serves standup, resume and TEARDOWN, and a
      # frame has no business tearing down frames. The runner binds the operator socket in a directory of its
      # own and serves only OPERATOR_OPS on it, so the grant is bounded by WHICH FILE THIS CONTAINER CAN SEE
      # rather than by a notion of caller identity nobody has to invent. ⚠ The DIRECTORY is mounted, never the
      # socket file: the runner removes and re-binds the socket on restart, and a file bind-mount would leave
      # this container holding a deleted inode.
      - {{RUNNER_OPERATOR_SOCKET_DIR}}:/run/theprotocol:ro
    group_add:
      # the runner's socket group (0660 root:<group>): this host's is 988; a foreign host renders its own
      - "{{RUNNER_SOCKET_GID}}"
      {{REGISTRY_DOCKER_GROUP}}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      {{NET_NAME}}:
        aliases:
          # Test C: the API tester's sandbox-mode gate uses this string
          # literally. Having `registry-test` resolve to this container
          # inside frame_test_network lets the tester self-target.
          - registry-test
      {{IDENTITY_NET_NAME}}:
      # §MTLSHOPS T2 (S4): the publish lane to nginx-ntfy, which only the registry shares
      {{NET_NAME}}_ntfy:
    depends_on:
      {{REGISTRY_NAME}}-db:
        condition: service_healthy
      {{REGISTRY_NAME}}-redis:
        condition: service_healthy
      {{REGISTRY_NAME}}-teg:
        condition: service_healthy
    labels:
      - "com.agentvault.service=registry-{{REGISTRY_NAME}}"
    # §EXCISION-11 (2026-07-30): test_seed is now OPT-IN via SEED_TEST_ACCOUNTS=true.
    # It used to run unconditionally on EVERY start of every provisioned frame,
    # re-creating admin@test.sandbox (an ADMIN), developer@test.sandbox,
    # non_admin_dev@test.sandbox and tutorial-admin@theprotocol.cloud — and printing
    # their generated passwords into the container log, which that frame's own admin
    # can read. A frame handed to a third party must not do that, and deleting the
    # rows does not help: they return on the next restart, and frames have a Start
    # button. Sandbox/CI frames that need the fixtures set SEED_TEST_ACCOUNTS=true.
    # NOTE: with seeding off, operator_seed's admin becomes id 1 — which is what a
    # real operator frame wants; only the nested sandbox_provisioner_test cares.
    # ORIGINAL COMMENT BELOW:
    # test_seed is included because the nested sandbox_provisioner_test
    # (stage 9 of the chained test) queries `admin@test.sandbox` + expects
    # TestAdmin123! — see routers/sandbox_provisioner_test.py:327.
    # Test C: test_seed MUST run BEFORE operator_seed so admin@test.sandbox = id 1
    # (matches sandbox-a's ordering). Otherwise the admin_developers prereq
    # fallback (target_dev_id=2) collides with admin, causing "Cannot suspend yourself".
    # §BATCH5 (2026-09-05): the GUNICORN supervisor, as production (V0041+). The template ran uvicorn with
    # `--forwarded-allow-ips '*'`, which takes the FIRST X-Forwarded-For element — the caller's own — so the JUICE
    # rehearsal frame logged the forged 203.0.113.77 and not the appended peer (the §XFFTRUST class V0204 closed on
    # the fleet). gunicorn_worker.py names the real proxies (FORWARDED_ALLOW_IPS, default loopback + RFC1918).
    # CB-193: operator_seed's `|| true` is grouped to operator_seed. Ungrouped it closed the whole && chain before it, so
    # a failed migration_bridge or alembic upgrade went on to gunicorn and the registry served an unmigrated schema.
    command: ["sh", "-c", "sh /opt/data-tls/tls-client-sync.sh & until [ -s /run/pgtls/client/bundle.0.pem ]; do sleep 1; done; cd /app && PYTHONPATH=/app/src python -m agentvault_registry.migration_bridge && alembic upgrade head && { [ x${SEED_TEST_ACCOUNTS:-false} = xtrue ] && PYTHONPATH=/app/src python -m agentvault_registry.test_seed || true; } && { PYTHONPATH=/app/src python -m agentvault_registry.operator_seed || true; } && (PYTHONPATH=/app/src python -m agentvault_registry.sandbox_bootstrap || echo 'sandbox_bootstrap skipped (non-fatal)') && PYTHONPATH=/app/src gunicorn agentvault_registry.main:app --workers {{WORKERS_REG}} -c /app/gunicorn_conf.py"]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 45s
    logging: *default-logging

  # ════════════════════════════════════════════════════════════════
  # POCKET PUSH — ntfy sidecar (added 2026-08-01)
  # Every frame creates its own, so the mobile experience is not a manual
  # retrofit. LOOPBACK-bound on purpose.
  #
  # W3C Web Push (VAPID, browser) works from this alone — the keypair
  # lives in THIS frame's registry_signing_keys (mig 0133) and delivery
  # goes to the browser vendor, so no hostname is involved.
  #
  # PUBLIC exposure (phone pairing) is a SEPARATE deliberate step:
  #   scripts/hetzner_demo/apply_frame_push.sh --host push.<frame>.theprotocol.cloud
  # It needs DNS + a certificate, which stay on our side and are never the
  # frame operator's to provision (CLAUDE.md PART 11b). Publishing must never
  # be publicly reachable, or anyone who learns a topic name could push to a
  # paired device.
  # Doc: PRODUCTION_DOCS/08_SECURITY/Frame_Outbound_Mail_And_Push.md
  #
  # §MTLSHOPS T2 (S4, 2026-09-15): ntfy has no network. It listens on a unix socket shared with its two terminators alone:
  # nginx-ntfy, the registry's publish lane (below), and nginx-edge, the phones' subscribe door. That door is a PATH
  # allowlist, because a method limit was never subscribe-only: ntfy also publishes on GET (/<topic>/publish?message=,
  # /<topic>/send, /<topic>/trigger), and b5 measured each form publishing through `limit_except GET` on v2.11.0, where
  # the host vhosts' backends run with no auth file. Its HTTP listener is its own loopback, for the healthcheck (the image
  # has no unix-socket client), which also requires the socket file. ntfy removes a socket file a killed run left
  # (measured), so no rm before exec. It exits when its unix listener cannot bind (measured: a read-only socket directory,
  # exit 1), and `test -S` fails once the file is gone under a running server (measured).
  # ════════════════════════════════════════════════════════════════
  {{REGISTRY_NAME}}-ntfy:
    image: binwiederhier/ntfy:v2.28.0
    container_name: {{REGISTRY_NAME}}-ntfy
    restart: unless-stopped
    command: ["serve", "--listen-http", "127.0.0.1:2586", "--listen-unix", "/sock/ntfy/ntfy.sock", "--listen-unix-mode", "0666"]
    network_mode: none
    environment:
      NTFY_CACHE_FILE: ${FT_NTFY_NTFY_CACHE_FILE}
      NTFY_BEHIND_PROXY: ${FT_NTFY_NTFY_BEHIND_PROXY}
    volumes:
      - {{VOL_PREFIX}}_ntfy_cache_{{TS}}:/var/cache/ntfy
      - {{VOL_PREFIX}}_sock_ntfy_{{TS}}:/sock/ntfy
    healthcheck:
      test: ["CMD-SHELL", "test -S /sock/ntfy/ntfy.sock && wget -q -O /dev/null http://127.0.0.1:2586/v1/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging: *default-logging

  # §MTLSHOPS T2 (S4, 2026-09-15): the registry's publish lane to ntfy. TLS on the kit's SVID under the name
  # {{REGISTRY_NAME}}-nginx-ntfy (the registry verifies it), a client certificate the frame's bundle chains, and an
  # internal network whose only other member is the registry: nginx cannot read which identity a certificate names, so
  # the network is what keeps the frame's other identities (the kit, the Directory, the terminators on the registry's
  # SVID) from publishing. No port and no host door: phones subscribe through nginx-edge.
  {{REGISTRY_NAME}}-nginx-ntfy:
    image: nginx:1.30.5-alpine
    container_name: {{REGISTRY_NAME}}-nginx-ntfy
    restart: unless-stopped
    volumes:
      - {{STACK_DIR}}/nginx-ntfy-frame-test.conf:/etc/nginx/conf.d/default.conf:ro
      - {{STACK_DIR}}/nginx-entrypoint.sh:/opt/nginx-entrypoint.sh:ro
      - {{VOL_PREFIX}}_kit_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_sock_ntfy_{{TS}}:/sock/ntfy
    environment:
      CERT_DIR: ${FT_CERT_DIR}
      RELOAD_SEC: ${FT_NGNTFY_RELOAD_SEC}
      SERVICE_NAME: ${FT_NGNTFY_SERVICE_NAME}
    entrypoint: ["/bin/sh", "/opt/nginx-entrypoint.sh"]
    networks:
      - {{NET_NAME}}_ntfy
    depends_on:
      {{REGISTRY_NAME}}-kit-cert-writer:
        condition: service_healthy
      {{REGISTRY_NAME}}-ntfy:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    labels:
      - "com.agentvault.service=nginx-ntfy-{{REGISTRY_NAME}}"
    logging: *default-logging

  # ════════════════════════════════════════════════════════════════
  # §SOVKIT (2026-09-14, his word "frames will be completely sovereign"): THE KIT A FRAME SHIPS
  # WITH. Before this a runner-built frame carried ONE sidecar of its own (ntfy); its metrics, its
  # alerts, its auditor, its policy engine and its index all lived on THIS host's sidecars, so a
  # frame run anywhere else had none of them. Every image is an env value (the operator pins it),
  # every value rides the env file (R6), every rendered file is under {{STACK_DIR}}/kit/.
  # ════════════════════════════════════════════════════════════════

  # §MTLSHOPS T2 (2026-09-15): the kit's own identity, spiffe://<td>/service/kit. OPA, Prometheus and Alertmanager serve with
  # it; Prometheus and the Grafana egress dial with it. None of them holds the registry's key (the shared SVID volume) or
  # passes for the registry at the store or the TEG. Its own SPIRE entry (the provisioner keys the selector on the label
  # below) and its own volume; the kit's services wait for its .ready marker.
  {{REGISTRY_NAME}}-kit-cert-writer:
    image: ${FT_CERT_WRITER_IMAGE:-agentvault2-cert-writer-test-a:spire1153}
    container_name: {{REGISTRY_NAME}}-kit-cert-writer
    restart: unless-stopped
    environment:
      SPIRE_SOCKET: ${FT_CW_SPIRE_SOCKET}
      CERT_DIR: ${FT_CERT_DIR}
      REFRESH_SEC: ${FT_CW_REFRESH_SEC}
      SERVICE_NAME: ${FT_KITCW_SERVICE_NAME}
    volumes:
      - {{VOL_PREFIX}}_spire_socket_{{TS}}:/opt/spire/sockets:ro
      - {{VOL_PREFIX}}_kit_certs_{{TS}}:/certs
    networks:
      - {{NET_NAME}}
    labels:
      # the SPIRE selector keys on THIS label (the provisioner's kit entry); change it and the kit silently gets no SVID
      - "com.agentvault.service=svid-writer-kit-{{REGISTRY_NAME}}"
    healthcheck:
      test: ["CMD-SHELL", "test -f /certs/.ready"]
      interval: 5s
      timeout: 3s
      retries: 60
    depends_on:
      {{REGISTRY_NAME}}-spire-agent:
        condition: service_started
    logging: *default-logging

  # OPA — the policy engine the registry shadows every authz decision to (opa_client.py). The image is
  # distroless (no shell), so no compose healthcheck: the standup driver probes /health through the
  # registry container. `opa run` does not watch its directory: a policy change is a container restart.
  {{REGISTRY_NAME}}-opa:
    image: ${FT_OPA_IMAGE}
    container_name: {{REGISTRY_NAME}}-opa
    restart: unless-stopped
    # §MTLSHOPS T2 (2026-09-15): TLS on the kit's SVID. Every caller presents a certificate (--authentication=tls against the
    # frame's bundle) and kit/opa/policies/system_authz.rego authorizes: the registry's decisions, policy list, scratch
    # simulation modules and health, and the kit's metrics. The certificate and the bundle are re-read every
    # FT_OPA_TLS_REFRESH (measured on 0.61.0: a rotated certificate and a bundle that gained a root, both with no restart).
    command: ["run", "--server", "--addr", ":8181", "--log-level", "${FT_OPA_LOG_LEVEL}",
              "--authentication=tls", "--authorization=basic",
              "--tls-cert-file", "/certs/svid.0.pem", "--tls-private-key-file", "/certs/svid.0.key",
              "--tls-ca-cert-file", "/certs/bundle.0.pem", "--tls-cert-refresh-period", "${FT_OPA_TLS_REFRESH}",
              "/policies"]
    volumes:
      - {{STACK_DIR}}/kit/opa/policies:/policies:ro
      - {{VOL_PREFIX}}_kit_certs_{{TS}}:/certs:ro
    networks:
      - {{NET_NAME}}
    depends_on:
      {{REGISTRY_NAME}}-kit-cert-writer:
        condition: service_healthy
    logging: *default-logging

  # Prometheus — the frame scrapes ITSELF (kit/prometheus/prometheus.yml, rendered per frame) and
  # evaluates the shipped frame rules. The registry's status page reads its history from here
  # (PROMETHEUS_URL rides the env file, never this compose: contract R15).
  {{REGISTRY_NAME}}-prometheus:
    image: ${FT_PROM_IMAGE}
    container_name: {{REGISTRY_NAME}}-prometheus
    restart: unless-stopped
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--web.config.file=/etc/prometheus/web.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=${FT_PROM_RETENTION}'
      - '--web.enable-lifecycle'
    volumes:
      - {{STACK_DIR}}/kit/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{STACK_DIR}}/kit/prometheus/rules:/etc/prometheus/rules:ro
      # §MTLSHOPS T2 (2026-09-15): TLS on the kit's SVID, a client certificate from the kit or the registry required
      # (web.yml); client.yml is the healthcheck's own client.
      - {{STACK_DIR}}/kit/prometheus/web.yml:/etc/prometheus/web.yml:ro
      - {{STACK_DIR}}/kit/prometheus/client.yml:/etc/prometheus/client.yml:ro
      - {{VOL_PREFIX}}_kit_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_prom_data_{{TS}}:/prometheus
    networks:
      - {{NET_NAME}}
      - {{NET_NAME}}_grafana_egress
      # §MTLSHOPS T2 (S4): its scrape lane to nginx-auditor
      - {{NET_NAME}}_auditor
    healthcheck:
      # fails on a closed port and on a missing certificate (measured on v2.45.0: rc 1 when the certificate file is absent)
      test: ["CMD", "promtool", "check", "healthy", "--url=https://localhost:9090", "--http.config.file=/etc/prometheus/client.yml"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    depends_on:
      {{REGISTRY_NAME}}-kit-cert-writer:
        condition: service_healthy
    logging: *default-logging

  # Alertmanager — the routes ship (page|critical first, §PAGEROUTE); the receivers' integrations are the
  # operator's to name in kit/alertmanager/alertmanager.yml. A receiver with none drops what reaches it,
  # deliberately, so this boots on any host.
  {{REGISTRY_NAME}}-alertmanager:
    image: ${FT_AM_IMAGE}
    container_name: {{REGISTRY_NAME}}-alertmanager
    restart: unless-stopped
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--web.config.file=/etc/alertmanager/web.yml'
      - '--storage.path=/alertmanager'
      - '--cluster.listen-address='
    volumes:
      - {{STACK_DIR}}/kit/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      # §MTLSHOPS T2 (2026-09-15): TLS on the kit's SVID, a client certificate from the kit or the registry required.
      - {{STACK_DIR}}/kit/alertmanager/web.yml:/etc/alertmanager/web.yml:ro
      - {{STACK_DIR}}/kit/alertmanager/client.yml:/etc/alertmanager/client.yml:ro
      - {{VOL_PREFIX}}_kit_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_am_data_{{TS}}:/alertmanager
    networks:
      - {{NET_NAME}}
    healthcheck:
      # fails on a closed port and on a missing certificate (measured on v0.26.0: rc 1 when the certificate file is absent)
      test: ["CMD", "amtool", "--alertmanager.url=https://localhost:9093", "--http.config.file=/etc/alertmanager/client.yml", "config", "show"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    depends_on:
      {{REGISTRY_NAME}}-kit-cert-writer:
        condition: service_healthy
    logging: *default-logging

  # Grafana — provisioned datasource (uid DS_PROMETHEUS, the frame's own Prometheus) and the frame
  # overview dashboard. LOOPBACK-bound like ntfy; a public door is a separate, deliberate step.
  {{REGISTRY_NAME}}-grafana:
    image: ${FT_GRAFANA_IMAGE}
    container_name: {{REGISTRY_NAME}}-grafana
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: ${FT_GRAFANA_ADMIN_USER}
      GF_SECURITY_ADMIN_PASSWORD: ${FT_GRAFANA_ADMIN_PASSWORD}
      GF_USERS_ALLOW_SIGN_UP: ${FT_GRAFANA_ALLOW_SIGN_UP}
      GF_ANALYTICS_REPORTING_ENABLED: ${FT_GRAFANA_ANALYTICS}
      GF_ANALYTICS_CHECK_FOR_UPDATES: ${FT_GRAFANA_ANALYTICS}
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: ${FT_GRAFANA_ANALYTICS}
      GF_NEWS_NEWS_FEED_ENABLED: ${FT_GRAFANA_ANALYTICS}
    # §MTLSHOPS T2 (S4, 2026-09-15): Grafana serves on a unix socket shared with the host edge alone, with no TCP listener.
    # The socket file goes first: a Grafana killed before its own cleanup leaves it, and the next start exits on "bind:
    # address already in use" (measured); one container owns the path.
    entrypoint: ["sh", "-c", "rm -f /sock/grafana/grafana.sock && exec /run.sh cfg:default.server.protocol=socket cfg:default.server.socket=/sock/grafana/grafana.sock cfg:default.server.socket_mode=0666"]
    volumes:
      - {{STACK_DIR}}/kit/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{VOL_PREFIX}}_grafana_data_{{TS}}:/var/lib/grafana
      - {{VOL_PREFIX}}_sock_grafana_{{TS}}:/sock/grafana
    depends_on:
      {{REGISTRY_NAME}}-prometheus:
        condition: service_healthy
      {{REGISTRY_NAME}}-grafana-egress:
        condition: service_started
    healthcheck:
      test: ["CMD", "curl", "-fs", "-o", "/dev/null", "--unix-socket", "/sock/grafana/grafana.sock", "http://localhost/api/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    # §MTLSHOPS T2 (2026-09-15): off the frame network. Its operator door is the host edge (nginx-edge, over the socket);
    # its datasource is the kit's egress on the private internal network Grafana, the egress and Prometheus share
    # (measured: a frame member reached neither Grafana nor the egress, by name or by address).
    networks:
      - {{NET_NAME}}_grafana_egress
    logging: *default-logging

  # §MTLSHOPS T2 (2026-09-15, agentvault2-85's spec): Grafana's egress to the frame's Prometheus (kit/grafana/egress.conf): a
  # plain listener on the private internal network alone, mutual TLS out with the kit's certificate, re-read by the
  # entrypoint's reload loop (Grafana's own datasource reload does not pick up a rotated file certificate).
  {{REGISTRY_NAME}}-grafana-egress:
    image: nginx:1.30.5-alpine
    container_name: {{REGISTRY_NAME}}-grafana-egress
    restart: unless-stopped
    volumes:
      - {{STACK_DIR}}/kit/grafana/egress.conf:/etc/nginx/conf.d/default.conf:ro
      - {{STACK_DIR}}/nginx-entrypoint.sh:/opt/nginx-entrypoint.sh:ro
      - {{VOL_PREFIX}}_kit_certs_{{TS}}:/certs:ro
    environment:
      CERT_DIR: ${FT_CERT_DIR}
      RELOAD_SEC: ${FT_NGGE_RELOAD_SEC}
      SERVICE_NAME: ${FT_NGGE_SERVICE_NAME}
    entrypoint: ["/bin/sh", "/opt/nginx-entrypoint.sh"]
    networks:
      - {{NET_NAME}}_grafana_egress
    depends_on:
      {{REGISTRY_NAME}}-kit-cert-writer:
        condition: service_healthy
    labels:
      - "com.agentvault.service=grafana-egress-{{REGISTRY_NAME}}"
    logging: *default-logging

  # §MTLSHOPS T2 (S4, 2026-09-15, adopted with agentvault2-85): the frame's host edge. The only member of its own network
  # and the only container that publishes a loopback port for an app: each port goes to that app's unix socket, with the
  # host vhost's X-Real-IP and X-Forwarded-For passed through as they arrived (agentvault2-85 measured that a host request
  # enters from the gateway of whichever network docker picks for the port; alone on its network, the edge makes that one
  # address). Grafana, ntfy's subscribe door, the auditor's page and the store's lanes are behind it; the console follows.
  {{REGISTRY_NAME}}-nginx-edge:
    image: nginx:1.30.5-alpine
    container_name: {{REGISTRY_NAME}}-nginx-edge
    restart: unless-stopped
    volumes:
      - {{STACK_DIR}}/nginx-edge-frame-test.conf:/etc/nginx/conf.d/default.conf:ro
      - {{VOL_PREFIX}}_sock_grafana_{{TS}}:/sock/grafana
      - {{VOL_PREFIX}}_sock_ntfy_{{TS}}:/sock/ntfy
      - {{VOL_PREFIX}}_sock_auditor_{{TS}}:/sock/auditor
      - {{VOL_PREFIX}}_sock_event-store_{{TS}}:/sock/event-store
    ports:
      - "127.0.0.1:{{PORT_GRAFANA}}:3000"
      - "127.0.0.1:{{PORT_NTFY}}:80"
      - "127.0.0.1:{{PORT_AUDITOR}}:8045"
      - "127.0.0.1:{{PORT_EVENTSTORE}}:8200"
    depends_on:
      {{REGISTRY_NAME}}-grafana:
        condition: service_started
      {{REGISTRY_NAME}}-ntfy:
        condition: service_started
      {{REGISTRY_NAME}}-auditor:
        condition: service_started
      {{REGISTRY_NAME}}-event-store:
        condition: service_started
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks:
      - {{NET_NAME}}_edge
    labels:
      - "com.agentvault.service=nginx-edge-{{REGISTRY_NAME}}"
    logging: *default-logging

  # The solo auditor — this frame's OWN independent witness (Agents/TheAuditor, AUDITOR_SOLO): it reads the
  # ledger's Postgres directly with a READ-ONLY role the standup creates (kit/auditor/frames/frames.json, 600,
  # written by the driver), computes Δ in one statement, and serves its own page on loopback. Less independent
  # than a witness on another host, and the host that stands the frame up keeps its own slot as well.
  # §MTLSHOPS T2 (S4, 2026-09-15): the auditor on its own identity (spiffe://<td>/service/auditor, its own cert-writer and
  # volume). Its one store read, GET /api/v1/projections/supply-audit, goes through nginx-event-store with that SVID: the
  # route has no auth dependency and the gateway verifies the certificate (agentvault2-85, measured), so it carries no store
  # key and is never one of the store's KNOWN_INTERNAL_SERVICES; the frames file the driver writes names the gateway (in
  # solo mode EVENT_STORE_URL was never its store address, and REGISTRY_URL was read and used nowhere). It listens on a unix
  # socket shared with nginx-edge (the host's door to its page) and nginx-auditor (Prometheus's scrape lane) alone; its
  # frame-network membership is for its outbound reads (the three read-only DSNs and the gateway).
  {{REGISTRY_NAME}}-auditor-cert-writer:
    image: ${FT_CERT_WRITER_IMAGE:-agentvault2-cert-writer-test-a:spire1153}
    container_name: {{REGISTRY_NAME}}-auditor-cert-writer
    restart: unless-stopped
    environment:
      SPIRE_SOCKET: ${FT_CW_SPIRE_SOCKET}
      CERT_DIR: ${FT_CERT_DIR}
      REFRESH_SEC: ${FT_CW_REFRESH_SEC}
      SERVICE_NAME: ${FT_AUDCW_SERVICE_NAME}
    volumes:
      - {{VOL_PREFIX}}_spire_socket_{{TS}}:/opt/spire/sockets:ro
      - {{VOL_PREFIX}}_auditor_certs_{{TS}}:/certs
    networks:
      - {{NET_NAME}}
    labels:
      # the SPIRE selector keys on THIS label (the provisioner's auditor entry); change it and the auditor silently gets no SVID
      - "com.agentvault.service=svid-writer-auditor-{{REGISTRY_NAME}}"
    healthcheck:
      test: ["CMD-SHELL", "test -f /certs/.ready"]
      interval: 5s
      timeout: 3s
      retries: 60
    depends_on:
      {{REGISTRY_NAME}}-spire-agent:
        condition: service_started
    logging: *default-logging

  {{REGISTRY_NAME}}-auditor:
    image: ${FT_AUDITOR_IMAGE}
    container_name: {{REGISTRY_NAME}}-auditor
    restart: unless-stopped
    command: ["sh", "-c", "umask 000 && exec uvicorn src.auditor.main:app --uds /sock/auditor/auditor.sock --log-level info"]
    environment:
      AUDITOR_SOLO: ${FT_AUDITOR_AUDITOR_SOLO}
      AUDITOR_EXTRA_FRAMES_FILE: ${FT_AUDITOR_AUDITOR_EXTRA_FRAMES_FILE}
      AUDIT_INTERVAL: ${FT_AUDITOR_AUDIT_INTERVAL}
      AGENT_NAME: ${FT_AUDITOR_AGENT_NAME}
      AUDITOR_ADMIN_TOKEN: ${FT_AUDITOR_AUDITOR_ADMIN_TOKEN}
      MAINTENANCE_ACTIVE: ${FT_AUDITOR_MAINTENANCE_ACTIVE}
      AUDITOR_TLS_CERT: ${FT_AUDITOR_TLS_CERT}
      AUDITOR_TLS_KEY: ${FT_AUDITOR_TLS_KEY}
      AUDITOR_TLS_CA: ${FT_AUDITOR_TLS_CA}
      # §MTLSHOPS T3: asyncpg reads these four (verify-full against the data SVID's names); it reads the key as the
      # cert-writer writes it, so no private copy
      PGSSLMODE: ${FT_PGSSLMODE}
      PGSSLROOTCERT: ${FT_PGTLS_CERTS_ROOTCERT}
      PGSSLCERT: ${FT_PGTLS_CERTS_CERT}
      PGSSLKEY: ${FT_PGTLS_CERTS_KEY}
    volumes:
      - {{STACK_DIR}}/kit/auditor/frames:/app/frames:ro
      - {{VOL_PREFIX}}_auditor_data_{{TS}}:/app/data
      - {{VOL_PREFIX}}_auditor_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_sock_auditor_{{TS}}:/sock/auditor
    depends_on:
      {{REGISTRY_NAME}}-es-db:
        condition: service_healthy
      {{REGISTRY_NAME}}-auditor-cert-writer:
        condition: service_healthy
    networks:
      - {{NET_NAME}}
    healthcheck:
      test: ["CMD", "curl", "-sf", "--unix-socket", "/sock/auditor/auditor.sock", "http://auditor/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging: *default-logging

  # §MTLSHOPS T2 (S4, 2026-09-15): Prometheus's scrape lane to the auditor's /metrics. TLS on the auditor's SVID under the
  # name {{REGISTRY_NAME}}-nginx-auditor, a client certificate the frame's bundle chains, GET /metrics only, on an internal
  # network whose only other member is Prometheus (nginx cannot read which identity a certificate names). The kit's breach
  # rule (auditor_status == 0) reads what this lane serves.
  {{REGISTRY_NAME}}-nginx-auditor:
    image: nginx:1.30.5-alpine
    container_name: {{REGISTRY_NAME}}-nginx-auditor
    restart: unless-stopped
    volumes:
      - {{STACK_DIR}}/nginx-auditor-frame-test.conf:/etc/nginx/conf.d/default.conf:ro
      - {{STACK_DIR}}/nginx-entrypoint.sh:/opt/nginx-entrypoint.sh:ro
      - {{VOL_PREFIX}}_auditor_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_sock_auditor_{{TS}}:/sock/auditor
    environment:
      CERT_DIR: ${FT_CERT_DIR}
      RELOAD_SEC: ${FT_NGAUD_RELOAD_SEC}
      SERVICE_NAME: ${FT_NGAUD_SERVICE_NAME}
    entrypoint: ["/bin/sh", "/opt/nginx-entrypoint.sh"]
    networks:
      - {{NET_NAME}}_auditor
    depends_on:
      {{REGISTRY_NAME}}-auditor-cert-writer:
        condition: service_healthy
      {{REGISTRY_NAME}}-auditor:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    labels:
      - "com.agentvault.service=nginx-auditor-{{REGISTRY_NAME}}"
    logging: *default-logging

  # THE DIRECTORY (the frame's own federated index, §DIRFEED/§MTLSGAP) — three containers, the EU shape:
  # its identity (a cert-writer on the frame's SPIRE socket; the entry is registered by the provisioner
  # beside the registry's), the index itself (frame network ONLY: on the identity network the operators'
  # aliases hijack its crawl), and the mTLS read leg the registry dials with its SVID.
  {{REGISTRY_NAME}}-directory-cert-writer:
    image: ${FT_CERT_WRITER_IMAGE:-agentvault2-cert-writer-test-a:spire1153}
    container_name: {{REGISTRY_NAME}}-directory-cert-writer
    restart: unless-stopped
    environment:
      SPIRE_SOCKET: ${FT_CW_SPIRE_SOCKET}
      CERT_DIR: ${FT_CERT_DIR}
      REFRESH_SEC: ${FT_CW_REFRESH_SEC}
      SERVICE_NAME: ${FT_DIRCW_SERVICE_NAME}
    volumes:
      - {{VOL_PREFIX}}_spire_socket_{{TS}}:/opt/spire/sockets:ro
      - {{VOL_PREFIX}}_directory_certs_{{TS}}:/certs
    networks:
      - {{NET_NAME}}
      - {{IDENTITY_NET_NAME}}
    labels:
      # the SPIRE selector keys on THIS label (register_test_frame_spire_entries); change it and the index silently gets no SVID
      - "com.agentvault.service=svid-writer-directory-{{REGISTRY_NAME}}"
    depends_on:
      {{REGISTRY_NAME}}-spire-agent:
        condition: service_started
    logging: *default-logging

  {{REGISTRY_NAME}}-directory:
    image: ${FT_DIRECTORY_IMAGE}
    container_name: {{REGISTRY_NAME}}-directory
    restart: unless-stopped
    environment:
      DIRECTORY_ANCHORS: ${FT_DIR_DIRECTORY_ANCHORS}
      DIRECTORY_SYNC_SECONDS: ${FT_DIR_DIRECTORY_SYNC_SECONDS}
      DIRECTORY_MAX_HOPS: ${FT_DIR_DIRECTORY_MAX_HOPS}
      DIRECTORY_FULL_EVERY: ${FT_DIR_DIRECTORY_FULL_EVERY}
      DIRECTORY_HOPS_BY_REGISTRY: ${FT_DIR_DIRECTORY_HOPS_BY_REGISTRY}
      DIRECTORY_DB: ${FT_DIR_DIRECTORY_DB}
      DIRECTORY_CERT_DIR: ${FT_DIR_DIRECTORY_CERT_DIR}
      DIRECTORY_READERS: ${FT_DIR_DIRECTORY_READERS}
      # The proxy marker (agentvault2-85's T4 contract): the index trusts X-SSL-Client-* ONLY when the request also
      # carries X-Directory-Proxy-Auth equal to this secret. Only its own nginx sidecar sets that header, so a
      # neighbour on the frame network cannot forge a verified reader.
      DIRECTORY_PROXY_TRUST_SECRET: ${FT_DIR_DIRECTORY_PROXY_TRUST_SECRET}
      DATABASE_URL: ${FT_DIR_DATABASE_URL}
      API_KEY_SECRET: ${FT_DIR_API_KEY_SECRET}
    # §MTLSHOPS T2 (S4, 2026-09-15): the index listens on a unix socket shared with its terminator alone, not on the frame
    # network (its port 8600 answered every member in plain). --uds only: behind a socket, --proxy-headers with '*' makes the
    # caller's forged first X-Forwarded-For element the client (measured on this image's uvicorn 0.34.3); the terminator sets
    # X-Real-IP and V0378's middleware reads it. umask 000 lets the terminator's nginx user connect.
    command: ["sh", "-c", "umask 000 && exec uvicorn directory.app:app --uds /sock/directory/directory.sock"]
    volumes:
      - {{VOL_PREFIX}}_directory_data_{{TS}}:/data
      - {{VOL_PREFIX}}_directory_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_sock_directory_{{TS}}:/sock/directory
    depends_on:
      {{REGISTRY_NAME}}-directory-cert-writer:
        condition: service_started
      {{REGISTRY_NAME}}-registry:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-fs", "-o", "/dev/null", "--unix-socket", "/sock/directory/directory.sock", "http://localhost/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      - {{NET_NAME}}
    logging: *default-logging

  {{REGISTRY_NAME}}-directory-nginx:
    image: nginx:1.30.5-alpine
    container_name: {{REGISTRY_NAME}}-directory-nginx
    restart: unless-stopped
    volumes:
      # Mounted as a TEMPLATE, not the live conf: the entrypoint wrapper below substitutes the ONE proxy-marker
      # variable into conf.d at start, so the secret lives in the env file and the container env, never in a
      # rendered file at rest in the stack dir. nginx's own $variables are untouched (envsubst takes a list).
      - {{STACK_DIR}}/nginx-directory-frame-test.conf:/etc/nginx/templates/directory.conf.template:ro
      - {{STACK_DIR}}/nginx-entrypoint.sh:/opt/nginx-entrypoint.sh:ro
      - {{VOL_PREFIX}}_directory_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_sock_directory_{{TS}}:/sock/directory
    environment:
      CERT_DIR: ${FT_CERT_DIR}
      RELOAD_SEC: ${FT_NGDIR_RELOAD_SEC}
      SERVICE_NAME: ${FT_NGDIR_SERVICE_NAME}
      DIRECTORY_PROXY_TRUST_SECRET: ${FT_NGDIR_PROXY_TRUST_SECRET}
    entrypoint: ["/bin/sh", "-c", "envsubst '$$DIRECTORY_PROXY_TRUST_SECRET' < /etc/nginx/templates/directory.conf.template > /etc/nginx/conf.d/default.conf && exec /bin/sh /opt/nginx-entrypoint.sh"]
    depends_on:
      {{REGISTRY_NAME}}-directory-cert-writer:
        condition: service_started
      {{REGISTRY_NAME}}-directory:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{NET_NAME}}
      - {{IDENTITY_NET_NAME}}
    logging: *default-logging

# ════════════════════════════════════════════════════════════════
# VOLUMES (timestamped — destroyed per test run)
# ════════════════════════════════════════════════════════════════

volumes:
  {{VOL_PREFIX}}_ntfy_cache_{{TS}}:
    name: {{VOL_PREFIX}}_ntfy_cache_{{TS}}
  {{VOL_PREFIX}}_redpanda_data_{{TS}}:
    name: {{VOL_PREFIX}}_redpanda_data_{{TS}}
  # §MTLSHOPS S5: the broker's TLS files, rewritten in place by redpanda-tls. Named, not tmpfs: after a host reboot the broker
  # starts before redpanda-tls and serves the last pair it finds until the sidecar's first sync.
  {{VOL_PREFIX}}_redpanda_tls_{{TS}}:
    name: {{VOL_PREFIX}}_redpanda_tls_{{TS}}
  {{VOL_PREFIX}}_pg_registry_{{TS}}:
    name: {{VOL_PREFIX}}_pg_registry_{{TS}}
  {{VOL_PREFIX}}_pg_teg_{{TS}}:
    name: {{VOL_PREFIX}}_pg_teg_{{TS}}
  {{VOL_PREFIX}}_pg_events_{{TS}}:
    name: {{VOL_PREFIX}}_pg_events_{{TS}}
  {{VOL_PREFIX}}_spire_data_{{TS}}:
    name: {{VOL_PREFIX}}_spire_data_{{TS}}
  {{VOL_PREFIX}}_spire_socket_{{TS}}:
    name: {{VOL_PREFIX}}_spire_socket_{{TS}}
  {{VOL_PREFIX}}_svid_certs_{{TS}}:
    name: {{VOL_PREFIX}}_svid_certs_{{TS}}
  {{VOL_PREFIX}}_teg_certs_{{TS}}:
    name: {{VOL_PREFIX}}_teg_certs_{{TS}}
  {{VOL_PREFIX}}_es_certs_{{TS}}:
    name: {{VOL_PREFIX}}_es_certs_{{TS}}
  {{VOL_PREFIX}}_nginx_event_store_certs_{{TS}}:
    name: {{VOL_PREFIX}}_nginx_event_store_certs_{{TS}}
  {{VOL_PREFIX}}_nginx_teg_certs_{{TS}}:
    name: {{VOL_PREFIX}}_nginx_teg_certs_{{TS}}
  {{VOL_PREFIX}}_nginx_federation_certs_{{TS}}:
    name: {{VOL_PREFIX}}_nginx_federation_certs_{{TS}}
  {{VOL_PREFIX}}_redpanda_certs_{{TS}}:
    name: {{VOL_PREFIX}}_redpanda_certs_{{TS}}
  {{VOL_PREFIX}}_registry_data_{{TS}}:
    name: {{VOL_PREFIX}}_registry_data_{{TS}}
  # §SOVKIT — the kit's state
  {{VOL_PREFIX}}_prom_data_{{TS}}:
    name: {{VOL_PREFIX}}_prom_data_{{TS}}
  {{VOL_PREFIX}}_am_data_{{TS}}:
    name: {{VOL_PREFIX}}_am_data_{{TS}}
  {{VOL_PREFIX}}_grafana_data_{{TS}}:
    name: {{VOL_PREFIX}}_grafana_data_{{TS}}
  {{VOL_PREFIX}}_auditor_data_{{TS}}:
    name: {{VOL_PREFIX}}_auditor_data_{{TS}}
  {{VOL_PREFIX}}_auditor_certs_{{TS}}:
    name: {{VOL_PREFIX}}_auditor_certs_{{TS}}
  # §MTLSHOPS T3: the data identity's SVID, mounted by its cert-writer and the four data services alone
  {{VOL_PREFIX}}_data_certs_{{TS}}:
    name: {{VOL_PREFIX}}_data_certs_{{TS}}
  {{VOL_PREFIX}}_directory_data_{{TS}}:
    name: {{VOL_PREFIX}}_directory_data_{{TS}}
  {{VOL_PREFIX}}_directory_certs_{{TS}}:
    name: {{VOL_PREFIX}}_directory_certs_{{TS}}
  {{VOL_PREFIX}}_kit_certs_{{TS}}:
    name: {{VOL_PREFIX}}_kit_certs_{{TS}}
  # §MTLSHOPS T2 (S4): the apps' unix sockets, each a tmpfs shared with its terminator(s) alone (mode 1777: a root app, a
  # uid-1000 app and nginx's user measured working together; a recreated app rebinds and its terminator recovers).
  {{VOL_PREFIX}}_sock_directory_{{TS}}:
    name: {{VOL_PREFIX}}_sock_directory_{{TS}}
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "mode=1777"
  {{VOL_PREFIX}}_sock_teg_{{TS}}:
    name: {{VOL_PREFIX}}_sock_teg_{{TS}}
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "mode=1777"
  {{VOL_PREFIX}}_sock_grafana_{{TS}}:
    name: {{VOL_PREFIX}}_sock_grafana_{{TS}}
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "mode=1777"
  {{VOL_PREFIX}}_sock_ntfy_{{TS}}:
    name: {{VOL_PREFIX}}_sock_ntfy_{{TS}}
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "mode=1777"
  {{VOL_PREFIX}}_sock_auditor_{{TS}}:
    name: {{VOL_PREFIX}}_sock_auditor_{{TS}}
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "mode=1777"
  {{VOL_PREFIX}}_sock_event-store_{{TS}}:
    name: {{VOL_PREFIX}}_sock_event-store_{{TS}}
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "mode=1777"

# ════════════════════════════════════════════════════════════════
# NETWORKS (isolated per test run — plus optional identity net
# that will get aliases added for sandbox-a federation)
# ════════════════════════════════════════════════════════════════

networks:
  {{NET_NAME}}:
    driver: bridge
    name: {{NET_NAME}}
  {{IDENTITY_NET_NAME}}:
    {{IDENTITY_NET_DEFINITION}}
    name: {{IDENTITY_NET_NAME}}
  # §SOVKIT K1 (2026-09-14): the ledger bus. The broker and the store are its only members; internal: no route out.
  {{NET_NAME}}_ledger:
    driver: bridge
    internal: true
    name: {{NET_NAME}}_ledger
  # §MTLSHOPS T2 (2026-09-15): Grafana's egress network is internal (Grafana, the kit's egress and Prometheus only).
  {{NET_NAME}}_grafana_egress:
    driver: bridge
    internal: true
    name: {{NET_NAME}}_grafana_egress
  # §MTLSHOPS T2 (S4, 2026-09-15): the host edge's network, nginx-edge its only member. Not internal: docker publishes no
  # port from a container whose only network is internal.
  {{NET_NAME}}_edge:
    driver: bridge
    name: {{NET_NAME}}_edge
  # §MTLSHOPS T2 (S4, 2026-09-15): the registry's publish lane to ntfy. nginx-ntfy and the registry its only members;
  # internal: no route out. nginx cannot read a URI SAN, so membership is what refuses the frame's other identities.
  {{NET_NAME}}_ntfy:
    driver: bridge
    internal: true
    name: {{NET_NAME}}_ntfy
  # §MTLSHOPS T2 (S4, 2026-09-15): Prometheus's scrape lane to the auditor. nginx-auditor and Prometheus its only members.
  {{NET_NAME}}_auditor:
    driver: bridge
    internal: true
    name: {{NET_NAME}}_auditor
