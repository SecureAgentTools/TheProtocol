# ═══════════════════════════════════════════════════════════════════════════
# docker-compose.frame-test.yml — Frame Test (ephemeral sovereign frame)
# Trust domain: spiffe://{{TRUST_DOMAIN}}
# Generated at: {{TS}}
# REGISTRY_NAME={{REGISTRY_NAME}}
# frame-template-generation: f5-per-service
#   A resume refuses a stack rendered under another generation or with another service set (template_shape.py, R31):
#   bump this line whenever a template change makes resuming an older stack unsafe.
#
# Usage (invoked by frame_test_provisioner.py via docker:cli container):
#   docker compose -f docker-compose.frame-test.yml --env-file .env.frame-test up -d
#
# Image pins reuse the sandbox images (identical code path to frame-b images)
# to avoid 3-minute rebuilds every test run.
# ═══════════════════════════════════════════════════════════════════════════

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

# D12 (2026-09-05): this compose carries TOPOLOGY ONLY. Every value under an
# `environment:` block is `${FT_...}`, read from the frame's own env file
# (rendered from templates/frame-test/frame-test.env.tmpl, passed as --env-file).
# `.forgejo/checks/frame_template_contract.py` R6 refuses an inline literal here.
services:

  # ═══════════════════════════════════════════════════════════════════════
  # DATABASES
  # ═══════════════════════════════════════════════════════════════════════

  # §MTLSHOPS T3 (2026-09-15, agentvault2-b5): the data identity. Its own SPIFFE ID (spiffe://<td>/service/data), its DNS
  # names ({{REGISTRY_NAME}}-db, -teg-db, -es-db, -redis), never federated, so its bundle holds the frame's own root only; its own
  # selector label (the provisioner's data entry keys on it) and its own volume, mounted by the four data services alone.
  # The databases never hold the registry's SVID, which the TEG and the store accept as an internal service. It needs no
  # network: the SPIRE agent's socket is a volume.
  {{REGISTRY_NAME}}-data-cert-writer:
    image: ${FT_CERT_WRITER_IMAGE:-agentvault2-cert-writer-test-a:spire1153}
    container_name: {{REGISTRY_NAME}}-data-cert-writer
    restart: unless-stopped
    environment:
      SPIRE_SOCKET: ${FT_CW_SPIRE_SOCKET}
      CERT_DIR: ${FT_CERT_DIR}
      REFRESH_SEC: ${FT_CW_REFRESH_SEC}
      SERVICE_NAME: ${FT_DATACW_SERVICE_NAME}
    volumes:
      - {{VOL_PREFIX}}_spire_socket_{{TS}}:/opt/spire/sockets:ro
      - {{VOL_PREFIX}}_data_certs_{{TS}}:/certs
    network_mode: none
    labels:
      # the SPIRE selector keys on THIS label (the provisioner's data entry); change it and the databases get no SVID
      - "com.agentvault.service=svid-writer-data-{{REGISTRY_NAME}}"
    healthcheck:
      test: ["CMD-SHELL", "test -f /certs/.ready"]
      interval: 5s
      timeout: 3s
      retries: 60
    depends_on:
      {{REGISTRY_NAME}}-spire-agent:
        condition: service_started
    logging: *default-logging

  {{REGISTRY_NAME}}-db:
    image: postgres:18.6-alpine
    container_name: {{REGISTRY_NAME}}-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${FT_DB_POSTGRES_DB}
      POSTGRES_USER: ${FT_DB_POSTGRES_USER}
      POSTGRES_PASSWORD: ${PG_PASS_REGISTRY}
    # §MTLSHOPS T3 (2026-09-15, agentvault2-b5): TLS only over TCP, on the data identity's SVID. kit/data-tls/pg-tls-sync.sh
    # keeps the server's 0600 copy on the tmpfs and reloads it on rotation; kit/data-tls/pg_hba.conf rejects plain TCP and
    # asks every TLS client for a certificate the frame's root signed plus the role's password. Local connections stay
    # trusted: pg_isready, the entrypoint's first-boot init and every `docker exec psql` use the socket.
    entrypoint: ["sh", "/opt/data-tls/pg-tls-sync.sh"]
    command: postgres -c shared_buffers=128MB -c effective_cache_size=512MB -c work_mem=4MB -c ssl=on -c ssl_cert_file=/run/pgtls/server/svid.0.pem -c ssl_key_file=/run/pgtls/server/svid.0.key -c ssl_ca_file=/run/pgtls/server/bundle.0.pem -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/opt/data-tls/pg_hba.conf
    tmpfs:
      - /run/pgtls:size=1m,mode=0755
    volumes:
      - {{VOL_PREFIX}}_pg_registry_{{TS}}:/var/lib/postgresql
      - {{VOL_PREFIX}}_data_certs_{{TS}}:/certs:ro
      - {{STACK_DIR}}/kit/data-tls:/opt/data-tls:ro
    networks:
      - {{NET_NAME}}
    depends_on:
      {{REGISTRY_NAME}}-data-cert-writer:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U registry -d frame_test_registry"]
      interval: 5s
      timeout: 3s
      retries: 5
    logging: *default-logging

  {{REGISTRY_NAME}}-teg-db:
    image: postgres:18.6-alpine
    container_name: {{REGISTRY_NAME}}-teg-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${FT_TEGDB_POSTGRES_DB}
      POSTGRES_USER: ${FT_TEGDB_POSTGRES_USER}
      POSTGRES_PASSWORD: ${PG_PASS_TEG}
    # §MTLSHOPS T3: TLS only over TCP, as {{REGISTRY_NAME}}-db above
    entrypoint: ["sh", "/opt/data-tls/pg-tls-sync.sh"]
    command: postgres -c shared_buffers=128MB -c effective_cache_size=512MB -c work_mem=4MB -c ssl=on -c ssl_cert_file=/run/pgtls/server/svid.0.pem -c ssl_key_file=/run/pgtls/server/svid.0.key -c ssl_ca_file=/run/pgtls/server/bundle.0.pem -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/opt/data-tls/pg_hba.conf
    tmpfs:
      - /run/pgtls:size=1m,mode=0755
    volumes:
      - {{VOL_PREFIX}}_pg_teg_{{TS}}:/var/lib/postgresql
      - {{VOL_PREFIX}}_data_certs_{{TS}}:/certs:ro
      - {{STACK_DIR}}/kit/data-tls:/opt/data-tls:ro
    networks:
      - {{NET_NAME}}
    depends_on:
      {{REGISTRY_NAME}}-data-cert-writer:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U teg -d frame_test_teg"]
      interval: 5s
      timeout: 3s
      retries: 5
    logging: *default-logging

  {{REGISTRY_NAME}}-es-db:
    image: postgres:18.6-alpine
    container_name: {{REGISTRY_NAME}}-es-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${FT_ESDB_POSTGRES_DB}
      POSTGRES_USER: ${FT_ESDB_POSTGRES_USER}
      POSTGRES_PASSWORD: ${PG_PASS_EVENT_STORE}
    # §MTLSHOPS T3: TLS only over TCP, as {{REGISTRY_NAME}}-db above
    entrypoint: ["sh", "/opt/data-tls/pg-tls-sync.sh"]
    command: postgres -c shared_buffers=256MB -c effective_cache_size=1GB -c work_mem=8MB -c ssl=on -c ssl_cert_file=/run/pgtls/server/svid.0.pem -c ssl_key_file=/run/pgtls/server/svid.0.key -c ssl_ca_file=/run/pgtls/server/bundle.0.pem -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/opt/data-tls/pg_hba.conf
    tmpfs:
      - /run/pgtls:size=1m,mode=0755
    volumes:
      - {{VOL_PREFIX}}_pg_events_{{TS}}:/var/lib/postgresql
      - {{VOL_PREFIX}}_data_certs_{{TS}}:/certs:ro
      - {{STACK_DIR}}/kit/data-tls:/opt/data-tls:ro
    networks:
      - {{NET_NAME}}
    depends_on:
      {{REGISTRY_NAME}}-data-cert-writer:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U eventstore -d frame_test_events"]
      interval: 5s
      timeout: 3s
      retries: 5
    logging: *default-logging

  # ═══════════════════════════════════════════════════════════════════════
  # INFRASTRUCTURE
  # ═══════════════════════════════════════════════════════════════════════

  {{REGISTRY_NAME}}-redis:
    image: redis:8.10.2-alpine
    container_name: {{REGISTRY_NAME}}-redis
    restart: unless-stopped
    # §MTLSHOPS G3 (2026-09-15): only the frame's three clients authenticate (ACL users registry, store, teg); the default
    # user answers PING and nothing else, which keeps the healthcheck below. The provisioner renders the file: SHA-256
    # hashes only, 0600, owned by the image's redis uid (999).
    # §MTLSHOPS T3 (2026-09-15, agentvault2-b5): TLS only (--port 0) on the data identity's SVID, and every client needs a
    # certificate the frame's root signed (--tls-auth-clients yes) as well as its ACL user. kit/data-tls/redis-tls-reload.sh
    # copies the ACL file into the tmpfs with a reload user only this container knows, and reloads the TLS files over the
    # unix socket, which the healthcheck and the host's tooling use too.
    entrypoint: ["sh", "/opt/data-tls/redis-tls-reload.sh"]
    command: ["--port", "0", "--tls-port", "6379", "--tls-cert-file", "/certs/svid.0.pem", "--tls-key-file", "/certs/svid.0.key", "--tls-ca-cert-file", "/certs/bundle.0.pem", "--tls-auth-clients", "yes", "--unixsocket", "/run/redis/redis.sock", "--unixsocketperm", "700", "--aclfile", "/run/redis/users.acl", "--maxmemory", "128mb", "--maxmemory-policy", "allkeys-lru", "--save", "", "--appendonly", "no", "--protected-mode", "no", "--bind", "0.0.0.0"]
    tmpfs:
      - /run/redis:size=1m,mode=0700,uid=999,gid=999
    volumes:
      - {{STACK_DIR}}/redis/users.acl:/usr/local/etc/redis/users.acl:ro
      - {{VOL_PREFIX}}_data_certs_{{TS}}:/certs:ro
      - {{STACK_DIR}}/kit/data-tls:/opt/data-tls:ro
    networks:
      - {{NET_NAME}}
    depends_on:
      {{REGISTRY_NAME}}-data-cert-writer:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "redis-cli", "-s", "/run/redis/redis.sock", "ping"]
      interval: 10s
      timeout: 3s
      retries: 3
    logging: *default-logging

  {{REGISTRY_NAME}}-redpanda:
    # §SOVKIT K1 (his word 2026-09-14 "2 yes": Kafka is PRIVATE to the event store; "fix kafka scalable and secure").
    # agentvault2-85 measured the store's consumer writing whatever arrived on :9092 with none of the HTTP route's
    # checks, reachable by every container on the frame network. Now the broker sits on the ledger-only network with
    # the store as its ONLY client: SASL/SCRAM-SHA-256 over TLS on the frame's own SVID (§MTLSHOPS S5: from its own volume,
    # which redpanda-tls below rewrites in place, because the broker follows the files by inotify); the superuser created at
    # bootstrap (RP_BOOTSTRAP_USER, the
    # password the provisioner creates); the admin API and both HTTP proxies on the container's loopback; developer_mode
    # off (fsync on: a ledger bus that acks what it has not written is the wrong bus; needs --memory 1G); auto-create
    # off, the topics created with explicit partitions by {{REGISTRY_NAME}}-redpanda-init before the store starts.
    # The RPK_* lines make `docker exec ... rpk` inside the container authenticate as the store's user (the driver's
    # gate, the consumer-lag check). No port reaches the host. Every value is env-interpolated (D12).
    image: redpandadata/redpanda:v26.2.3
    container_name: {{REGISTRY_NAME}}-redpanda
    restart: unless-stopped
    environment:
      RP_BOOTSTRAP_USER: ${FT_ES_KAFKA_SASL_USERNAME}:${FT_ES_KAFKA_SASL_PASSWORD}:${FT_ES_KAFKA_SASL_MECHANISM}
      RPK_BROKERS: ${FT_KAFKA_BOOTSTRAP_SERVERS}
      RPK_USER: ${FT_ES_KAFKA_SASL_USERNAME}
      RPK_PASS: ${FT_ES_KAFKA_SASL_PASSWORD}
      RPK_SASL_MECHANISM: ${FT_ES_KAFKA_SASL_MECHANISM}
      RPK_TLS_ENABLED: ${FT_KAFKA_RPK_TLS_ENABLED}
      RPK_TLS_CA: ${FT_ES_KAFKA_SSL_CAFILE}
    command:
      - redpanda start
      - --smp 1
      - --memory 1G
      - --reserve-memory 0M
      - --overprovisioned
      - --node-id 0
      - --kafka-addr internal://0.0.0.0:9092
      - --advertise-kafka-addr internal://{{REGISTRY_NAME}}-redpanda:9092
      - --rpc-addr 127.0.0.1:33145
      - --advertise-rpc-addr 127.0.0.1:33145
      - --set redpanda.admin=[{"address":"127.0.0.1","port":9644}]
      - --set redpanda.enable_sasl=true
      - --set redpanda.superusers=["${FT_ES_KAFKA_SASL_USERNAME}"]
      - --set redpanda.developer_mode=false
      - --set redpanda.auto_create_topics_enabled=false
      - --set redpanda.kafka_api=[{"address":"0.0.0.0","port":9092,"name":"internal","authentication_method":"sasl"}]
      - --set redpanda.kafka_api_tls=[{"name":"internal","enabled":true,"cert_file":"/redpanda-tls/svid.0.pem","key_file":"/redpanda-tls/svid.0.key","truststore_file":"/redpanda-tls/bundle.0.pem","require_client_auth":false}]
      - --set pandaproxy.pandaproxy_api=[{"address":"127.0.0.1","port":8082}]
      - --set schema_registry.schema_registry_api=[{"address":"127.0.0.1","port":8081}]
    volumes:
      # /certs for rpk's own CA inside the container (RPK_TLS_CA); the listener's files come from redpanda-tls
      - {{VOL_PREFIX}}_redpanda_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_redpanda_tls_{{TS}}:/redpanda-tls:ro
      # §SOVKIT K1: the topics on a NAMED volume. Without one every recreate made a fresh anonymous volume, and a record the
      # store's HTTP route had already answered 202 for but the consumer had not yet read was gone with it.
      - {{VOL_PREFIX}}_redpanda_data_{{TS}}:/var/lib/redpanda/data
    networks:
      - {{NET_NAME}}_ledger
    depends_on:
      # the SVID it serves, once redpanda-tls has written a certificate and key that match (after a host reboot the broker
      # still exits and restarts until then: unless-stopped)
      {{REGISTRY_NAME}}-redpanda-tls:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "rpk", "cluster", "health"]
      interval: 15s
      timeout: 5s
      retries: 3
    logging: *default-logging

  # §MTLSHOPS S5 (2026-09-15, agentvault2-85's finding, measured by b5): Redpanda reloads kafka_api_tls by inotify, and the
  # cert-writer replaces its files (busybox cp: DELETE then CREATE, all three within 3 ms). Every live broker re-watched the
  # new certificate and bundle by name and never the key again, so from the first SVID rotation after its start each reload
  # failed "certificate and key do not match" and it served its old SVID until that expired. This copies the frame's SVID
  # into a broker-only volume IN PLACE (the same inodes, so the broker's watches never go away), only when the certificate's
  # public key equals the key's, and only the files whose content changed. A named volume on purpose: after a host reboot
  # docker starts the broker by its restart policy, before this sidecar, and the broker finds the last pair there.
  # Healthy = the broker volume holds a matching pair, the last successful sync is under 35 s old, and the copy is not within
  # a quarter of its own lifetime of expiry (agentvault2-85: a dead cert-writer leaves every sync succeeding on an ageing pair).
  # Not half: a half margin holds only while every rotation's copy (up to REFRESH_SEC plus 10 s after it) lands before
  # half-life; sbx-alpha's 13:59Z rotation came 11 minutes before half-life (85), and a quarter does not depend on that lead.
  {{REGISTRY_NAME}}-redpanda-tls:
    image: ${FT_CERT_WRITER_IMAGE:-agentvault2-cert-writer-test-a:spire1153}
    container_name: {{REGISTRY_NAME}}-redpanda-tls
    restart: unless-stopped
    network_mode: none
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        mkdir -p /tmp/in
        while true; do
          if cp /certs/svid.0.pem /tmp/in/c && cp /certs/svid.0.key /tmp/in/k && cp /certs/bundle.0.pem /tmp/in/b \
             && c=$$(openssl x509 -in /tmp/in/c -noout -pubkey 2>/dev/null) && [ -n "$$c" ] \
             && k=$$(openssl pkey -in /tmp/in/k -pubout 2>/dev/null) && [ "$$c" = "$$k" ] \
             && grep -q 'BEGIN CERTIFICATE' /tmp/in/b; then
            cmp -s /tmp/in/k /redpanda-tls/svid.0.key || cat /tmp/in/k > /redpanda-tls/svid.0.key
            cmp -s /tmp/in/c /redpanda-tls/svid.0.pem || cat /tmp/in/c > /redpanda-tls/svid.0.pem
            cmp -s /tmp/in/b /redpanda-tls/bundle.0.pem || cat /tmp/in/b > /redpanda-tls/bundle.0.pem
            nb=$$(openssl x509 -in /tmp/in/c -noout -dateopt iso_8601 -startdate | cut -d= -f2 | tr -d Z) \
              && na=$$(openssl x509 -in /tmp/in/c -noout -dateopt iso_8601 -enddate | cut -d= -f2 | tr -d Z) \
              && echo $$(( ($$(date -u -d "$$na" +%s) - $$(date -u -d "$$nb" +%s)) / 4 )) > /tmp/in/margin \
              && touch /tmp/in/synced
          fi
          sleep 10
        done
    volumes:
      - {{VOL_PREFIX}}_redpanda_certs_{{TS}}:/certs:ro
      - {{VOL_PREFIX}}_redpanda_tls_{{TS}}:/redpanda-tls
    depends_on:
      {{REGISTRY_NAME}}-cert-writer:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "c=$$(openssl x509 -in /redpanda-tls/svid.0.pem -noout -pubkey) && k=$$(openssl pkey -in /redpanda-tls/svid.0.key -pubout) && [ -n \"$$c\" ] && [ \"$$c\" = \"$$k\" ] && [ $$(( $$(date +%s) - $$(stat -c %Y /tmp/in/synced) )) -lt 35 ] && openssl x509 -in /redpanda-tls/svid.0.pem -noout -checkend $$(cat /tmp/in/margin) >/dev/null"]
      interval: 10s
      timeout: 5s
      retries: 3
      # a fresh frame's first SVID waits for SPIRE and its entries; the first passing check ends this period at once
      start_period: 300s
    logging: *default-logging

  {{REGISTRY_NAME}}-redpanda-init:
    # §SOVKIT K1: the ledger topics with explicit partitions (auto-create is off), before the store's first connect.
    # One-shot and idempotent (describe, else create); the store waits for it to complete successfully; a later
    # `compose up` runs it again and it changes nothing. It authenticates as the store's user over SASL/TLS.
    image: redpandadata/redpanda:v26.2.3
    container_name: {{REGISTRY_NAME}}-redpanda-init
    restart: "no"
    environment:
      RPK_BROKERS: ${FT_KAFKA_BOOTSTRAP_SERVERS}
      RPK_USER: ${FT_ES_KAFKA_SASL_USERNAME}
      RPK_PASS: ${FT_ES_KAFKA_SASL_PASSWORD}
      RPK_SASL_MECHANISM: ${FT_ES_KAFKA_SASL_MECHANISM}
      RPK_TLS_ENABLED: ${FT_KAFKA_RPK_TLS_ENABLED}
      RPK_TLS_CA: ${FT_ES_KAFKA_SSL_CAFILE}
      LEDGER_TOPICS: ${FT_KAFKA_TOPICS}
      LEDGER_PARTITIONS: ${FT_KAFKA_PARTITIONS}
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        i=0
        until rpk cluster info >/dev/null 2>&1; do
          i=$$((i+1)); [ "$$i" -ge 60 ] && { echo "redpanda-init: the broker never answered over SASL/TLS"; exit 1; }
          sleep 2
        done
        for t in $$(echo "$$LEDGER_TOPICS" | tr ',' ' '); do
          rpk topic describe "$$t" >/dev/null 2>&1 || rpk topic create "$$t" -p "$$LEDGER_PARTITIONS" -r 1 || exit 1
        done
        rpk topic list
    volumes:
      - {{VOL_PREFIX}}_redpanda_certs_{{TS}}:/certs:ro
    networks:
      - {{NET_NAME}}_ledger
    depends_on:
      {{REGISTRY_NAME}}-redpanda:
        condition: service_healthy
    logging: *default-logging

  # ═══════════════════════════════════════════════════════════════════════
  # SPIRE (trust domain: {{TRUST_DOMAIN}})
  # ═══════════════════════════════════════════════════════════════════════

  {{REGISTRY_NAME}}-spire-server:
    image: ghcr.io/spiffe/spire-server:1.15.3
    container_name: {{REGISTRY_NAME}}-spire-server
    restart: unless-stopped
    user: "0:0"
    command: ["-config", "/opt/spire/conf/server.conf"]
    volumes:
      - {{STACK_DIR}}/server.conf:/opt/spire/conf/server.conf:ro
      - {{STACK_DIR}}/x509pop-certs:/opt/spire/conf/x509pop-certs:ro
      - {{VOL_PREFIX}}_spire_data_{{TS}}:/opt/spire/data
    ports:
      # gRPC: chained operator's spire-agent reaches us via host.docker.internal:8191.
      # Bundle: remote peers fetch the trust bundle during federation.
      - "{{PORT_SPIRE_GRPC}}:8081"
      - "{{PORT_SPIRE_BUNDLE}}:8443"
    networks:
      - {{NET_NAME}}
      - {{IDENTITY_NET_NAME}}
    healthcheck:
      test: ["CMD", "/opt/spire/bin/spire-server", "healthcheck"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s
    logging: *default-logging

  {{REGISTRY_NAME}}-spire-agent:
    image: ghcr.io/spiffe/spire-agent:1.15.3
    container_name: {{REGISTRY_NAME}}-spire-agent
    restart: unless-stopped
    user: "0:0"
    pid: "host"
    command: ["-config", "/opt/spire/conf/agent.conf"]
    volumes:
      - {{STACK_DIR}}/agent.conf:/opt/spire/conf/agent.conf:ro
      - {{STACK_DIR}}/x509pop-certs:/opt/spire/conf/x509pop-certs:ro
      - {{VOL_PREFIX}}_spire_socket_{{TS}}:/opt/spire/sockets
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - {{NET_NAME}}
      - {{IDENTITY_NET_NAME}}
    depends_on:
      {{REGISTRY_NAME}}-spire-server:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "/opt/spire/bin/spire-agent", "healthcheck", "-socketPath", "/opt/spire/sockets/agent.sock"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s
    logging: *default-logging

  {{REGISTRY_NAME}}-cert-writer:
    image: ${FT_CERT_WRITER_IMAGE:-agentvault2-cert-writer-test-a:spire1153}
    container_name: {{REGISTRY_NAME}}-cert-writer
    restart: unless-stopped
    environment:
      SPIRE_SOCKET: ${FT_CW_SPIRE_SOCKET}
      CERT_DIR: ${FT_CERT_DIR}
      REFRESH_SEC: ${FT_CW_REFRESH_SEC}
      SERVICE_NAME: ${FT_CW_SERVICE_NAME}
      KEY_MODE: ${FT_CW_KEY_MODE}
      KEY_OWNER: ${FT_CW_KEY_OWNER}
    volumes:
      - {{VOL_PREFIX}}_spire_socket_{{TS}}:/opt/spire/sockets:ro
      - {{VOL_PREFIX}}_svid_certs_{{TS}}:/certs
    networks:
      - {{NET_NAME}}
      - {{IDENTITY_NET_NAME}}
    labels:
      - "com.agentvault.service=svid-writer-{{REGISTRY_NAME}}"
    depends_on:
      {{REGISTRY_NAME}}-spire-agent:
        condition: service_started
    logging: *default-logging

  # ═══════════════════════════════════════════════════════════════════════
  # NGINX FEDERATION (mTLS)
  # ═══════════════════════════════════════════════════════════════════════

  {{REGISTRY_NAME}}-teg-cert-writer:
    # §F5 (2026-09-26): this identity's own writer; only the service(s) named in its volume's consumers mount it
    image: ${FT_CERT_WRITER_IMAGE:-agentvault2-cert-writer-test-a:spire1153}
    container_name: {{REGISTRY_NAME}}-teg-cert-writer
    restart: unless-stopped
    environment:
      SPIRE_SOCKET: ${FT_CW_SPIRE_SOCKET}
