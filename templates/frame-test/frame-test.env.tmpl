# ═══════════════════════════════════════════════════════════
# Frame Test — Ephemeral Sovereign Frame (.env.frame-test)
# Rendered from templates/frame-test/frame-test.env.tmpl (TRACKED since D12;
# the old .env.frame-test.tmpl name was gitignored by `.env.*`).
# Trust domain: spiffe://{{TRUST_DOMAIN}}
# Generated at: {{TS}}
# ═══════════════════════════════════════════════════════════

# ── Identity
REGISTRY_NAME={{REGISTRY_NAME}}
PUBLIC_URL=http://localhost:{{PORT_REGISTRY}}
MINTING_AUTHORITY=teg-layer

# ── Database passwords (random per-run)
PG_PASS_REGISTRY={{PG_PASS_REGISTRY}}
PG_PASS_TEG={{PG_PASS_TEG}}
PG_PASS_EVENT_STORE={{PG_PASS_EVENT_STORE}}

# ── Application secrets
SECRET_KEY={{SECRET_KEY}}
JWT_SECRET_KEY={{JWT_SECRET_KEY}}
API_KEY_SECRET={{API_KEY_SECRET}}
TEG_ADMIN_API_KEY={{TEG_ADMIN_API_KEY}}
EVENT_STORE_INTERNAL_API_KEY={{EVENT_STORE_INTERNAL_API_KEY}}

# ── SPIRE
SPIRE_TRUST_DOMAIN={{TRUST_DOMAIN}}

# ── Kafka: §SOVKIT K1 (2026-09-14) the broker is PRIVATE to the event store. This bare line reaches the registry
# through its env_file; a pre-V0371 registry still holds a producer and must not try the ledger bus (it could not
# reach it: the broker sits on the ledger-only network). V0371+ reads nothing named KAFKA_*.
KAFKA_ENABLED=false

# ── Features
GENESIS_GRANT_ENABLED=true
GENESIS_GRANT_AMOUNT=1000.0
BETA_INVITE_REQUIRED=false
AUDITED_BALANCE_ENABLED=true

# ── Admin (auto-seeded on first boot)
ADMIN_EMAIL=admin@{{TRUST_DOMAIN}}
ADMIN_PASSWORD={{ADMIN_PASSWORD}}

# ── Empty partner TEGs (test frame is standalone until federation stage)
PARTNER_TEGS=[]

# ── Chained operator test — MUST be enabled for stage 9 to work
ENABLE_SANDBOX_PROVISIONER_TEST=true

# ── Federation internal secret — PER RUN since D12 (2026-09-05). It used to be a
# literal shared with the retired sandbox-a tier; a tracked template must not carry
# one. The provisioner generates it, or takes FRAME_TEST_FEDERATION_INTERNAL_SECRET
# from its own environment when two frames must share it (HTTP federation sync).
FEDERATION_INTERNAL_SECRET={{FEDERATION_INTERNAL_SECRET}}
# §SECFIX-4 (2026-09-25): a federation caller must be bound to an ACTIVE peer row (inert until a peer row carries a
# SPIFFE id; the invitation and the operator provisioner create those rows before their peers call)
FEDERATION_REQUIRE_PEER_SPIFFE_BIND=true
# §SECFIX-2 (2026-09-25): the TEG takes internal callers by SVID only (the shared admin key no longer authenticates)
FT_TEG_MTLS_REQUIRED=true

# ── Cross-frame replication disabled (no peers at boot; exchanged at stage 8)
CROSS_FRAME_REPLICATION_ENABLED=false

# ── WS3 federation handshake — bundle/federation endpoints advertised to peers
# Defaults to per-frame container DNS for single-frame test; overridden by the
# dual-frame orchestrator to point at the shared identity network's DNS names.
FRAME_LOCAL_BUNDLE_ENDPOINT_URL={{FRAME_LOCAL_BUNDLE_ENDPOINT_URL}}
FRAME_LOCAL_FEDERATION_ENDPOINT_URL={{FRAME_LOCAL_FEDERATION_ENDPOINT_URL}}

# ═══════════════════════════════════════════════════════════
# D12 — values the compose template interpolates as ${FT_...}
# The compose carries names only. `FT_<KEY>` is ONE value every service that reads
# that key shares (MINT_PROXY_SECRET must match on teg AND registry — one line, one
# rule); `FT_<SVC>_<KEY>` belongs to a single service. Double-brace placeholders are rendered
# per run by the provisioner. ⚠ the registry service also loads this whole file via
# env_file (its legacy contract), so every FT_ value is visible in its container env.
# ═══════════════════════════════════════════════════════════

# ── shared
FT_CERT_DIR=/certs
FT_EVENT_STORE_URL=http://{{REGISTRY_NAME}}-event-store:8200
# §SOVKIT T5 (agentvault2-85, proven on orchard 2026-09-14): the store's mTLS sidecar, the write path of the TEG (its
# emitter builds an mTLS context from /certs) and, from V0370 on, of the registry (every store caller on es_ssl_helper).
# The solo auditor reads the store through the sidecar too, with its own SVID (§MTLSHOPS T2: the driver's frames file
# names the sidecar, and the auditor carries no store key).
FT_EVENT_STORE_MTLS_URL=https://{{REGISTRY_NAME}}-nginx-event-store:8443
FT_FRAME_CURRENCY={{FRAME_CURRENCY}}
FT_KAFKA_BOOTSTRAP_SERVERS={{REGISTRY_NAME}}-redpanda:9092
FT_KAFKA_ENABLED=true
# §SOVKIT K1 (2026-09-14, his word "Kafka private to the store"): the store is the broker's ONLY client. SCRAM over
# TLS on the frame's own bundle (the broker serves the frame's SVID under the DNS name {{REGISTRY_NAME}}-redpanda),
# the password generated per frame by the provisioner, every record signed (ES_KAFKA_RECORD_AUTH=enforce: the consumer
# drops what this store did not sign). FT_KAFKA_RPK_TLS_ENABLED is the broker's own rpk client (the gates);
# FT_KAFKA_TOPICS / FT_KAFKA_PARTITIONS are what the init service creates (auto-create is off; the store keys
# records by aggregate id, so a partition is one aggregate's order).
FT_ES_KAFKA_SECURITY_PROTOCOL=SASL_SSL
FT_ES_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
FT_ES_KAFKA_SASL_USERNAME=es
FT_ES_KAFKA_SASL_PASSWORD={{KAFKA_ES_PASSWORD}}
FT_ES_KAFKA_SSL_CAFILE=/certs/bundle.0.pem
FT_ES_KAFKA_RECORD_AUTH=enforce
FT_KAFKA_RPK_TLS_ENABLED=true
FT_KAFKA_TOPICS=theprotocol.events.financial,theprotocol.events.governance,theprotocol.events.system
FT_KAFKA_PARTITIONS=4
FT_MINTING_AUTHORITY=teg-layer
FT_MINT_PROXY_SECRET={{MINT_PROXY_SECRET}}
FT_SPIFFE_ENDPOINT_SOCKET=unix:///opt/spire/sockets/agent.sock
FT_SPIRE_TRUST_DOMAIN={{TRUST_DOMAIN}}
FT_TRUSTED_SPIFFE_DOMAINS={{TRUST_DOMAIN}}{{EXTRA_TRUSTED_SPIFFE_DOMAINS}}

# ── db
FT_DB_POSTGRES_DB=frame_test_registry
FT_DB_POSTGRES_USER=registry

# ── teg-db
FT_TEGDB_POSTGRES_DB=frame_test_teg
FT_TEGDB_POSTGRES_USER=teg

# ── es-db
FT_ESDB_POSTGRES_DB=frame_test_events
FT_ESDB_POSTGRES_USER=eventstore

# ── cert-writer
FT_CW_SPIRE_SOCKET=/opt/spire/sockets/agent.sock
FT_CW_REFRESH_SEC=300
FT_CW_SERVICE_NAME={{REGISTRY_NAME}}-registry

# §F5 (2026-09-26): one identity per service. The shared writer's key is the registry's alone (uid 1000, mode 600);
# each service writer below owns one volume, one SPIRE entry (its label), and closes its key to its reader's uid.
FT_CW_KEY_MODE=600
FT_CW_KEY_OWNER=1000
FT_TEGCW_SERVICE_NAME={{REGISTRY_NAME}}-teg
FT_TEGCW_KEY_OWNER=1000
FT_ESCW_SERVICE_NAME={{REGISTRY_NAME}}-event-store
FT_ESCW_KEY_OWNER=0
FT_NGESCW_SERVICE_NAME={{REGISTRY_NAME}}-nginx-event-store
FT_NGESCW_KEY_OWNER=0
FT_NGTEGCW_SERVICE_NAME={{REGISTRY_NAME}}-nginx-teg
FT_NGTEGCW_KEY_OWNER=0
FT_NGFEDCW_SERVICE_NAME={{REGISTRY_NAME}}-nginx-federation
FT_NGFEDCW_KEY_OWNER=0
FT_RPCW_SERVICE_NAME={{REGISTRY_NAME}}-redpanda
FT_RPCW_KEY_OWNER=0
# ── nginx-federation: §MTLSHOPS G1/G2 (2026-09-15, agentvault2-85's markers) the peer-facing terminator marks what it
# forwards to each app: the TEG's X-TEG-Proxy-Auth on /api/v1/cross-teg/, the registry's X-Registry-Proxy-Auth on its
# federation, card, bridge, balance-sync, contracts and route-hop locations, each beside X-SSL-Client-Verify. The apps count
# a forwarded client certificate only with both. Generated per frame; substituted into the conf at the container's start.
FT_NGF_TEG_PROXY_TRUST_SECRET={{TEG_PROXY_TRUST_SECRET}}
FT_NGF_REGISTRY_PROXY_TRUST_SECRET={{REGISTRY_PROXY_TRUST_SECRET}}

# ── nginx-teg
FT_NGT_RELOAD_SEC=300
FT_NGT_SERVICE_NAME={{REGISTRY_NAME}}-nginx-teg
# §MTLSHOPS G1: the TEG counts a certificate this sidecar forwards only beside X-TEG-Proxy-Auth equal to this value.
FT_NGT_PROXY_TRUST_SECRET={{TEG_PROXY_TRUST_SECRET}}
# §MTLSGAP 2026-09-08 — the EventStore mTLS sidecar. Same shape as the TEG one above; the ES had
# no gateway on any frame this template ever built, so every registry wrote to its own ledger in
# plain http while TEG and federation were `ssl_verify_client on`.
FT_NGES_RELOAD_SEC=300
FT_NGES_SERVICE_NAME={{REGISTRY_NAME}}-nginx-event-store
FT_NGES_PROXY_TRUST_SECRET={{ES_PROXY_TRUST_SECRET}}

# ── event-store
# §MTLSHOPS G3: the store authenticates to the frame's Redis as its ACL user (db 1); the ACL file holds only a SHA-256.
# §MTLSHOPS T3: TLS with the client's SVID, the server's name verified against the frame's bundle (redis-py reads the files at every connect)
FT_ES_REDIS_URL=rediss://store:{{REDIS_STORE_PASSWORD}}@{{REGISTRY_NAME}}-redis:6379/1?ssl_cert_reqs=required&ssl_ca_certs=/certs/bundle.0.pem&ssl_certfile=/certs/svid.0.pem&ssl_keyfile=/certs/svid.0.key&ssl_check_hostname=true
FT_ES_UVICORN_WORKERS={{WORKERS_ES}}
# 🔴 §XFRAMEREPL (2026-09-10) — THIS WAS FORGOTTEN AT THE EU/ASIA STANDUP AND NOBODY NOTICED FOR
# THREE DAYS. Both frames ran with replication off and no peer list, so each held ZERO foreign
# events while the legacy tier held 40,101,921. Nothing errored: a frame with no peers to poll
# looks exactly like a frame whose peers are quiet. It surfaced only because peer trust went
# one-directional — a frame can only observe settlements written to its OWN ledger, so the sender
# recorded and the receiver never did.
#
# THREE HALVES, and the standup wrote none of them. The flag below; the peer list under it; and
# the peer's event-store SERVICE NAME in FT_ES_KNOWN_INTERNAL_SERVICES, without which the peer's
# SVID matches no entry and the export 403s with our own SPIFFE ID quoted back at us.
# Leave the flag false until a peer is actually named — a flag that claims a capability its
# precondition cannot supply is worse than no flag (R10, and §FXSTRAND before it).
FT_ES_CROSS_FRAME_REPLICATION_ENABLED=false
# "<peer trust domain>|<peer event-store url>", comma-separated. Set together with the flag.
FT_ES_CROSS_FRAME_PEERS=
FT_ES_EVENTSTORE_HTTP_VIA_KAFKA=true
FT_ES_EVENTSTORE_JWT_AUDIENCE=spiffe://{{TRUST_DOMAIN}}/eventstore
FT_ES_EVENTSTORE_JWT_JWKS_URL=http://{{REGISTRY_NAME}}-registry:8000/api/v1/spire/jwks
FT_ES_EVENTSTORE_WS_AUTH_REQUIRED=false
# §MTLSGAP 2026-09-08 — THESE MUST BE THE NAMES IN THE SPIRE ENTRIES, NOT THE NAMES OF THE
# CONTAINERS. The ES builds `spiffe://<td>/service/<name>` for each entry here and accepts a
# client SVID only if it matches one. The old value named `registry-<frame>`, `teg-core-<frame>`
# and `teg-<frame>` — those are the compose LABELS the SPIRE selectors key on; the entries they
# create are `/service/<frame>-registry` (cert-writer), `/service/registry` (the registry
# workload) and `/service/teg-layer` (the TEG). So all three were wrong, on every frame ever
# stood up from this template. Inert only because nothing spoke mTLS to the ES; a total refusal
# the moment the gateway above went in — which is exactly what "a gateway nothing verifies
# against is worse than none" means. Measured on EU: the registry presents `/service/<frame>-registry`
# on its cross-frame TEG hop and `/service/registry` on its federation hop, so BOTH are listed.
FT_ES_KNOWN_INTERNAL_SERVICES={{REGISTRY_NAME}}-registry,registry,teg-layer
# §SOVKIT T2/T5 (agentvault2-85, 2026-09-14): the store's mTLS is REAL on the :sovkit1 image. It trusts the X-SSL-Client-*
# headers only beside X-ES-Proxy-Auth equal to this per-frame secret, which only its two terminators know (the in-frame
# nginx-event-store sidecar and the public <frame>-es host vhost, via /etc/nginx/snippets/es-proxy-auth-<frame>.conf).
# EVENTSTORE_MTLS_REQUIRED=true from birth: a runner-built frame never runs the unverified posture. ES_OWN_TRUST_DOMAIN
# names the store's own trust domain explicitly (only origin changes federation records).
FT_ES_ES_PROXY_TRUST_SECRET={{ES_PROXY_TRUST_SECRET}}
FT_ES_EVENTSTORE_MTLS_REQUIRED=true
FT_ES_ES_OWN_TRUST_DOMAIN={{TRUST_DOMAIN}}
FT_ES_KAFKA_CONSUMER_BATCH_SIZE=200

# ── release channel (§RELEASECHANNEL, 2026-09-21). The registry reads the SIGNED release document every 6 h and tells
# this frame's admins, once per version, when a stable release or a hotfix is newer than what it runs; they schedule
# the rollout on the admin page and run frame-update.py in their window. The check is a plain GET of a public file
# (no version, no identifier sent). Set to false to opt out; RELEASE_CHANNEL_URL points at another channel.
RELEASE_CHANNEL_CHECK_ENABLED=true
FT_ES_KAFKA_CONSUMER_BATCH_TIMEOUT_MS=300
FT_ES_PROMETHEUS_MULTIPROC_DIR=/tmp/prom_multiproc_es

# ── teg
FT_TEG_TEG_TOKEN_SIGNING_KEY={{TEG_TOKEN_SIGNING_KEY}}
FT_TEG_AVTP_SYSTEM_API_KEY={{TEG_AVTP_SYSTEM_API_KEY}}
FT_TEG_REGISTRY_URL=http://{{REGISTRY_NAME}}-registry:8000
FT_TEG_TEG_ID=teg-layer
# §MTLSHOPS G1: without a usable value (32+ characters) the TEG's header path is off and a peer's call through its terminators is refused.
FT_TEG_TEG_PROXY_TRUST_SECRET={{TEG_PROXY_TRUST_SECRET}}
# §MTLSHOPS G3: the TEG's ACL user (db 2).
# §MTLSHOPS T3: TLS with the client's SVID, the server's name verified against the frame's bundle (redis-py reads the files at every connect)
FT_TEG_REDIS_URL=rediss://teg:{{REDIS_TEG_PASSWORD}}@{{REGISTRY_NAME}}-redis:6379/2?ssl_cert_reqs=required&ssl_ca_certs=/certs/bundle.0.pem&ssl_certfile=/certs/svid.0.pem&ssl_keyfile=/certs/svid.0.key&ssl_check_hostname=true
FT_TEG_CROSS_TEG_ENABLED=true
FT_TEG_TEG_BALANCE_OUTBOX_ENABLED=true
# §LEDGERGATE (2026-10-12, contract R40): the TEG's ledger gate. off = the code default, so a frame born here runs it
# off; shadow counts what it would refuse and refuses nothing; enforce refuses a movement while the outbox is
# unhealthy. A TEG image without the gate (adminscope1 and older) ignores the line.
FT_TEG_TEG_LEDGER_GATE_MODE=off
# The TEG-to-TEG partner rule (2026-10-21, his word: "framekit must also have it in shadowmode"): a cross-TEG leg moves
# only with a peer this TEG holds as a current partner (enforce, the code default). A frame born here runs it in shadow:
# it logs and counts what it would refuse (WOULD REFUSE, teg_cross_teg_partner_refused_total) and refuses nothing.
# Enforce it once the trust with your peers is set up and the shadow log stays quiet. A TEG image without the rule ignores
# the line.
FT_TEG_CROSS_TEG_PARTNER_RULE_MODE=shadow
# fresh posture, TEG side (D8 + the profile's TEG-scope knobs — the TEG does not read the profile file)
FT_TEG_TEG_ONBOARDING_MINT_ENABLED=false
FT_TEG_TEG_STAKING_REWARD_CYCLE_ENABLED=false
FT_TEG_TEG_TRANSFER_MAX_AVT=100000
FT_TEG_TEG_MINT_MAX_AVT=1000000
FT_TEG_TEG_MINT_REQUIRE_PROXY=true
FT_TEG_TEG_HOME_FRAME_GUARD_ENABLED=true
FT_TEG_TEG_BULK_USE_ASYNC_DB=true
FT_TEG_ESCROW_RECONCILER_ENABLED=true
FT_TEG_ESCROW_RECONCILER_DRY_RUN=false
FT_TEG_TEG_BATCH_WRITES=true
FT_TEG_TEG_BATCH_FLUSH_INTERVAL_MS=10
FT_TEG_TEG_BATCH_MAX_SIZE=50
FT_TEG_PROMETHEUS_MULTIPROC_DIR=/tmp/prom_multiproc_teg

# ── registry
# §MTLSHOPS T2 (S4): the TEG answers only through its terminators; V0378's registry dials nginx-teg with its SVID (and
# the frame_slug fix, which read the frame from a `<frame>-teg` host).
FT_REG_TEG_LAYER_URL=https://{{REGISTRY_NAME}}-nginx-teg:8443
FT_REG_TEG_API_BASE_URL=https://{{REGISTRY_NAME}}-nginx-teg:8443
# §MTLSHOPS G3: the registry's ACL user (db 0; the limiter and the leader locks ride the same URL).
# §MTLSHOPS T3: TLS with the client's SVID, the server's name verified against the frame's bundle (redis-py reads the files at every connect)
FT_REG_REDIS_URL=rediss://registry:{{REDIS_REGISTRY_PASSWORD}}@{{REGISTRY_NAME}}-redis:6379/0?ssl_cert_reqs=required&ssl_ca_certs=/certs/bundle.0.pem&ssl_certfile=/certs/svid.0.pem&ssl_keyfile=/certs/svid.0.key&ssl_check_hostname=true
FT_REG_REGISTRY_NAME={{REGISTRY_NAME}}
FT_REG_ALLOWED_ORIGINS="[\"{{PUBLIC_BASE_URL}}\"]"
FT_REG_TEG_BULK_PROXY=true
FT_REG_MAINFRAME_REGISTRY_NAMES={{MAINFRAME_REGISTRY_NAMES}}
FT_REG_CROSS_TEG_FUND_ORIGIN_ALLOWLIST={{CROSS_TEG_FUND_ORIGINS}}
FT_REG_IS_CENTRAL_REGISTRY=true
# 30 s like the production frames (his word 2026-10-07; the nightly already ran its frames at 30)
FT_REG_FEDERATION_SYNC_INTERVAL_SECONDS=30
FT_REG_AGENT_RBAC_MODE=enforce
FT_REG_AGENT_DELEGATION_MODE=enforce
FT_REG_AGENT_XREG_DELEGATION_ENABLED=true
FT_REG_SPAWN_WALLET_ANCHOR_MODE=on
FT_REG_IRONHAND_INLINE_SVID_ENABLED=true
FT_REG_CAPABILITY_CIRCUIT_BREAKER_ENABLED=true
FT_REG_FEDERATION_INGEST_FAIL_CLOSED=true
FT_REG_MCP_AUDIT_LOGGING_ENABLED=true
FT_REG_REGISTRY_SIGNING_KEY_REQUIRE_ENCRYPTION=true
FT_REG_REGISTRY_SIGNING_KEY_PASSPHRASE={{REGISTRY_SIGNING_KEY_PASSPHRASE}}
FT_REG_TWO_FACTOR_ENCRYPTION_KEY={{TWO_FACTOR_ENCRYPTION_KEY}}
FT_REG_FEDERATION_HEALTH_CHECK_SECRET={{FEDERATION_HEALTH_CHECK_SECRET}}
FT_REG_EVENT_STORE_ENABLED=true
FT_REG_FEDERATION_ENABLED=true
FT_REG_EXCHANGE_ENABLED=true
FT_REG_CONTRACTS_V2_ENABLED=true
FT_REG_CONTRACT_TEMPLATES_ENABLED=true
FT_REG_GUILD_ENABLED=true
FT_REG_GUILD_MINTS_CONTRACTS=true
FT_REG_AGENT_SPAWN_ENABLED=true
FT_REG_NOTIFY_V2_MODE=on
FT_REG_LIABILITY_MODE=enforce
# ── THE FRESH POSTURE (his decisions 2026-09-04, D4/D5/D7/D8/D12 + §REPBOND/§ENFPROP; built 2026-09-05 §BATCH5) ──
# registration OPEN (BETA_INVITE_REQUIRED=false above) ⇒ the reputation bond is the spam gate, ENFORCE; enforcement
# state rides the card to every mirror, ENFORCE; the gateway re-arm lever at 50 everywhere; canaries OFF at standup;
# the money amounts come from the low-supply network profile (S0/GRANT rendered in the image); the legacy money
# surfaces are retired (flags default ON elsewhere; a fresh network never carried them); every human link names
# the console (PUBLIC_UI_URL). Each key below is ALSO a compose line (topology-only, ${VAR}) and a contract-gate rule.
FT_REG_REPUTATION_BOND_MODE=enforce
# The treasury backstop OFF (his word 2026-10-31, "1-3 approve"; §EXTTEST run 2): with it on, any developer bonds its own
# agents from the treasury for nothing, so on a frame with open registration the bond gates nobody. EU and ASIA run it
# off from V0649 on. A test frame that bonds through the backstop sets it back (the nightly pair's NIGHTLY_FLAGS).
FT_REG_REPUTATION_BOND_TREASURY_BACKSTOP=false
FT_REG_ENFORCEMENT_SLASH_MODE=enforce
FT_REG_ENFORCEMENT_PROPAGATION_MODE=enforce
# §DIDWIDEN item 1 (2026-09-06, his approval): a fresh frame creates agent DIDs under its own trust domain
# (did:theprotocol:<trust domain>:<uuid4>) from birth; the guard refuses a peer that claims a namespace it does not own.
FT_REG_DID_ISSUER_NAMESPACE={{TRUST_DOMAIN}}
# the ledger strips a frame's console streams (its own frame + its federation peers); empty = its own socket only
FT_REG_FRESH_NETWORK_JSON=[]

# The federated index the console reads for its discovery strip (§DIRFEED). RELATIVE on purpose:
# the console vhost proxies /directory/ to the index same-origin, so this needs no second public
# hostname and no CORS. EMPTY = this frame has no index; the strip then does not render at all,
# which is the honest state — the driver writes this and the vhost lane TOGETHER or neither
# (--directory-upstream; findings row 170).
FT_REG_DIRECTORY_PUBLIC_URL=/api/v1/public/directory
# §MTLSGAP — the index's mTLS gateway, dialed by the REGISTRY with its own SVID. The key above is
# the path the CONSOLE asks for (`/api/v1/public/directory`), which `location /` already proxies —
# so no Directory lane is hand-added to the vhost, and a clean standup cannot drop one (§FRAMELIC).
FT_REG_DIRECTORY_MTLS_URL=https://{{REGISTRY_NAME}}-directory-nginx:8443
# ...and the THIRD half: whether this console OFFERS the index beside its own discovery. The
# registry ANDs it with the address above (a promise with no address is the blank-promise shape),
# and the FE ANDs it again — so all three move together or the lane does not exist.
FT_REG_DISCOVERY_VIA_DIRECTORY=true
# §BATCH6 — cross-frame FX (federation state; the runbook's §9 fills these when a peer frame is approved)
FT_REG_FX_ENABLED={{FX_ENABLED}}
FT_REG_FX_RATE_MODE=pool
FT_REG_FX_ROUTE_PEERS={{FX_ROUTE_PEERS}}
FT_REG_TEG_SIDECAR_MAP={{TEG_SIDECAR_MAP}}
FT_REG_FX_RESERVE_KEEPER_ENABLED={{FX_RESERVE_KEEPER_ENABLED}}
FT_REG_EVENT_STORE_B_URL={{EVENT_STORE_B_URL}}
FT_REG_GATEWAY_REARM_ABANDONED_BATCH=50
FT_REG_CANARY_ENABLED=false
FT_REG_CANARY_RUNNER_ENABLED=false
FT_REG_CANARY_JUDGE_ENABLED=false
FT_REG_CANARY_REBALANCER_ENABLED=false
FT_REG_CANARY_REFILL_ENABLED=false
FT_REG_CANARY_VALIDATOR_ENABLED=false
FT_REG_NETWORK_PROFILE=lowsupply-2026
FT_REG_API_TEST_EXECUTION_ENABLED=false
FT_REG_TREASURY_MM_ENABLED=true
FT_REG_LEGACY_CONTRACTS_ENABLED=false
FT_REG_TOKEN_BRIDGE_ENABLED=false
FT_REG_ARENA_BETTING_ENABLED=false
FT_REG_REGISTRY_STAKING_CLAIM_REWARDS_ENABLED=true
FT_REG_PUBLIC_UI_URL={{PUBLIC_BASE_URL}}
FT_REG_JURISDICTION_MODE=shadow
FT_REG_AUTO_TALLY_ENABLED=true
FT_REG_AUTO_TALLY_INTERVAL_SECONDS=60
# §ONESHOT R13 (2026-09-12) — POSTURES THE CODE TURNS ON WITH NO TEMPLATE LINE, NAMED HERE SO THE
# TEMPLATE IS THE WHOLE ANSWER. Each value below IS the code default (read at its site on 2026-09-12);
# a template reader could not see any of them before, and a frame ran all four without a line saying so.
# delisting travels as a tombstone to every mirror (listing_propagation.py:95 — env → profile → "enforce")
FT_REG_LISTING_PROPAGATION_MODE=enforce
# EigenTrust score projection, linear|log (eigentrust_engine.py:51); `log` is the measured alternative
FT_REG_EIGENTRUST_PROJECTION=linear
# the reactor that applies a passed proposal's outcome (main.py: default "true")
FT_REG_REACTOR_PROPOSAL_OUTCOME_ENABLED=true
# CONSUL quarantine teeth: the DB mode (off|dry_run|enforcing) is ANDed with this env flag (config.py:173);
