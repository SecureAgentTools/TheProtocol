# §MCPTEST30 (2026-10-15) — THE OPERATORS' PARENT ROW, AND THE CARD'S FEDERATION ADDRESS. These were the retired sandbox
# tier's literals (Sandbox-A, http://agentvault_registry_test:8000): cloud_provisioner seeds every operator's parent peer
# row from them, the card publishes the URL as identity.federation_base_url, and main.py counts the name among its own.
# §OPLANE's resolver finds an operator's parent lane only as an https row on the parent's public host with a port other
# than 443, so every runner-built frame's operators fell back to the console for their licence-carrying calls and met
# 401 "X-Federation-License header required" (the nightly pair's federation red since 2026-10-09). The lane is the
# host SNI router on 8443, as EU's and sandbox-a's (the standup driver wrote theirs by hand). Gate: contract R41.
FT_REG_BILATERAL_PEER_NAME={{REGISTRY_NAME}}
FT_REG_BILATERAL_PEER_URL=https://{{PUBLIC_HOSTNAME}}:8443
# §REDERIVE (2026-09-12) — THESE WERE FRAME-A SANDBOX LITERALS, AND THEY ARE NOT INERT.
# `cloud_provisioner` copies this frame's PARTNER_TEG_* verbatim into the `.env.operator` of EVERY
# operator it provisions. Measured on the live EU/ASIA cluster while re-deriving the reprovisioning
# ledger: every cloud operator's TEG holds
#     [{"teg_id":"teg-layer-test","registry_id":"registry-test","url":"","api_key":"none"}]
# — a partner entry for a TORN-DOWN sandbox node, with no address at all. It is inert only because
# `resolve_partner_url` prefers the registry's per-call `url_hint` and self-heals; a broken entry
# still reads as configuration to the next person, and an empty list does not.
# A frame's partner TEG is a PER-STANDUP FACT, so the template ships it EMPTY: the provisioner then
# writes `PARTNER_TEGS=[]` instead of a partner with no address, and contract rule R12 refuses a
# template that names a partner id without a URL.
# ⚠ Their neighbours below (BILATERAL_PEER_*, PARTNER_FRAME_TRUST_DOMAIN) are the same SHAPE of
# Frame-A sandbox literal but were not measured in that pass — do not assume they are right.
FT_REG_PARTNER_TEG_ID=
FT_REG_PARTNER_REGISTRY_ID=
FT_REG_PARTNER_TEG_URL=
FT_REG_PARTNER_FRAME_TRUST_DOMAIN=sandbox-a.test
FT_REG_SKIP_NGINX_VHOST=true
FT_REG_PROD_REGISTRY_DB={{REGISTRY_NAME}}-db
FT_REG_EVENT_STORE_PUBLIC_URL={{EVENT_STORE_PUBLIC_URL}}
FT_REG_EVENT_STORE_DB_CONTAINER={{REGISTRY_NAME}}-es-db
FT_REG_EVENT_STORE_DB_NAME=frame_test_events
FT_REG_EVENT_STORE_DB_USER=eventstore
FT_REG_CLOUD_PORT_MIN=31000
FT_REG_CLOUD_PORT_MAX=31299
FT_REG_API_TEST_TARGET_URL=http://registry-test:8000
FT_REG_SANDBOX_RESET_SECRET={{SANDBOX_RESET_SECRET}}
FT_REG_SANDBOX_A_INTERNAL_URL=http://registry-test:8000
FT_REG_SANDBOX_B_INTERNAL_URL=http://registry-test:8000
FT_REG_REGISTRY_A_CONTAINER={{REGISTRY_NAME}}-registry
# §ONESHOT F5 (2026-09-12) — the address every operator this frame provisions dials its PARENT on
# (cloud_provisioner copies it into .env.operator as CENTRAL_REGISTRY_URL). The internal docker name
# `http://<frame>-registry:8000` is PLAINTEXT and unresolvable from operator-net (§MTLSGAP row 203);
# the driver's own operator gate refused every operator born from it, and EU/ASIA's operators carry the
# public https console only because their env was fixed by hand. The public console IS the parent address.
FT_REG_CENTRAL_REGISTRY_URL_FOR_OPERATORS={{PUBLIC_BASE_URL}}
# §FEFRAME W2 (2026-10-01): EMPTY on purpose. This was localhost:{{PORT_REGISTRY}}, which the provisioner wrote into
# every operator's vhost as `proxy_pass https://localhost:<registry port>/ws/events`: TLS to the registry's plaintext
# port, which serves no /ws/events (all six operator consoles' ledger lanes 502, 2026-09-30). Empty = the frame's
# public BASE_URL host, whose console vhost proxies /ws/events to this frame's store. An override must be a public
# DNS name; since V0503 the provisioner refuses a loopback, an IP or a bare container name.
FT_REG_WS_EVENTS_PROXY_HOST=
FT_REG_PROMETHEUS_MULTIPROC_DIR=/tmp/prom_multiproc_reg
FT_REG_PYTHONPATH=/app/src
FT_REG_FRAME_LOCAL_BUNDLE_ENDPOINT_URL={{FRAME_LOCAL_BUNDLE_ENDPOINT_URL}}
# §F6 stage 5 (2026-09-27): every host job of the registry through the frame runner (R38). A value this code does not
# know is refused, never guessed: runner, or the route fails closed with the runner's own sentence.
FT_REG_HOST_REACH_PREFER=runner
FT_REG_FRAME_TRUST_SPIRE_VIA=runner
FT_REG_IRONHAND_SPIRE_MODE=runner
FT_REG_OPERATOR_LIFECYCLE_VIA=runner
FT_REG_CONTAINER_OBSERVE_VIA=runner
FT_REG_FRAME_LOCAL_FEDERATION_ENDPOINT_URL={{FRAME_LOCAL_FEDERATION_ENDPOINT_URL}}

# ── ntfy
FT_NTFY_NTFY_CACHE_FILE=/var/cache/ntfy/cache.db
FT_NTFY_NTFY_BEHIND_PROXY=true
# §MTLSHOPS T2 (S4, 2026-09-15): nginx-ntfy, the registry's mTLS publish lane to ntfy's socket
FT_NGNTFY_RELOAD_SEC=300
