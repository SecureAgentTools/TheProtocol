FT_REG_FEDERATION_ENFORCEMENT_ACTIVE=false
FT_REG_BASE_URL={{PUBLIC_BASE_URL}}
FT_REG_REQUIRE_EMAIL_VERIFICATION={{REQUIRE_EMAIL_VERIFICATION}}
FT_REG_PUSH_NOTIFY_ENABLED=true
# §MTLSHOPS T2 (S4, 2026-09-15): the registry publishes through nginx-ntfy with its SVID (V0378's client takes TLS from the scheme)
FT_REG_PUSH_NTFY_URL=https://{{REGISTRY_NAME}}-nginx-ntfy:8443
FT_REG_PUSH_APP_BASE_URL={{PUBLIC_BASE_URL}}
FT_REG_PUSH_NTFY_PUBLIC_URL={{PUSH_NTFY_PUBLIC_URL}}
FT_REG_CLOUD_DOMAIN_SUFFIX=op-frame-test.internal
FT_REG_FEDERATION_BASE_URL=https://{{REGISTRY_NAME}}-nginx-federation:8443
# §MTLSHOPS G2: the registry counts a forwarded client certificate only beside X-Registry-Proxy-Auth equal to this value.
