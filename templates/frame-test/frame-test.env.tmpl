# ── §SOVKIT (2026-09-14): the sovereign kit — OPA, Prometheus + Alertmanager + Grafana, the solo auditor, the Directory.
# Images are values the operator may pin; secrets are generated per frame by the provisioner; the read-only DB role the
# auditor uses is created by the standup driver after the databases are healthy (kit/auditor/frames/frames.json).
FT_OPA_IMAGE=openpolicyagent/opa:1.21.0
FT_OPA_LOG_LEVEL=info
# §MTLSHOPS T2 (2026-09-15): how often OPA re-reads its certificate and the frame bundle (well under the 4 h SVID TTL).
FT_OPA_TLS_REFRESH=5m
FT_REG_OPA_ENABLED=true
FT_REG_OPA_ENFORCE=false
# §MTLSHOPS T2: OPA serves TLS and authorizes the registry's certificate (V0378's client presents it).
FT_REG_OPA_URL=https://{{REGISTRY_NAME}}-opa:8181
FT_PROM_IMAGE=prom/prometheus:v3.15.0
FT_PROM_RETENTION=30d
FT_AM_IMAGE=prom/alertmanager:v0.34.1
FT_GRAFANA_IMAGE=grafana/grafana:13.2.2
FT_GRAFANA_ADMIN_USER=admin
FT_GRAFANA_ADMIN_PASSWORD={{GRAFANA_ADMIN_PASSWORD}}
FT_GRAFANA_ALLOW_SIGN_UP=false
FT_GRAFANA_ANALYTICS=false
# §MTLSHOPS T2 (2026-09-15): the kit's identity (its own cert-writer and volume) and Grafana's egress to Prometheus.
FT_KITCW_SERVICE_NAME={{REGISTRY_NAME}}-kit
FT_NGGE_RELOAD_SEC=300
FT_NGGE_SERVICE_NAME={{REGISTRY_NAME}}-grafana-egress
FT_AUDITOR_IMAGE={{AUDITOR_IMAGE}}
FT_AUDITOR_AUDITOR_SOLO=true
FT_AUDITOR_AUDITOR_EXTRA_FRAMES_FILE=/app/frames/frames.json
FT_AUDITOR_AUDIT_INTERVAL=60
FT_AUDITOR_AGENT_NAME=The Auditor of {{REGISTRY_NAME}}
FT_AUDITOR_AUDITOR_ADMIN_TOKEN={{AUDITOR_ADMIN_TOKEN}}
FT_AUDITOR_MAINTENANCE_ACTIVE=false
# §MTLSHOPS T2 (S4, 2026-09-15): the auditor's own SVID (its cert-writer) is the client certificate of its one store read,
# and nginx-auditor serves Prometheus's scrape lane on it
FT_AUDCW_SERVICE_NAME={{REGISTRY_NAME}}-auditor
FT_AUDITOR_TLS_CERT=/certs/svid.0.pem
FT_AUDITOR_TLS_KEY=/certs/svid.0.key
FT_AUDITOR_TLS_CA=/certs/bundle.0.pem
FT_NGAUD_RELOAD_SEC=300
FT_NGAUD_SERVICE_NAME={{REGISTRY_NAME}}-nginx-auditor
# the READ-ONLY database role the solo auditor logs in with (created by the standup driver in the frame's three DBs)
AUDITOR_RO_PASSWORD={{AUDITOR_RO_PASSWORD}}
# §MTLSHOPS T3 (2026-09-15): the data identity's cert-writer (its SVID serves the frame's Postgres and Redis)
FT_DATACW_SERVICE_NAME={{REGISTRY_NAME}}-data
# §MTLSHOPS T3: every Postgres client verifies the database's name against the data SVID and presents its own SVID. libpq
# and asyncpg both read these from the environment, so no engine, pool or connect carries an ssl argument (V0379 pins it).
FT_PGSSLMODE=verify-full
# the registry and the TEG: the private copy kit/data-tls/tls-client-sync.sh keeps (libpq refuses the cert-writer's 0644 key)
FT_PGTLS_COPY_ROOTCERT=/run/pgtls/client/bundle.0.pem
FT_PGTLS_COPY_CERT=/run/pgtls/client/svid.0.pem
FT_PGTLS_COPY_KEY=/run/pgtls/client/svid.0.key
# the store and the auditor: asyncpg only, which reads the SVID as the cert-writer writes it
FT_PGTLS_CERTS_ROOTCERT=/certs/bundle.0.pem
FT_PGTLS_CERTS_CERT=/certs/svid.0.pem
FT_PGTLS_CERTS_KEY=/certs/svid.0.key
FT_DIRECTORY_IMAGE={{DIRECTORY_IMAGE}}
# §HELLOFRAME (2026-09-18): the SVID writer six sidecars run; build.sh builds it in the export (nginx/Dockerfile.cert-writer)
FT_CERT_WRITER_IMAGE={{CERT_WRITER_IMAGE}}
FT_DIRCW_SERVICE_NAME=directory-{{REGISTRY_NAME}}
# the index's anchor is this frame (internal http; the crawl follows the federation table outward over public TLS)
FT_DIR_DIRECTORY_ANCHORS=http://{{REGISTRY_NAME}}-registry:8000
FT_DIR_DIRECTORY_SYNC_SECONDS=60
FT_DIR_DIRECTORY_MAX_HOPS=2
FT_DIR_DIRECTORY_FULL_EVERY=30
FT_DIR_DIRECTORY_HOPS_BY_REGISTRY={}
FT_DIR_DIRECTORY_DB=/data/directory.db
FT_DIR_DIRECTORY_CERT_DIR=/certs
# who may READ the index through its mTLS leg: this frame's registry, by SPIFFE ID
# The registry PROCESS reads the index with its Workload API SVID, whose id is /service/registry (its boot line says so;
# measured by agentvault2-85 on eu, asia, sandbox-a, sandbox-b). /service/<name>-registry is the cert-writer's identity
# in /certs, which never reads the index: a trusted-but-not-allowlisted id, the negative control of the S5 proof.
FT_DIR_DIRECTORY_READERS=spiffe://{{TRUST_DOMAIN}}/service/registry
# The proxy marker shared by the index and its nginx sidecar (X-Directory-Proxy-Auth); generated per frame, >= 32 chars.
FT_DIR_DIRECTORY_PROXY_TRUST_SECRET={{DIRECTORY_PROXY_TRUST_SECRET}}
# the registry package's config wants these at import; the Directory never opens a registry database
FT_DIR_DATABASE_URL=postgresql+asyncpg://directory:unused@localhost/unused
FT_DIR_API_KEY_SECRET={{DIRECTORY_IMPORT_SECRET}}
FT_NGDIR_RELOAD_SEC=300
FT_NGDIR_PROXY_TRUST_SECRET={{DIRECTORY_PROXY_TRUST_SECRET}}
FT_NGDIR_SERVICE_NAME={{REGISTRY_NAME}}-directory-nginx
FT_REG_COCKPIT_DESK_ENABLED=true
FT_REG_CONTRACTS_XFRAME_MODE=enforce
FT_REG_EQUITY_PEG_KEEPER_ENABLED=true
FT_REG_EVALS_ENABLED=true
FT_REG_EVALS_AGENT_TRIGGER_ENABLED=true
FT_REG_EXCHANGE_CROSSFRAME_VOTE_ENABLED=true
FT_REG_EXCHANGE_MAKER_REBATE_ENABLED=true
FT_REG_EXCHANGE_MARKET_CARD_ENABLED=true
FT_REG_EXCHANGE_SOLVENCY_CARD_ENABLED=true
FT_REG_FLARE_LOCAL_PURCHASE_ENABLED=true
FT_REG_FORENSIC_SCANNER_ENABLED=true
FT_REG_FORGE_ENABLED=true
FT_REG_FORGE_ROYALTY_ENABLED=true
FT_REG_FX_REMOTE_RECOVERY_MODE=on
# §FXSTRAND (2026-09-07) — THE ROUTE ENGINE IS OFF UNTIL ITS IDENTITY EXISTS.
# This said `true` while nothing in the template or the standup driver ever created the @fx_router
# agent the engine requires, so every frame stood up from here declared the capability ON and
# `_fx_route_hop_execute_inner` refused at its first check (FX_ROUTER_DID unset). No operator homed
# on such a frame could originate a cross-currency transfer — for months, invisibly, because the FX
# POOL is a DIFFERENT mechanism that shares the word and works fine: rates answer `available: true`,
# the sim's fx mode passes, the cards read "via FX". Nothing anywhere said the engine was dead.
# Standup step 11 in RUNBOOK §12 creates the router and flips these two together; the CI gate
# (.forgejo/checks/frame_template_contract.py R9) refuses a template that turns the flag on with no DID.
FT_REG_FX_ROUTE_ENABLED=false
FT_REG_FX_ROUTER_DID=
FT_REG_FX_ROUTER_KEEPER_ENABLED=true
FT_REG_GATEWAY_KEEPER_ENABLED=true
FT_REG_GATEWAY_RECON_ENABLED=true
FT_REG_GATEWAY_SUBDUST_SWEEP_ENABLED=true
FT_REG_GUILD_ORG_BID_MODE=enforce
FT_REG_GUILD_ZK_CREDENTIAL_ENABLED=true
FT_REG_REVOCATION_DRILL_ENABLED=true
FT_REG_STOCK_CARD_SYNC_ENABLED=true
FT_REG_ZKP_PHASE_1_ENABLED=true
FT_REG_ZKP_PHASE_2_ENABLED=true
FT_REG_ZKP_PHASE_3_ENABLED=true
FT_REG_ZKP_PHASE_4_ENABLED=true
FT_REG_ZKP_PHASE_5_ENABLED=true
FT_REG_ZKP_PHASE_6_ENABLED=true

# §FRAMEKIT P3.1 (2026-09-12) — WHERE THIS FRAME READS ITS OWN OBSERVABILITY. Two bare keys the
# registry gets through env_file. Unset, the status page has no history and the degradation panel
# says "not configured" (an honest state); set, they name the Prometheus a frame can reach by
# container name over its own network and the long-term store (or Prometheus again — both speak
# /api/v1/query). The standup driver writes them under --wire-prod from sidecars/sidecars.json
# (prometheus.query_url, metrics_store.url); nothing here guesses a host's names.
# ⚠ NEVER ship `PROMETHEUS_URL=` EMPTY: eight admin panels read os.getenv(k, default), and an empty
# value is SET, not absent — they would dial "" (contract rule R15). Leave the line commented or
# give it a value. The flagship measured 0 of 90 days on every status component before this
# (job: null, and the code default `prometheus:9090` resolved on nobody's network).
# §SOVKIT (2026-09-14): the frame's OWN Prometheus is where the status page reads its history (the driver's
# --wire-prod may add this host's long-term store as VICTORIA_METRICS_URL; it no longer overwrites this line).
# §MTLSHOPS T2: Prometheus serves TLS and requires a client certificate from the kit or the registry (V0378's clients).
PROMETHEUS_URL=https://{{REGISTRY_NAME}}-prometheus:9090
# VICTORIA_METRICS_URL=http://victoriametrics:8428
