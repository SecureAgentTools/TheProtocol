# =============================================================
# nginx mTLS Sidecar — Frame EventStore  (§MTLSGAP 2026-09-08)
# =============================================================
# TLS-terminating reverse proxy in front of this frame's EventStore. Presents the frame's SPIRE
# SVID as the server cert, VERIFIES the caller's client SVID, and forwards the cert headers so
# the ES's `verify_event_auth()` can authenticate Mode 1 (mTLS) instead of a shared key.
#
# WHY THIS FILE EXISTS AT ALL.
# His word 2026-09-08: *"everything is mtls enforced … not acceptable for sandbox, it should be a
# realistic env."* Measured, the sandbox was exactly as realistic as production: `nginx-teg` and
# `nginx-federation` run `ssl_verify_client on` on EU, ASIA, sbx-alpha and sbx-beta, and **not one
# of them had an ES gateway** — every registry reached its own ledger over plain
# `http://<frame>-event-store:8200`. The only ES gateway in the fleet was Frame A's, on the frame
# being retired, because THIS TEMPLATE never rendered one. That is also why the `mtls_handshake`
# check had been probing `nginx-event-store-test:8443` — a Frame A name — from frames that ship
# nothing of the kind, on every run of both drivers.
#
# ⚠ THIS STANDS UP ALONGSIDE PLAIN HTTP, NOT INSTEAD OF IT.
# `EVENT_STORE_URL` is every registry's write path to its own ledger, and §BATCH7's lesson is that
# a bundle snapshotted at boot is the trust set of that boot. Moving the writers is a separate,
# deliberate step, taken only after a handshake has been proven with a real peer SVID.
#
# ⚠ AND A GATEWAY NOTHING VERIFIES AGAINST IS WORSE THAN NONE — it looks like coverage. Two
# preconditions have to be true before this proxy authenticates anybody, and neither was:
#   1. the frame's SVID must carry `{{REGISTRY_NAME}}-nginx-event-store` as a DNS SAN, or a client
#      that verifies the hostname gets a name mismatch (the §XFRAMETEG lesson, one instance later);
#   2. the ES's `KNOWN_INTERNAL_SERVICES` must name the identities the frame's writers ACTUALLY
#      present. Measured on EU before this work, it named `registry-eu,teg-core-eu,teg-eu` — three
#      services that do not exist. The SPIRE entries are `/service/eu-registry`, `/service/registry`
#      and `/service/teg-layer`. Inert while nothing spoke mTLS to the ES; a total refusal the
#      moment something did.
# =============================================================

# Health check server (plain HTTP, no mTLS) — this is what compose healthchecks.
# Deliberately NOT the mTLS port: a healthcheck that needs a client cert reports the CERT's state,
# not the proxy's, and would mark a working sidecar unhealthy.
server {
    listen 127.0.0.1:8080;
    server_name _;

    location /health {
        return 200 '{"status":"healthy","service":"nginx-event-store-{{REGISTRY_NAME}}","mode":"mtls-sidecar"}\n';
        add_header Content-Type application/json;
    }
}

# Main server block — mTLS proxy for this frame's EventStore.
server {
    listen 8443 ssl;
    server_name {{REGISTRY_NAME}}-nginx-event-store;

    # --- Server certificate (SPIRE SVID, written by cert-writer) ---
    ssl_certificate       /certs/svid.0.pem;
    ssl_certificate_key   /certs/svid.0.key;

    # --- Client certificate verification (mTLS) ---
    # Local SPIRE CA + appended federated_bundle.*.pem (cross-frame). `on`, not
    # `optional_no_ca`: this proxies the LEDGER's append surface, so an unverified caller must be
    # refused at the handshake rather than reach a route.
    ssl_client_certificate /certs/bundle.0.pem;
    ssl_verify_client      on;
    ssl_verify_depth       2;

    ssl_protocols          TLSv1.3;
    ssl_ciphers            HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache      shared:SSL:1m;
    ssl_session_timeout    5m;

    location /api/v1/ {
        # §MTLSHOPS T2 (S4, 2026-09-15): the store's unix socket, shared with this terminator and the host edge alone. A
        # recreated store rebinds it, so the resolver line a DNS upstream needed is gone.
        proxy_pass http://unix:/sock/event-store/event-store.sock:;

        # §VITALS 2026-09-04 — THE REDIRECT THAT ATE THREE CALLERS. FastAPI's trailing-slash
        # redirect is built from `Host: $host` WITHOUT the port, so a caller that asked for
        # `/api/v1/events` (no slash) was sent to a port nothing listens on and every one of them
        # turned the ConnectError into an empty result. Both schemes, because whether the ES
        # honours X-Forwarded-Proto depends on its uvicorn flags (§BATCH4 item 7).
        proxy_redirect http://$host/  https://$host:8443/;
        proxy_redirect https://$host/ https://$host:8443/;

        # ProjectionSnapshot emits the full all-balances set as ONE POST body; the default 1MB cap
        # turns into a 413 once the frame grows. mTLS-authenticated, so not a DoS surface.
        client_max_body_size 50m;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Client cert forwarding for SPIFFE extraction in verify_event_auth().
        proxy_set_header X-SSL-Client-Cert   $ssl_client_escaped_cert;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-S-DN   $ssl_client_s_dn;
        # §SOVKIT T2: the store honours the three X-SSL-Client-* headers above ONLY beside this marker, and only its
        # own terminators know the value. `${ES_PROXY_TRUST_SECRET}` is substituted by envsubst at container start
        # (the compose entrypoint); an unsubstituted file fails nginx's config test loudly ("unknown variable").
        proxy_set_header X-ES-Proxy-Auth "${ES_PROXY_TRUST_SECRET}";

        # PIN THE IDENTITY HEADERS, and clear the two secret rails: on this hop mTLS is the
        # authority, so a caller must not be able to hand us either of the weaker credentials.
        # (Row 194's rule, applied to a new edge the first time rather than after the fact.)
        proxy_set_header X-Internal-Key      "";
        proxy_set_header X-Federation-Secret "";
        proxy_set_header X-Federation-License "";

        proxy_connect_timeout 30s;
        proxy_read_timeout    120s;
        proxy_send_timeout    30s;
    }

    # --- WebSocket event stream ---
    location /ws/ {
        proxy_pass http://unix:/sock/event-store/event-store.sock:;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_read_timeout 86400s;

        proxy_set_header X-SSL-Client-Cert   $ssl_client_escaped_cert;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-S-DN   $ssl_client_s_dn;
        # §SOVKIT T2: the store honours the three X-SSL-Client-* headers above ONLY beside this marker, and only its
        # own terminators know the value. `${ES_PROXY_TRUST_SECRET}` is substituted by envsubst at container start
        # (the compose entrypoint); an unsubstituted file fails nginx's config test loudly ("unknown variable").
        proxy_set_header X-ES-Proxy-Auth "${ES_PROXY_TRUST_SECRET}";
    }

    # Health over mTLS — proves the whole cert path, not merely that nginx is up.
    location /health {
        proxy_pass http://unix:/sock/event-store/event-store.sock:;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
    }

    # §MTLSHOPS T2 (S4, 2026-09-15): the kit's Prometheus scrapes the store here with the kit's certificate (the store's own
    # port is gone). GET only.
    location = /metrics {
        limit_except GET { deny all; }
        proxy_pass http://unix:/sock/event-store/event-store.sock:;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
    }

    location / {
        return 404 '{"error":"Use /api/v1/ or /ws/ endpoints"}\n';
        add_header Content-Type application/json;
    }
}
