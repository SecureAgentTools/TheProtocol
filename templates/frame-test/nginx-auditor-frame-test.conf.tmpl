# =============================================================
# nginx mTLS terminator: PROMETHEUS'S SCRAPE LANE TO THE AUDITOR  (§MTLSHOPS T2 S4 2026-09-15, rendered per frame)
# =============================================================
# The frame's Prometheus scrapes https://{{REGISTRY_NAME}}-nginx-auditor:8443/metrics with the kit's SVID and verifies this
# name (the auditor's SVID carries it). A caller must present a certificate the frame's bundle chains; nginx cannot read
# which identity a certificate names, so the internal network whose only other member is Prometheus keeps the frame's other
# identities out. Only /metrics is served here; the auditor's page and API are the host's door (nginx-edge).

# Health check server (plain HTTP, no mTLS), on the container's loopback only.
server {
    listen 127.0.0.1:8080;
    server_name _;

    location /health {
        return 200 '{"status":"healthy","service":"nginx-auditor","mode":"mtls-sidecar"}\n';
        add_header Content-Type application/json;
    }
}

server {
    listen 8443 ssl;
    server_name {{REGISTRY_NAME}}-nginx-auditor;

    ssl_certificate       /certs/svid.0.pem;
    ssl_certificate_key   /certs/svid.0.key;

    ssl_client_certificate /certs/bundle.0.pem;
    ssl_verify_client      on;
    ssl_verify_depth       2;

    ssl_protocols          TLSv1.3;
    ssl_ciphers            HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache      shared:SSL:1m;
    ssl_session_timeout    5m;

    location = /metrics {
        limit_except GET { deny all; }
        proxy_pass http://unix:/sock/auditor/auditor.sock:;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        return 403;
    }
}
