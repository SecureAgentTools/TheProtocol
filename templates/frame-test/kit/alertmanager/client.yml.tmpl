# §MTLSHOPS T2 (2026-09-15): the healthcheck's own client (amtool): the kit's certificate, verified against the frame's
# bundle under the name the server certificate carries. Measured on v0.26.0: rc 0 with the certificate, rc 1 when the
# certificate file is missing.
tls_config:
  ca_file: /certs/bundle.0.pem
  cert_file: /certs/svid.0.pem
  key_file: /certs/svid.0.key
  server_name: {{REGISTRY_NAME}}-alertmanager
