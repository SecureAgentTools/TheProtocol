agent {
    data_dir = "/opt/spire/data/agent"
    log_level = "INFO"
    server_address = "{{REGISTRY_NAME}}-spire-server"
    server_port = "8081"
    socket_path = "/opt/spire/sockets/agent.sock"
    trust_domain = "{{TRUST_DOMAIN}}"
    insecure_bootstrap = true
}

plugins {
    NodeAttestor "x509pop" {
        plugin_data {
            private_key_path = "/opt/spire/conf/x509pop-certs/agent-attestation.key"
            certificate_path = "/opt/spire/conf/x509pop-certs/agent-attestation.crt"
        }
    }

    KeyManager "disk" {
        plugin_data {
            directory = "/opt/spire/data/agent"
        }
    }

    WorkloadAttestor "unix" {
        plugin_data {}
    }

    WorkloadAttestor "docker" {
        plugin_data {
            docker_socket_path = "unix:///var/run/docker.sock"
        }
    }
}
