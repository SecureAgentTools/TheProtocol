# =============================================================
# nginx mTLS terminator: THE REGISTRY'S PUBLISH LANE TO NTFY  (§MTLSHOPS T2 S4 2026-09-15, rendered per frame)
# =============================================================
# The registry dials https://{{REGISTRY_NAME}}-nginx-ntfy:8443 with its SVID and verifies this name (the kit's SVID carries
# it). A caller must present a certificate the frame's bundle chains; nginx cannot read which identity a certificate names,
# so the internal network whose only other member is the registry is what keeps the frame's other identities out. ntfy
# listens on a unix socket it shares with this terminator and the host edge alone; the phones' door is the edge.

# Health check server (plain HTTP, no mTLS), on the container's loopback only.
server {
    listen 127.0.0.1:8080;
    server_name _;

    location /health {
        return 200 '{"status":"healthy","service":"nginx-ntfy","mode":"mtls-sidecar"}\n';
        add_header Content-Type application/json;
    }
}

server {
    listen 8443 ssl;
    server_name {{REGISTRY_NAME}}-nginx-ntfy;

    # --- Server certificate (the kit's SVID, with the DNS SAN {{REGISTRY_NAME}}-nginx-ntfy) ---
    ssl_certificate       /certs/svid.0.pem;
    ssl_certificate_key   /certs/svid.0.key;

    # --- Client certificate verification (mTLS): refused at the handshake without one the bundle chains ---
    ssl_client_certificate /certs/bundle.0.pem;
    ssl_verify_client      on;
    ssl_verify_depth       2;

    ssl_protocols          TLSv1.2 TLSv1.3;
    ssl_ciphers            HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache      shared:SSL:1m;
    ssl_session_timeout    5m;

    location / {
        proxy_pass http://unix:/sock/ntfy/ntfy.sock:;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 15s;
        proxy_read_timeout    60s;
        proxy_send_timeout    30s;
    }
}
