# =============================================================
# nginx mTLS Sidecar — THE FRAME'S OWN DIRECTORY  (§SOVKIT 2026-09-14, rendered per frame)
# =============================================================
# Derived from directory/nginx-directory.conf (§MTLSGAP): the read leg of the frame's OWN federated index.
# The registry dials https://{{REGISTRY_NAME}}-directory-nginx:8443 with its SVID; anything without a
# certificate the frame's bundle chains is refused at the handshake. The Directory itself is on the frame
# network only (never the identity network: the alias trap documented in the source file).
# Health check server (plain HTTP, no mTLS) — this is what compose healthchecks. Deliberately NOT
# the mTLS port: a healthcheck that needs a client cert reports the CERT's state, not the proxy's.
server {
    listen 127.0.0.1:8080;
    server_name _;

    location /health {
        return 200 '{"status":"healthy","service":"nginx-directory","mode":"mtls-sidecar"}\n';
        add_header Content-Type application/json;
    }
}

server {
    listen 8443 ssl;
    server_name {{REGISTRY_NAME}}-directory-nginx;

    # --- Server certificate (the Directory's own SPIRE SVID, written by its cert-writer) ---
    ssl_certificate       /certs/svid.0.pem;
    ssl_certificate_key   /certs/svid.0.key;

    # --- Client certificate verification (mTLS) ---
    # `on`, not `optional_no_ca`: this is the read leg, and an unverified caller must be refused
    # at the handshake rather than reach a query. The bundle carries EU's root plus the federated
    # ASIA root, so both frames' registries can read the index and nothing else can.
    ssl_client_certificate /certs/bundle.0.pem;
    ssl_verify_client      on;
    ssl_verify_depth       2;

    ssl_protocols          TLSv1.3;
    ssl_ciphers            HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache      shared:SSL:1m;
    ssl_session_timeout    5m;

    location / {
        # `resolver` is REQUIRED: without it nginx resolves the upstream once at config load and
        # caches the IP for ever, so any Directory recreate becomes a permanent 502. Every sibling
        # sidecar in this fleet carries the same note, each after learning it the hard way.
        # §MTLSHOPS T2 (S4, 2026-09-15): the index's unix socket, shared with this terminator alone. A recreated index
        # rebinds it and this proxy recovers within a second (measured), where a DNS upstream needed a resolver line.
        proxy_pass http://unix:/sock/directory/directory.sock:;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Client cert forwarding, so the Directory can log or later authorize by SPIFFE ID.
        proxy_set_header X-SSL-Client-Cert   $ssl_client_escaped_cert;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-S-DN   $ssl_client_s_dn;
        # The proxy marker: the index honours the three X-SSL-Client-* headers above ONLY beside this one, and
        # only this sidecar knows the value. `${DIRECTORY_PROXY_TRUST_SECRET}` is substituted by envsubst at
        # container start (see the compose entrypoint); an unsubstituted file fails nginx's config test loudly
        # ("unknown variable") instead of serving a marker nobody checks.
        proxy_set_header X-Directory-Proxy-Auth "${DIRECTORY_PROXY_TRUST_SECRET}";

        # mTLS is the authority on this hop: a caller must not be able to hand us a weaker one.
        proxy_set_header X-Internal-Key       "";
        proxy_set_header X-Federation-Secret  "";
        proxy_set_header X-Federation-License "";

        proxy_connect_timeout 15s;
        proxy_read_timeout    60s;
        proxy_send_timeout    30s;
    }
}
