# {{NAME}}-spire — the SPIRE bundle endpoint of frame {{NAME}} (§BATCH10, rendered)
server {
    listen 443 ssl http2;
    server_name {{NAME}}-spire.{{DOMAIN}};
    ssl_certificate     /etc/letsencrypt/live/{{NAME}}.{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{NAME}}.{{DOMAIN}}/privkey.pem;
    location / {
        proxy_pass https://127.0.0.1:{{PORT_SPIRE_BUNDLE}};
        proxy_ssl_verify off;
        proxy_set_header Host $host;
    }
}
