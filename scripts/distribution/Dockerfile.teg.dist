# Dockerfile.teg.dist — TheProtocol TEG Layer Distribution Image
# Multi-stage build; the application keeps its Python source (pre-compiled), since 2026-09-30.
# Produces a functionally identical image to the development Dockerfile,
# with the source pre-compiled into __pycache__.
#
# What stays as .py (required at runtime):
#   - alembic/env.py + alembic/versions/*.py  (alembic needs source to run migrations)
#
# What gets compiled to .pyc and source stripped:
#   - src/teg_core_service/**/*.py             (the entire TEG service)

# ============================================================
# Stage 1: Builder — install deps, compile bytecode
# ============================================================
FROM python:3.14-slim AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements file
COPY requirements.txt constraints.txt ./

# Install dependencies
# §DEPS (2026-09-27): every install resolves against the network image's own freeze (constraints.txt), pip, setuptools
# and wheel first, and pip check must be clean
RUN pip install --no-cache-dir -c constraints.txt --upgrade pip setuptools wheel
RUN pip install --no-cache-dir -c constraints.txt -r requirements.txt
# §OSSDRY 2026-09-13: the standalone/operator composes run the TEG under gunicorn's arbiter (`-c /app/gunicorn_conf.py`),
# exactly as production does (agentvault_teg_layer_mvp/Dockerfile) -- this image never installed it, so the README's
# quickstart TEG crash-looped on `gunicorn: not found`. Same pins as production: uvicorn stays 0.30.0.
RUN pip install --no-cache-dir -c constraints.txt gunicorn==26.2.0 uvicorn-worker==0.4.0
RUN pip check > /tmp/pipcheck.txt 2>&1; \
    if grep -vxF -e "No broken requirements found." /tmp/pipcheck.txt; then \
      echo "pip check reports a conflict (above)"; exit 1; fi; \
    rm -f /tmp/pipcheck.txt

# Copy application code
COPY . .

# ── Distribution: pre-compile the application, keep its source ───────
# Since 2026-09-30 the release images keep their Python source (REVIEW_2026-09-30_LICENSING.md): the code is
# AGPL-3.0-or-later and public. compileall writes __pycache__/*.pyc beside the sources.
RUN python -m compileall -q /app/src/

# ============================================================
# Stage 2: Runtime: minimal image with the pre-compiled source
# ============================================================
FROM python:3.14-slim AS runtime

# Install runtime-only system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 agentvault

WORKDIR /app

# Copy installed Python packages from builder
# §DEPS (2026-09-27): the builder's site-packages replace the base's own (one copy each of pip, setuptools and wheel)
RUN rm -rf /usr/local/lib/python3.14/site-packages
COPY --from=builder /usr/local/lib/python3.14/site-packages/ /usr/local/lib/python3.14/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Copy the compiled application (bytecode + alembic source)
COPY --from=builder /app/ /app/

# Change ownership to non-root user
RUN chown -R agentvault:agentvault /app

# Switch to non-root user
USER agentvault

# Add label for SPIRE workload attestation
LABEL com.agentvault.service="teg-core"
LABEL com.theprotocol.distribution="source"

# Expose the internal port
EXPOSE 8080

# Add health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=40s --retries=3 \
  CMD curl -f --max-time 25 http://localhost:8080/health || exit 1

# Default command — matches production entrypoint:
# The compose command override adds alembic upgrade heads before uvicorn.
# §LEDGERGATE (2026-10-12, contract R40): `exec`, so the server is PID 1 and a stop is graceful.
CMD ["sh", "-c", "cd /app && exec python -m uvicorn src.teg_core_service.main:app --host 0.0.0.0 --port 8080"]
