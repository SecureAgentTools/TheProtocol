        "x": 18,
        "y": 17,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "max(registry_treasury_low_active{frame=\"$frame\", scope=\"platform\"}) + 2 * (max(registry_treasury_low_threshold{frame=\"$frame\", scope=\"platform\"}) == bool 0)",
