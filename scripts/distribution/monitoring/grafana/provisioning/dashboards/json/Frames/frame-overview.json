          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{component=\"registry\"}, frame)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(up{component=\"registry\"}, frame)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
