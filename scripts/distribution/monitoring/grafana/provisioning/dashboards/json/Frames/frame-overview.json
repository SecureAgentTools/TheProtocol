              "type": "value",
              "options": {
                "0": {
                  "text": "ABOVE FLOOR",
                  "color": "green"
                },
                "1": {
                  "text": "BELOW FLOOR",
                  "color": "red"
                },
                "2": {
                  "text": "WATCH OFF",
                  "color": "text"
                }
              }
            }
