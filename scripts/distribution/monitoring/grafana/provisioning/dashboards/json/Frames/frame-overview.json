        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "max(up{frame=\"$frame\", component=\"registry\"})",
          "legendFormat": "Registry"
