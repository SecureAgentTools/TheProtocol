# =============================================================================
# TheProtocol: example environment file
# =============================================================================
# This is a REFERENCE showing the variables the stack reads. Do NOT fill it in
# by hand for a real deployment; instead generate a file with unique secrets:
#
#     ./scripts/distribution/generate-operator-env.sh my-registry-name
#
# That produces a `.env.operator` with cryptographically-random secrets and a
# matching pgbouncer.ini. Copy this file to `.env` only if you want to override
# individual values for local development.
#
# NEVER commit a filled-in env file. `.env` and `.env.*` are gitignored
# (this `.env.example` is the sole exception).
# =============================================================================

# --- Identity ----------------------------------------------------------------
REGISTRY_NAME=my-registry              # container-name prefix + display identity
OPERATOR_NAME=My Organization          # human-readable operator name
OPERATOR_DID=did:theprotocol:CHANGE_ME # issued/derived during onboarding
TRUST_DOMAIN=registry.example.com      # your DNS name: the registry signs its card with it and issues DIDs under it

# --- Images ------------------------------------------------------------------
# scripts/distribution/build.sh tags the images it builds <IMAGE_REGISTRY>/<name>:<VERSION>, and the
# standalone compose defaults to the same local names, so nothing is pulled.
VERSION=stable                         # image tag (build.sh also tags :stable)
IMAGE_REGISTRY=theprotocol             # image prefix; a local name unless you push to a registry of your own
REGISTRY_HTTP_PORT=8000                # host port for the registry's plain HTTP (standalone compose)

# --- Deployment mode ---------------------------------------------------------
# federated  → issuance disabled; units arrive by cross-registry transfer and grants
# standalone → your TEG can issue units; no federation or peer discovery
MINTING_AUTHORITY=disabled             # "disabled" (federated) | "teg-layer" (standalone)
FEDERATION_LICENSE_KEY=                # provided at onboarding (federated mode)

# --- Secrets (GENERATE these; never reuse the placeholders) ------------------
# Each should be a fresh random value, e.g. `openssl rand -hex 32`.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
API_KEY_SECRET=CHANGE_ME_openssl_rand_hex_32
TEG_ADMIN_API_KEY=CHANGE_ME_openssl_rand_hex_32
TEG_TOKEN_SIGNING_KEY=CHANGE_ME_openssl_rand_hex_32
TEG_REGISTRY_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
TEG_AVTP_SYSTEM_API_KEY=CHANGE_ME_openssl_rand_hex_32
EVENT_STORE_INTERNAL_API_KEY=CHANGE_ME_openssl_rand_hex_32
# Optional: sign the registry card private key at rest (recommended for launch)
REGISTRY_SIGNING_KEY_PASSPHRASE=

# --- Database passwords (GENERATE) -------------------------------------------
PG_PASS_REGISTRY=CHANGE_ME_random_48_hex
PG_PASS_TEG=CHANGE_ME_random_48_hex
PG_PASS_EVENT_STORE=CHANGE_ME_random_48_hex

# --- Units and fees ----------------------------------------------------------
# Transaction fees are set by the registry's frame policy document (`transaction_fees.*`, changed by a governance
# vote within the federation's bounds), not by environment variables.
GENESIS_GRANT_ENABLED=true
GENESIS_GRANT_AMOUNT=1000                # units granted to new agents (0–100000)
BETA_INVITE_REQUIRED=false
AUDITED_BALANCE_ENABLED=true
ENABLE_PROJECTION_SNAPSHOTS=false

# --- Email (required for developer verification) -----------------------------
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=My Registry
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- Event streaming (standalone; leave defaults if unsure) ------------------
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# --- Monitoring (optional) ---------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION=30d
# --- The frame kit (§SOVKIT): OPA shadow beside the registry, the solo auditor's admin token ----------------
OPA_ENABLED=true
OPA_ENFORCE=false
AUDITOR_ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32
AUDIT_INTERVAL=60
