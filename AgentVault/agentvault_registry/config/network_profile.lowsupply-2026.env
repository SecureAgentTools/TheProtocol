# network profile: lowsupply-2026   (rendered 2026-09-05)
# 
# S0    = 1000000   initial mint per frame   (decision D1)
# GRANT = 1000   genesis grant per person (decision D2)
# 
# Every amount below is a FRACTION of those two numbers, computed by
# scripts/render_network_profile.py from scripts/network_profile_knobs.py.
# Change S0 or GRANT and re-render; never hand-edit an amount.

# ==================== REGISTRY ====================
# master switch; the amount is inert while this is false (§COLDSTART2)
#   read at: routers/onboarding.py:905   code default: true
#   posture — set deliberately below
# GENESIS_GRANT_ENABLED=

# R7: frames 1000, operators 5000 (cloud_provisioner.py:387) — one number now
#   read at: config.py:307 · routers/onboarding.py:267,913   code default: 1000.0
#   = GRANT
GENESIS_GRANT_AMOUNT=1000

# R14 · NEW: below the floor a grant is deferred, not failed. 0 = disabled = today
#   read at: routers/onboarding.py::mint_genesis_grant   code default: 0
#   = S0 * 20 / 100
GENESIS_GRANT_TREASURY_FLOOR=200000

# R43 · NEW: admins are told ONCE when the treasury crosses below this (hysteresis in redis) and once on recovery; ABOVE the 20 % genesis floor so the warning precedes deferred grants. 0 = disabled = today
#   read at: background_tasks/treasury_low_watch.py::_threshold   code default: 0
#   = S0 * 25 / 100
TREASURY_LOW_NOTIFY_THRESHOLD=250000

# ==================== PROVISIONER ====================
# R8: four operators at the literal 100k is 4x a small supply
#   read at: routers/cloud_operators.py:308 · routers/operator_self_service.py:627   code default: 100000
#   = S0 * 5 / 100
OPERATOR_PROVISION_FUNDING_AVT=50000

# ==================== REGISTRY ====================
# R11: 5 on frame-c only; presence step-up must scale with what money means
#   read at: config.py:382 · services/liability.py:550 · routers/organizations.py:408   code default: 0.0
#   = GRANT * 5 / 100
LIABILITY_PRESENCE_THRESHOLD_AVT=50

# R12: was a hardcoded Decimal("100000") — a petition could dwarf every grant
#   read at: routers/funding_requests.py:213   code default: 100000
#   = GRANT * 10 / 100
FUNDING_REQUEST_MAX_AVT=100

# R12: seven hardcoded request ceilings; a cap above the supply is no cap
#   read at: routers/teg_integration.py:1185,1215,1358,1378,4186,7910,7931   code default: 10000000
#   = S0 * 10 / 100
TEG_TRANSFER_MAX_AVT=100000

# R12: the mint ceiling; never above the intended supply
#   read at: routers/teg_integration.py:7961   code default: 100000000
#   = S0
TEG_MINT_MAX_AVT=1000000

# R12: carried a literal '# TODO: Move to config' since it was written
#   read at: routers/staking_enhanced.py:156   code default: 10.0
#   = GRANT * 1 / 100
STAKING_MIN_STAKE_AMOUNT=10

# R12: JSON tier->price; empty = the source catalog. Rescale with the profile
#   read at: routers/flare_shop.py:97   code default: (empty)
#   posture — set deliberately below
# FLARE_SHOP_PRICES=

# R12: a listing must be affordable to a person holding one grant
#   read at: services/exchange_service.py:102   code default: 1000
#   = GRANT * 1 / 100
EXCHANGE_LISTING_FEE=10

# R12
#   read at: services/exchange_service.py:104   code default: 1000000
#   = S0 * 5 / 100
EXCHANGE_MAX_NOTIONAL=50000

# R12: the sweep threshold for gateway credits. Anchored to the GRANT, not S0: "too small to be worth a transfer" is a judgement about what a PERSON holds. At S0/1000000 it came to 1 unit, i.e. 0.1% of a whole grant swept as dust
#   read at: services/exchange_service.py:280   code default: 0.5
#   = GRANT / 100000
EXCHANGE_REPAT_DUST=0.01

# R13: below this a canary sender is refilled
#   read at: background_tasks/canary_rebalancer.py:100   code default: 5000
#   = S0 / 1000
CANARY_REBALANCER_FLOOR_AVT=1000

# R13: the refill target — 1,000,000 is the whole of a small supply
#   read at: background_tasks/canary_rebalancer.py:101   code default: 1000000
#   = S0 * 2 / 1000
CANARY_REBALANCER_TOPUP_AVT=2000

# R13: the column default a new canary agent is created with
#   read at: models.py:4726 (canary_agents.prefund_amount default)   code default: 100000
#   = S0 / 1000
CANARY_PREFUND_AMOUNT=1000

# R27: how much drift the guard heals without a human. Anchored to the GRANT: at S0/100000 it healed 10 units unattended, 1% of a person's entire balance
#   read at: background_tasks/balance_reconciliation_guard.py:131,259   code default: 10.0
#   = GRANT / 1000
BALANCE_RECONCILE_AUTO_APPROVE_MAX=1

# ==================== TEG ====================
# R27: the circuit breaker on the escrow-lock reconciler
#   read at: core/escrow_lock_reconciler.py:66   code default: 100000
#   = S0 / 1000
ESCROW_RECONCILER_MAX_RELEASE_PER_AGENT=1000

# ==================== REGISTRY ====================
# R29
#   read at: services/showcase_visitor.py:119   code default: 5000.0
#   = S0 / 10000
SHOWCASE_VISITOR_FLOAT=100

# R29 (his 2026-08-26 instruction: per-tx == float)
#   read at: services/showcase_visitor.py:134   code default: 5000.0
#   = S0 / 10000
SHOWCASE_VISITOR_MAX_PER_TX=100

# R29
#   read at: services/showcase_visitor.py:135   code default: 10000.0
#   = S0 * 2 / 10000
SHOWCASE_VISITOR_MAX_PER_DAY=200

# D3 — absent entirely if the fresh net runs one currency
#   read at: routers/teg_integration.py:727   code default: 0
#   = S0 * 2 / 100
FX_RESERVE_FLOOR_AVT=20000

# D4: the only Sybil control that costs nothing new
#   read at: routers/auth_secure.py:78,256   code default: false
#   posture — set deliberately below
# BETA_INVITE_REQUIRED=

# R38: frame-c says trader,client,staker; everyone else takes the source default
#   read at: routers/onboarding.py (birth roles)   code default: trader,client
#   posture — set deliberately below
# AGENT_RBAC_DEFAULT_ROLES=

# R6/D7: 50 on the mainframes, unset on every operator
#   read at: background_tasks/gateway_float_keeper.py:167   code default: 0
#   posture — set deliberately below
# GATEWAY_REARM_ABANDONED_BATCH=

# R16: the snapshot re-bases transit_net. Runbook says NEVER; the profile leaves it unset. MEASURED 2026-09-04: =true on registry-a AND all 5 frame-a operators
#   read at: routers/admin_health.py:3321 · mcp/tools_admin.py:808   code default: (empty)
#   posture — set deliberately below
# ENABLE_PROJECTION_SNAPSHOTS=

# R9: stays off until he says otherwise
#   read at: routers/fiat_onramp.py   code default: false
#   posture — set deliberately below
# FIAT_ONRAMP_ENABLED=

# ==================== TEG ====================
# the only mint path is the registry proxy on a mainframe (§MINTSECRET)
#   read at: TEG endpoints_admin (mint gate)   code default: true
#   posture — set deliberately below
# TEG_MINT_REQUIRE_PROXY=

# R34: unset on the operator TEGs ⇒ /docs served and the production validator never runs
#   read at: TEG core/config.py + secure_config.validate_production_config()   code default: development
#   posture — set deliberately below
# ENVIRONMENT=

# ==================== REGISTRY ====================
# the bond a provider holds in treasury escrow; a quarter of the grant leaves liquidity for staking and fees
#   read at: services/reputation_bond.py::bond_amount   code default: 50
#   = GRANT * 25 / 100
REPUTATION_BOND_AMOUNT=250

# off | shadow | enforce. Current fleet: shadow (counts, refuses nothing). Fresh frame + sandbox: enforce
#   read at: services/reputation_bond.py::bond_mode   code default: off
#   posture — set deliberately below
# REPUTATION_BOND_MODE=
# ENFORCEMENT_PROPAGATION_MODE=

# the DEMONSTRATION path: the treasury underwrites a bond the flow could not fund. On for the fresh frame while the grant exists
#   read at: services/reputation_bond.py::treasury_backstop_enabled   code default: false
#   posture — set deliberately below
# REPUTATION_BOND_TREASURY_BACKSTOP=

# maturity: satisfactory interactions either way. Recommended 5 on the fresh frame (federation floor 5)
#   read at: services/reputation_bond.py::maturity_thresholds   code default: 10
#   posture — set deliberately below
# REPUTATION_BOND_MIN_TRANSACTIONS=

# maturity: days since lock. Recommended 14 on the fresh frame (federation floor 7)
#   read at: services/reputation_bond.py::maturity_thresholds   code default: 30
#   posture — set deliberately below
# REPUTATION_BOND_MIN_AGE_DAYS=

# a matured bond pays back after this many days; a treasury-backstopped bond pays nobody
#   read at: services/reputation_bond.py::release_cooldown_days   code default: 7
#   posture — set deliberately below
# REPUTATION_BOND_RELEASE_COOLDOWN_DAYS=

# cache = today's cache-only write (R21) | shadow = plan + log | enforce = the policy's slash_waterfall MOVES money (bond → stake → liquid). Fresh frame: enforce; current fleet: shadow (HARD STOP 4)
#   read at: services/reputation_bond.py::slash_mode · services/enforcement_engine.py::_slash_waterfall   code default: cache
#   posture — set deliberately below
# ENFORCEMENT_SLASH_MODE=

