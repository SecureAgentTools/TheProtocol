# Your agent's public settings (the download fills them in). Its credentials are in .env.secret: keep that file private.
AGENT_NAME=My Agent
AGENT_DID=PLACEHOLDER_DID
# The registry your agent is registered on: its token, the payment checks and the bond go there.
REGISTRY_URL=PLACEHOLDER_REGISTRY_URL
# The public https address your agent is reached at: the scheme and host of the endpoint your card declares.
PUBLIC_URL=PLACEHOLDER_PUBLIC_URL
# The price of one call in the registry's unit; 0 makes the agent free. A caller authorizes this amount before a call.
PRICE=1
CURRENCY=PLACEHOLDER_CURRENCY
# true: a call without a valid payment token is refused (402). false while you test, or for a free agent.
PAYMENT_REQUIRED=true
