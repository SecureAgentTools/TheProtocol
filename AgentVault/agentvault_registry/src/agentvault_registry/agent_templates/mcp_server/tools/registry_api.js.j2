/**
 * registry_api.js — Full agent-auth Registry API surface
 * {{ agent_name }} | Generated by TheProtocol OnboardingWizard
 *
 * Covers ALL agent-JWT endpoints:
 *   TEG: balance, transfer, cross-registry transfer, transactions
 *   Locks: lock, unlock, positions
 *   Governance: list, create, vote, my-vote, tally
 *   Disputes: file dispute
 *   Enforcement: my-status, reputation-bond deposit/status
 *   Contracts: list, create, accept, submit, complete
 *   Reputation: signal
 */
'use strict';

const { get, post } = require('../lib/http_client');
const config = require('../lib/config');

const tools = [

  // ── TEG ────────────────────────────────────────────────────────────────────

  {
    name: 'get_balance',
    description: "Get this agent's current balance in its registry's unit: liquid, locked (the staked field) and total.",
    inputSchema: { type: 'object', properties: {} },
    async handler() {
      const [teg, positions] = await Promise.all([
        get('/api/v1/teg/balance'),
        get('/api/v1/staking/my-positions').catch(() => []),
      ]);
      const liquid = teg.liquid_balance ?? teg.balance ?? '0';
      const staked = positions
        .filter(p => p.status === 'active')
        .reduce((sum, p) => sum + parseFloat(p.amount || '0'), 0)
        .toFixed(2);
      const total = (parseFloat(liquid) + parseFloat(staked)).toFixed(2);
      return { liquid, staked, total, agent_did: config.agentDid };
    },
  },

  {
    name: 'transfer_tokens',
    description: 'Transfer AVT tokens to another agent on this registry.',
    inputSchema: {
      type: 'object',
      properties: {
        receiver_agent_id: { type: 'string', description: 'Recipient agent DID' },
        amount: { type: 'string', description: 'Amount as string e.g. "100"' },
        message: { type: 'string', description: 'Optional memo (max 256 chars)' },
      },
      required: ['receiver_agent_id', 'amount'],
    },
    async handler({ receiver_agent_id, amount, message }) {
      return await post('/api/v1/teg/transfer', {
        receiver_agent_id,
        amount: String(amount),
        ...(message ? { message } : {}),
      });
    },
  },

  {
    name: 'cross_registry_transfer',
    description: 'Transfer AVT tokens to an agent on a federated registry (cross-registry 2PC).',
    inputSchema: {
      type: 'object',
      properties: {
        receiver_did: { type: 'string', description: 'Full DID of recipient on the remote registry' },
        amount: { type: 'string', description: 'Amount as string e.g. "100"' },
        message: { type: 'string', description: 'Optional memo' },
      },
      required: ['receiver_did', 'amount'],
    },
    async handler({ receiver_did, amount, message }) {
      return await post('/api/v1/teg/cross-registry-transfer', {
        receiver_did,
        amount: String(amount),
        ...(message ? { message } : {}),
      });
    },
  },

  {
    name: 'view_transaction_history',
    description: "View this agent's TEG transaction history.",
    inputSchema: {
      type: 'object',
      properties: {
        limit: { type: 'integer', description: 'Number of transactions (default 20)', default: 20 },
        type: { type: 'string', description: 'Filter by type (optional)' },
      },
    },
    async handler({ limit = 20, type }) {
      let path = `/api/v1/teg/transactions?limit=${limit}`;
      if (type) path += `&type=${type}`;
      return await get(path);
    },
  },

  // ── LOCKS ────────────────────────────────────────────────────────────────

  {
    name: 'stake_tokens',
    description: 'Lock units for a lock period, where this registry opens locks; a lock carries voting weight where votes count by locks.',
    inputSchema: {
      type: 'object',
      properties: {
        amount: { type: 'string', description: 'Amount to lock as string e.g. "1000"' },
        lock_period_days: { type: 'integer', description: 'Lock period in days (default 30)', default: 30 },
      },
      required: ['amount'],
    },
    async handler({ amount, lock_period_days = 30 }) {
      return await post('/api/v1/staking/stake', { amount: String(amount), lock_period_days });
    },
  },

  {
    name: 'unstake_tokens',
    description: "Release a lock position once its lock period has ended.",
    inputSchema: {
      type: 'object',
      properties: {
        position_id: { type: 'string', description: 'Lock position ID to release' },
      },
      required: ['position_id'],
    },
    async handler({ position_id }) {
      return await post('/api/v1/staking/unstake', { position_id });
    },
  },

  {
    name: 'get_staking_positions',
    description: "List this agent's current lock positions.",
    inputSchema: { type: 'object', properties: {} },
    async handler() {
      return await get('/api/v1/staking/my-positions');
    },
  },

  // ── GOVERNANCE ─────────────────────────────────────────────────────────────

  {
    name: 'get_governance_proposals',
    description: 'Browse Agent Senate governance proposals.',
    inputSchema: {
      type: 'object',
      properties: {
        status: { type: 'string', description: 'VOTING | PASSED | FAILED | all', default: 'VOTING' },
      },
    },
    async handler({ status = 'VOTING' }) {
      const qs = status !== 'all' ? `?status=${status}` : '';
      return await get(`/api/v1/governance/proposals${qs}`);
    },
  },

  {
    name: 'create_governance_proposal',
    description: 'Create a new Agent Senate governance proposal; the voting rules of this registry decide who may.',
    inputSchema: {
      type: 'object',
      properties: {
        title: { type: 'string' },
        description: { type: 'string' },
        duration_seconds: { type: 'integer', description: 'Voting duration in seconds (default 604800 = 7 days)', default: 604800 },
        type: { type: 'string', description: 'standard | policy_change', default: 'standard' },
      },
      required: ['title', 'description'],
    },
    async handler({ title, description, duration_seconds = 604800, type = 'standard' }) {
      return await post('/api/v1/governance/proposals', { title, description, duration_seconds, type });
    },
  },

  {
    name: 'cast_vote',
    description: 'Cast a vote on a governance proposal.',
    inputSchema: {
      type: 'object',
      properties: {
        proposal_id: { type: 'integer' },
        vote_in_favor: { type: 'boolean', description: 'true = for, false = against' },
      },
      required: ['proposal_id', 'vote_in_favor'],
    },
    async handler({ proposal_id, vote_in_favor }) {
      return await post(`/api/v1/governance/proposals/${proposal_id}/vote`, { vote_in_favor });
    },
  },

  {
    name: 'get_my_vote',
    description: 'Check how this agent voted on a specific proposal.',
    inputSchema: {
      type: 'object',
      properties: {
        proposal_id: { type: 'integer' },
      },
      required: ['proposal_id'],
    },
    async handler({ proposal_id }) {
      return await get(`/api/v1/governance/proposals/${proposal_id}/my-vote`);
    },
  },

  {
    name: 'tally_proposal',
    description: 'Tally votes on a proposal. Only callable by the proposal creator after voting ends.',
    inputSchema: {
      type: 'object',
      properties: {
        proposal_id: { type: 'integer' },
      },
      required: ['proposal_id'],
    },
    async handler({ proposal_id }) {
      return await post(`/api/v1/governance/proposals/${proposal_id}/tally`, {});
    },
  },

  // ── DISPUTES ───────────────────────────────────────────────────────────────

  {
    name: 'file_dispute',
    description: 'File a dispute against another agent. The authenticated agent becomes the claimant.',
    inputSchema: {
      type: 'object',
      properties: {
        defendant_agent_did: { type: 'string', description: 'DID of the agent being disputed' },
        category: { type: 'string', description: 'e.g. "service_failure", "payment_dispute"' },
        description: { type: 'string', description: 'Full description of the dispute' },
      },
      required: ['defendant_agent_did', 'category', 'description'],
    },
    async handler({ defendant_agent_did, category, description }) {
      return await post('/api/v1/disputes/', { defendant_agent_did, category, description });
    },
  },

  // ── ENFORCEMENT ────────────────────────────────────────────────────────────

  {
    name: 'get_enforcement_status',
    description: "Get this agent's own enforcement state (violations, bonds, restrictions).",
    inputSchema: { type: 'object', properties: {} },
    async handler() {
      return await get('/api/v1/enforcement/my-status');
    },
  },

  {
    name: 'deposit_reputation_bond',
    description: 'Lock 50 AVT as a reputation bond. Matures after 30 days, boosts trust score.',
    inputSchema: { type: 'object', properties: {} },
    async handler() {
      return await post('/api/v1/agents/reputation-bond/deposit', {});
    },
  },

  {
    name: 'get_reputation_bond_status',
    description: "Check this agent's reputation bond maturity progress.",
    inputSchema: { type: 'object', properties: {} },
    async handler() {
      return await get('/api/v1/agents/reputation-bond/status');
    },
  },

  // ── CONTRACTS (RUC) ────────────────────────────────────────────────────────

  {
    name: 'list_contracts',
    description: "List contracts this agent is involved in (client or upgrader).",
    inputSchema: {
      type: 'object',
      properties: {
        role: { type: 'string', description: 'client | upgrader | all', default: 'all' },
        status: { type: 'string', description: 'Filter by status (optional)' },
      },
    },
    async handler({ role = 'all', status }) {
      let path = '/api/v1/contracts/';
      const params = [];
      if (role !== 'all') params.push(`role=${role}`);
      if (status) params.push(`status=${status}`);
      if (params.length) path += '?' + params.join('&');
      return await get(path);
    },
  },

  {
    name: 'create_contract',
    description: 'Create a new Refactoring & Upgrade Contract (RUC) as client agent.',
    inputSchema: {
      type: 'object',
      properties: {
        client_agent_did: { type: 'string' },
        scope_description: { type: 'string' },
        source_code_repo_url: { type: 'string' },
        source_code_branch: { type: 'string' },
        acceptance_criteria: { type: 'object' },
        payment_amount: { type: 'integer', minimum: 1 },
      },
      required: ['client_agent_did', 'scope_description', 'source_code_repo_url', 'source_code_branch', 'acceptance_criteria', 'payment_amount'],
    },
    async handler(args) {
      return await post('/api/v1/contracts/', args);
    },
  },

  {
    name: 'accept_contract',
    description: 'Accept an open contract as the upgrader agent.',
    inputSchema: {
      type: 'object',
      properties: {
        contract_id: { type: 'integer' },
        upgrader_agent_did: { type: 'string' },
      },
      required: ['contract_id', 'upgrader_agent_did'],
    },
    async handler({ contract_id, upgrader_agent_did }) {
      return await post(`/api/v1/contracts/${contract_id}/accept`, { upgrader_agent_did });
    },
  },

  {
    name: 'submit_contract_work',
    description: 'Submit completed work for a contract with a PR URL (upgrader only).',
    inputSchema: {
      type: 'object',
      properties: {
        contract_id: { type: 'integer' },
        pr_url: { type: 'string' },
      },
      required: ['contract_id', 'pr_url'],
    },
    async handler({ contract_id, pr_url }) {
      return await post(`/api/v1/contracts/${contract_id}/submit`, { pr_url });
    },
  },

  {
    name: 'complete_contract',
    description: 'Mark contract complete and release payment to upgrader (client only).',
    inputSchema: {
      type: 'object',
      properties: {
        contract_id: { type: 'integer' },
      },
      required: ['contract_id'],
    },
    async handler({ contract_id }) {
      return await post(`/api/v1/contracts/${contract_id}/complete`, {});
    },
  },

  // ── REPUTATION ─────────────────────────────────────────────────────────────

  {
    name: 'submit_reputation_signal',
    description: 'Signal +1 (satisfied) or -1 (dissatisfied) for a completed transaction.',
    inputSchema: {
      type: 'object',
      properties: {
        transaction_id: { type: 'string', description: 'TEG transaction ID to rate' },
        signal: { type: 'integer', description: '+1 or -1', enum: [1, -1] },
        comment: { type: 'string', description: 'Optional comment (max 500 chars)' },
      },
      required: ['transaction_id', 'signal'],
    },
    async handler({ transaction_id, signal, comment }) {
      return await post(`/api/v1/token/${transaction_id}/reputation-signal`, {
        signal,
        ...(comment ? { comment } : {}),
      });
    },
  },

];

module.exports = tools;
