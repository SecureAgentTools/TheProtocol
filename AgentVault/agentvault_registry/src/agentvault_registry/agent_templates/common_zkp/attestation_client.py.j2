"""
ZKP Attestation Client, pre-wired for {{ agent_name }}
Generated by TheProtocol OnboardingWizard | template: {{ template_id }}

Proves a policy statement about this agent's own figures with nargo and bb,
inside this container, and submits only the proof and its public inputs to
the Registry (POST /api/v1/attestations/submit) with this agent's JWT.

Circuits (v2.0.0). Each proof binds the policy limit and a reference publicly,
and binds the private figure to the commitment the circuit outputs:
  fairMarkupPolicy/v2.0.0             public: max_markup_bps, offered_price, context
                                      private: total_cost, salt        -> cost_commitment
  accurateResourceUsagePolicy/v2.0.0  public: max_discrepancy_bps, transaction_ref, reported_units
                                      private: logged_units, salt      -> log_commitment
  fairCrossRegistryFee/v2.0.0         public: max_fee_bps, window_ref, total_volume, total_fees
                                      private: amounts[16], fees[16], salt -> batch_commitment
  contentSafetyAttestation/v2.0.0     public: min_rejection_bps, window_ref, total_samples
                                      private: sample_hashes[64], rejected[64], salt -> log_commitment

The reference (context, transaction_ref or window_ref) names this agent: the
Registry requires it to be derive_reference(<this agent's DID>, <label>), the
first 31 bytes of SHA-256 over "tp.attestation.ref.v1|", the DID, "|" and the
label, and reads the label from public_inputs["reference_label"]. A proof made
for one agent is not verified when another agent submits it. The label is your
offer, transaction or window id as given (1 to 200 characters), or a random
"sdk-<16 hex>" when you name none. The Registry keeps one verified attestation
per circuit and reference, and answers 409 to the same proof again.

A proof does not show that the private figure is true. The commitment lets an
auditor ask this agent to open it (the figure and the salt): keep the
`opening` each call hands back. Every proof gets a fresh random salt.

The agent DID is AGENT_DID from the environment, or the DID this bundle was
generated for.

Circuits are read from CIRCUIT_CACHE_DIR/<name>_<version> (the bundle ships
them in circuits/), or downloaded from the Registry when absent. bb reads its
reference string from $HOME/.bb-crs and downloads what it is missing on the
first proof (it needs bn254_g1.dat, bn254_g2.dat and grumpkin_g1.dat; an
agent without network access can copy them from the Registry source's
agentvault_circuit_registry/crs, with grumpkin_size, into $HOME/.bb-crs). When
nargo or bb is not installed, submit_attestation logs a warning and reports
status "skipped" instead of proving.
"""
import base64
import hashlib
import json
import logging
import os
import re
import secrets
import shutil
import subprocess
import tempfile
from pathlib import Path
from typing import Any, Dict, List, Optional

import httpx

logger = logging.getLogger(__name__)

REGISTRY_URL = os.getenv("REGISTRY_URL", "{{ registry_url }}")
AGENT_DID = os.getenv("AGENT_DID", "{{ agent_did }}")
CIRCUIT_CACHE_DIR = Path(os.getenv("CIRCUIT_CACHE_DIR", "/app/circuits"))

# Order of the BN254 scalar field: every public value is an element of it.
BN254_R = 21888242871839275222246405745257275088548364400416034343698204186575808495617

CIRCUITS: Dict[str, Dict[str, Any]] = {
    "fairMarkupPolicy/v2.0.0": {
        "package": "fair_markup",
        "public": ["max_markup_bps", "offered_price", "context"],
        "private": ["total_cost", "salt"],
        "reference": "context",
        "output": "cost_commitment",
    },
    "accurateResourceUsagePolicy/v2.0.0": {
        "package": "accurate_resource_usage",
        "public": ["max_discrepancy_bps", "transaction_ref", "reported_units"],
        "private": ["logged_units", "salt"],
        "reference": "transaction_ref",
        "output": "log_commitment",
    },
    "fairCrossRegistryFee/v2.0.0": {
        "package": "fair_cross_registry_fee",
        "public": ["max_fee_bps", "window_ref", "total_volume", "total_fees"],
        "private": ["amounts", "fees", "salt"],
        "reference": "window_ref",
        "output": "batch_commitment",
    },
    "contentSafetyAttestation/v2.0.0": {
        "package": "content_safety_attestation",
        "public": ["min_rejection_bps", "window_ref", "total_samples"],
        "private": ["sample_hashes", "rejected", "salt"],
        "reference": "window_ref",
        "output": "log_commitment",
    },
}

_KEY = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
_NUMBER = re.compile(r"(0[xX][0-9a-fA-F]+|[0-9]+)")


# The Registry's rule (core/zkp_verifier.derive_reference); the two must agree
# byte for byte, or every proof this client makes is refused.
REFERENCE_DOMAIN = b"tp.attestation.ref.v1|"
MAX_REFERENCE_LABEL = 200


def derive_reference(agent_did: str, label: str) -> int:
    """The reference a v2 proof carries: the first 31 bytes of
    SHA-256("tp.attestation.ref.v1|" + agent DID + "|" + label), big-endian."""
    digest = hashlib.sha256(REFERENCE_DOMAIN + agent_did.encode() + b"|" + label.encode()).digest()
    return int.from_bytes(digest[:31], "big")


def label_for(value: Any) -> str:
    """The label for a proof: your id as given (an int in decimal), or a random "sdk-<16 hex>"."""
    if value is None:
        return f"sdk-{secrets.token_hex(8)}"
    if isinstance(value, bool) or not isinstance(value, (int, str)):
        raise ValueError("a reference label is a string (or an int, written in decimal)")
    label = str(value)
    if not 0 < len(label) <= MAX_REFERENCE_LABEL:
        raise ValueError(f"a reference label is 1 to {MAX_REFERENCE_LABEL} characters")
    return label


def to_field(value: Any) -> int:
    """A number (int, decimal or 0x string) as a field element; anything else is refused."""
    if isinstance(value, bool):
        raise ValueError("a boolean is not a field value")
    if isinstance(value, int):
        number = value
    else:
        text = str(value).strip()
        if not _NUMBER.fullmatch(text):
            raise ValueError(f"not a decimal or 0x number: {value!r}")
        number = int(text, 0) if text.lower().startswith("0x") else int(text)
    if number < 0 or number >= BN254_R:
        raise ValueError("value is outside the BN254 scalar field")
    return number


def _toml_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        if value < 0:
            raise ValueError("circuit inputs are unsigned")
        return '"' + str(value) + '"'
    if isinstance(value, str) and _NUMBER.fullmatch(value):
        return '"' + value + '"'
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(_toml_value(v) for v in value) + "]"
    raise ValueError(f"cannot write {value!r} into Prover.toml")


def render_prover_toml(inputs: Dict[str, Any]) -> str:
    """Prover.toml for nargo: quoted numbers, true/false, arrays; anything else is refused."""
    lines = ["# Written by ZKPAttestationClient for one proof"]
    for key, value in inputs.items():
        if not _KEY.fullmatch(key):
            raise ValueError(f"not a circuit input name: {key!r}")
        lines.append(f"{key} = {_toml_value(value)}")
    return "\n".join(lines) + "\n"


def read_public_values(proof: bytes, names: List[str]) -> Dict[str, int]:
    """The public values a bb 0.82.2 proof carries: a 4-byte field count, then the public inputs, then the commitment."""
    n_fields = int.from_bytes(proof[:4], "big") if len(proof) >= 4 else 0
    if len(proof) != 4 + 32 * n_fields or n_fields <= len(names):
        raise RuntimeError("proof bytes do not have the bb proof layout")
    return {name: int.from_bytes(proof[4 + 32 * i: 36 + 32 * i], "big") for i, name in enumerate(names)}


class ZKPAttestationClient:
    """
    Proves and submits policy attestations for this agent.
    Requires nargo + bb in PATH (see the Dockerfile note).
    """

    def __init__(self, agent_jwt: str, agent_did: str = AGENT_DID):
        if not isinstance(agent_did, str) or not agent_did.startswith("did:"):
            raise ValueError("agent_did is required (this agent's DID): every proof's reference names it")
        self.agent_jwt = agent_jwt
        self.agent_did = agent_did
        self.registry_url = REGISTRY_URL.rstrip("/")

    @staticmethod
    def zkp_available() -> bool:
        return shutil.which("nargo") is not None and shutil.which("bb") is not None

    @staticmethod
    def _spec(circuit_id: str) -> Dict[str, Any]:
        spec = CIRCUITS.get(circuit_id)
        if spec is None:
            raise ValueError(f"Unknown circuit '{circuit_id}'. Known: {list(CIRCUITS)}")
        return spec

    def _circuit_dir(self, circuit_id: str) -> Path:
        """The circuit's directory with Nargo.toml, src/main.nr and its bytecode (circuit.json, or
        <package>.bin); downloaded from the Registry when absent."""
        spec = self._spec(circuit_id)
        cdir = CIRCUIT_CACHE_DIR / circuit_id.replace("/", "_")
        bytecode = cdir / f"{spec['package']}.bin"
        if (cdir / "Nargo.toml").is_file() and (cdir / "src" / "main.nr").is_file():
            if bytecode.is_file() or (cdir / "circuit.json").is_file():
                return cdir
        logger.info(f"[ZKP] downloading {circuit_id} from {self.registry_url}")
        base = f"{self.registry_url}/api/v1/circuits/{circuit_id}"
        files = {}
        with httpx.Client(timeout=30.0) as client:
            for part in ("source", "nargo-toml", "acir"):
                res = client.get(f"{base}/{part}")
                res.raise_for_status()
                files[part] = res.content
        (cdir / "src").mkdir(parents=True, exist_ok=True)
        (cdir / "src" / "main.nr").write_bytes(files["source"])
        (cdir / "Nargo.toml").write_bytes(files["nargo-toml"])
        bytecode.write_bytes(files["acir"])
        return cdir

    def _run_cmd(self, cmd: list, cwd: Path, label: str) -> str:
        """Run subprocess command, return stdout, raise on failure."""
        logger.info(f"[ZKP] {label}")
        result = subprocess.run(cmd, capture_output=True, text=True, cwd=str(cwd), timeout=300)
        if result.returncode != 0:
            raise RuntimeError(f"{label} failed:\nSTDOUT: {result.stdout[-2000:]}\nSTDERR: {result.stderr[-2000:]}")
        return result.stdout

    def generate_proof(self, circuit_id: str, public_inputs: Dict, private_inputs: Dict,
                       reference_label: Any = None) -> Dict[str, Any]:
        """
        Prove one statement for this agent, in a fresh temporary directory.

        The reference is derive_reference(self.agent_did, reference_label);
        leave it out of public_inputs. reference_label (or
        public_inputs["reference_label"]) is your offer, transaction or window
        id as given, random when None. A missing salt is a random value.
        Gives back: circuit_id, proof_data ({"proof_bytes": base64, "format":
        "ultra_honk"}, as the Registry takes it), public_inputs (as strings,
        reference_label included), commitment ({name: 0x value}, read from the
        proof), reference, reference_label, and opening (the private figure(s)
        and the salt: keep it private).
        """
        spec = self._spec(circuit_id)
        public = dict(public_inputs)
        private = dict(private_inputs)
        if "reference_label" in public:
            stated_label = public.pop("reference_label")
            if reference_label is not None and str(reference_label) != str(stated_label):
                raise ValueError("reference_label is given twice, with two values")
            reference_label = stated_label
        label = label_for(reference_label)
        derived = derive_reference(self.agent_did, label)
        if spec["reference"] in public:
            try:
                stated = to_field(public[spec["reference"]])
            except ValueError:
                stated = None
            if stated != derived:
                raise ValueError(
                    f"{spec['reference']} is derive_reference(agent DID, reference_label): pass the offer, "
                    "transaction or window id as reference_label instead of a reference"
                )
        public[spec["reference"]] = str(derived)
        private.setdefault("salt", hex(secrets.randbits(248)))
        missing = [k for k in spec["public"] if k not in public] + [k for k in spec["private"] if k not in private]
        if missing:
            raise ValueError(f"missing input(s) for {circuit_id}: {missing}")
        unknown = (set(public) - set(spec["public"])) | (set(private) - set(spec["private"]))
        if unknown:
            raise ValueError(f"unknown input(s) for {circuit_id}: {sorted(unknown)}")
        ordered = {k: public[k] for k in spec["public"]}
        ordered.update({k: private[k] for k in spec["private"]})

        cdir = self._circuit_dir(circuit_id)
        with tempfile.TemporaryDirectory(prefix="zkp_proof_") as work_dir:
            work = Path(work_dir)
            (work / "src").mkdir()
            shutil.copy(cdir / "Nargo.toml", work / "Nargo.toml")
            shutil.copy(cdir / "src" / "main.nr", work / "src" / "main.nr")
            (work / "Prover.toml").write_text(render_prover_toml(ordered))
            bytecode = work / f"{spec['package']}.bin"
            if (cdir / bytecode.name).is_file():
                shutil.copy(cdir / bytecode.name, bytecode)
            else:
                artifact = json.loads((cdir / "circuit.json").read_text())
                bytecode.write_bytes(base64.b64decode(artifact["bytecode"]))

            # Step 1: nargo execute (fails when the inputs do not satisfy the circuit)
            self._run_cmd(["nargo", "execute", "witness"], work, "nargo execute")
            witness = work / "target" / "witness.gz"

            # Step 2: bb prove
            out_dir = work / "target" / "proof_out"
            out_dir.mkdir()
            self._run_cmd(
                ["bb", "prove", "-s", "ultra_honk", "-b", str(bytecode),
                 "-w", str(witness), "-o", str(out_dir)],
                work, "bb prove",
            )
            proof_bytes = (out_dir / "proof").read_bytes()

        carried = read_public_values(proof_bytes, spec["public"] + [spec["output"]])
        for key in spec["public"]:
            if carried[key] != to_field(public[key]):
                raise RuntimeError(f"the proof carries a different {key} than the one given")
        logger.info(f"[ZKP] Proof generated for {circuit_id}: {len(proof_bytes)} bytes")
        stated_inputs = {k: str(public[k]) for k in spec["public"]}
        stated_inputs["reference_label"] = label
        return {
            "circuit_id": circuit_id,
            "proof_data": {"proof_bytes": base64.b64encode(proof_bytes).decode("ascii"), "format": "ultra_honk"},
            "public_inputs": stated_inputs,
            "commitment": {spec["output"]: "0x" + format(carried[spec["output"]], "064x")},
            "reference": {spec["reference"]: str(public[spec["reference"]])},
            "reference_label": label,
            "opening": {k: private[k] for k in spec["private"]},
        }

    async def submit_attestation(
        self,
        circuit_id: str,
        public_inputs: Dict,
        private_inputs: Dict,
        metadata: Optional[Dict] = None,
        reference_label: Any = None,
    ) -> Dict[str, Any]:
        """
        Prove for this agent and submit to Registry /api/v1/attestations/submit.

        reference_label as in generate_proof. Gives back the Registry's answer
        (status "verified" or "failed", with its reason) plus commitment,
        reference, reference_label and opening from generate_proof.
        `metadata` is kept for compatibility; the Registry does not store it.
        Raises httpx.HTTPStatusError on a non-2xx answer (409: this proof, or
        one with the same circuit and reference, was already attested; 422: no
        reference_label).
        """
        if not self.zkp_available():
            logger.warning("[ZKP] nargo or bb is not installed; attestation skipped")
            return {"status": "skipped", "circuit_id": circuit_id, "reason": "nargo or bb is not installed"}

        proof = self.generate_proof(circuit_id, public_inputs, private_inputs, reference_label=reference_label)
        payload = {
            "circuit_id": circuit_id,
            "proof_data": proof["proof_data"],
            "public_inputs": proof["public_inputs"],
        }

        async with httpx.AsyncClient(timeout=30.0) as client:
            res = await client.post(
                f"{self.registry_url}/api/v1/attestations/submit",
                json=payload,
                headers={"Authorization": f"Bearer {self.agent_jwt}"},
            )
            res.raise_for_status()
            result = res.json()
        if result.get("status") != "verified":
            logger.warning(f"[ZKP] Attestation not verified: {result.get('reason') or result.get('message')}")
        else:
            logger.info(f"[ZKP] Attestation verified: {result.get('attestation_id', 'unknown')}")
        result.update(
            commitment=proof["commitment"],
            reference=proof["reference"],
            reference_label=proof["reference_label"],
            opening=proof["opening"],
        )
        return result

    async def attest_fair_markup(self, total_cost: int, offered_price: int, max_markup_bps: int,
                                 context: Any = None) -> Dict[str, Any]:
        """fairMarkupPolicy/v2.0.0: offered_price * 10000 <= total_cost * (10000 + max_markup_bps).
        context is the offer id, the reference_label as given; random when None."""
        public = {"max_markup_bps": max_markup_bps, "offered_price": offered_price}
        return await self.submit_attestation(
            "fairMarkupPolicy/v2.0.0", public, {"total_cost": total_cost}, reference_label=context,
        )

    async def attest_resource_usage(self, reported_units: int, logged_units: int, max_discrepancy_bps: int,
                                    transaction_ref: Any = None) -> Dict[str, Any]:
        """accurateResourceUsagePolicy/v2.0.0: |reported - logged| * 10000 <= logged * max_discrepancy_bps.
        transaction_ref is the transaction id, the reference_label as given; random when None."""
        public = {"max_discrepancy_bps": max_discrepancy_bps, "reported_units": reported_units}
        return await self.submit_attestation(
            "accurateResourceUsagePolicy/v2.0.0", public, {"logged_units": logged_units},
            reference_label=transaction_ref,
        )


def _main() -> int:
    """Prove and submit one attestation from a JSON request on stdin; print the
    JSON result on stdout. The MCP tool (mcp/tools/attestation.js) calls this
    through `docker exec -i`, so inputs never pass through a shell or a
    command line. Request: {"agent_jwt", "circuit_id", "public_inputs",
    "private_inputs"}, optionally "agent_did" (else AGENT_DID) and
    "reference_label" (else random)."""
    import asyncio
    import sys

    try:
        request = json.load(sys.stdin)
        client = ZKPAttestationClient(request["agent_jwt"], request.get("agent_did") or AGENT_DID)
        result = asyncio.run(client.submit_attestation(
            request["circuit_id"],
            request.get("public_inputs") or {},
            request.get("private_inputs") or {},
            reference_label=request.get("reference_label"),
        ))
    except httpx.HTTPStatusError as exc:
        result = {"success": False, "status_code": exc.response.status_code, "error": exc.response.text[:500]}
    except Exception as exc:  # reported to the caller, never a traceback on stdout
        result = {"success": False, "error": str(exc)}
    json.dump(result, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(_main())
