import os
import json
import logging
from pathlib import Path
from fastapi import FastAPI
from fastapi.responses import JSONResponse

logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')
logger = logging.getLogger(__name__)

app = FastAPI(title="{{ agent_name }}", version="1.0.0")

DATA_DIR = Path(os.getenv("AGENT_DATA_DIR", "/app/data"))
DATA_DIR.mkdir(parents=True, exist_ok=True)


@app.get("/health")
def health():
    return {"status": "ok", "agent": "{{ human_readable_id }}", "did": "{{ agent_did }}"}


@app.get("/agent-card.json")
def agent_card():
    card_path = Path(__file__).parent.parent.parent / "agent-card.json"
    if card_path.exists():
        return JSONResponse(json.loads(card_path.read_text()))
    return {"did": "{{ agent_did }}", "name": "{{ agent_name }}"}


@app.get("/metrics")
def metrics():
    listings = _load_json("listings.json")
    orders = _load_json("orders.json")
    return {
        "listing_count": len(listings.get("listings", listings) if isinstance(listings, dict) else listings),
        "order_count": len(orders.get("orders", orders) if isinstance(orders, dict) else orders),
    }


def _load_json(filename: str) -> dict:
    f = DATA_DIR / filename
    if not f.exists():
        return {}
    try:
        return json.loads(f.read_text())
    except Exception:
        return {}
