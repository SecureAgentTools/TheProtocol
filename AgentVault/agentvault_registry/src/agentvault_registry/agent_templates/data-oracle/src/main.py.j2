"""
import os
import json
import logging
from pathlib import Path
from fastapi import FastAPI
from fastapi.responses import JSONResponse

logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')
app = FastAPI(title="{{ agent_name }}", version="1.0.0")
DATA_DIR = Path(os.getenv("AGENT_DATA_DIR", "/app/data"))
DATA_DIR.mkdir(parents=True, exist_ok=True)


@app.get("/health")
def health():
    return {"status": "ok", "agent": "{{ human_readable_id }}", "did": "{{ agent_did }}"}


@app.get("/agent-card.json")
def agent_card():
    card_path = Path(__file__).parent.parent.parent / "agent-card.json"
    if card_path.exists():
        return JSONResponse(json.loads(card_path.read_text()))
    return {"did": "{{ agent_did }}", "name": "{{ agent_name }}"}


@app.get("/feed/latest")
def feed_latest():
    """Public endpoint for feed consumers to pull latest data."""
    events_file = DATA_DIR / "events.json"
    if not events_file.exists():
        return {"events": [], "message": "No events yet"}
    data = json.loads(events_file.read_text())
    events = data.get("events", data) if isinstance(data, dict) else data
    return {"events": events[-100:], "count": len(events)}


@app.get("/metrics")
def metrics():
    events_file = DATA_DIR / "events.json"
    count = 0
    if events_file.exists():
        try:
            data = json.loads(events_file.read_text())
            events = data.get("events", data) if isinstance(data, dict) else data
            count = len(events)
        except Exception:
            pass
    return {"event_count": count}
