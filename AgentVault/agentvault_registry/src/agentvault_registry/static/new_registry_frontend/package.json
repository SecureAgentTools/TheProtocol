{
  "name": "sovereign-registry-frontend",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build && node scripts/gen_third_party_notices.mjs",
    "build-quick": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test -c playwright.suite.config.ts",
    "typecheck:e2e": "tsc -p e2e/suite/tsconfig.json",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "typecheck:ratchet": "node scripts/tsc-ratchet.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@lucide/vue": "^1.48.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.20.0",
    "cesium": "^1.145.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "jwt-decode": "^4.0.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^12.0.0",
    "minisearch": "^7.2.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
