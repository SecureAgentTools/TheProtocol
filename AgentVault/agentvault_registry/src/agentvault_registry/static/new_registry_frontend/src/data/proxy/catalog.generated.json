   {
    "class": "theprotocol.proxy.sources.sqlpoll:SqlPollSource",
    "config_schema": {
     "additionalProperties": false,
     "properties": {
      "batch_size": {
       "default": 500,
       "description": "How many rows one query reads.",
       "maximum": 100000,
       "minimum": 1,
       "type": "integer"
      },
      "columns": {
       "description": "The columns a record carries (default: all of them).",
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array",
       "uniqueItems": true
      },
      "connect_args": {
       "description": "More of the driver's connect arguments (TLS and the like). A value may be a reference, and one whose key names a password, a passphrase or a secret must be. The login itself goes in user and password.",
       "type": "object"
      },
      "cursor": {
       "description": "The column the rows are read in the order of (leave it out, and name a key, to read a table once in the order of its key: a migration). Its values must only grow as rows are written: the database's own sequence, or a time the writer sets as it writes (now()); a date a person types in is not a cursor (a row dated behind the place is never read). Index it with the key, in that order: each poll asks for the rows after a place in that order.",
       "type": "string"
      },
      "cursor_type": {
       "default": "id",
       "description": "id: an integer that only grows (an identity, a sequence). timestamp: a time set as the row is written (a date or a time column), carried as the database's own text for it.",
       "enum": [
        "id",
        "timestamp"
       ]
      },
      "database": {
       "description": "The database to read (all but sqlite).",
       "type": "string"
      },
      "engine": {
       "description": "postgresql, mysql or sqlserver; sqlite reads a database file.",
       "enum": [
        "postgresql",
        "mysql",
        "sqlserver",
        "sqlite"
       ]
      },
      "from_start": {
       "default": true,
       "description": "With no place kept yet: read the rows already there (default), or only the rows that arrive next.",
       "type": "boolean"
      },
      "host": {
       "description": "The database server (all but sqlite).",
       "type": "string"
      },
      "key": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array",
         "uniqueItems": true
        }
       ],
       "description": "The column (or columns) that tell apart rows with the same cursor value and name a record: unique as the database compares it (a case-insensitive column counts A and a as one). Default: the cursor itself (an id is unique). A timestamp cursor needs one."
      },
      "password": {
       "description": "The login's password: a reference (env:NAME or file:/path).",
       "type": "string",
       "x-secret": true
      },
      "path": {
       "description": "sqlite: the database file's name, taken as written (not a reference, not a file: URI), opened read only; a relative one is read from the proxy's working directory.",
       "type": "string"
      },
      "poll_seconds": {
       "default": 10,
       "description": "How long to wait before reading again once every row is read. 0: read once and finish (for tp-proxy run --once).",
       "minimum": 0,
       "type": "number"
      },
      "port": {
       "description": "Its port (default: 5432, 3306 or 1433).",
       "maximum": 65535,
       "minimum": 1,
       "type": "integer"
      },
      "settle_seconds": {
       "default": 5,
       "description": "Each poll reads only up to the highest cursor value it saw this long before, so a transaction that took a lower id or an earlier time and commits later is still read. Longer than the legacy system's longest writing transaction. 0 reads at once and accepts that risk.",
       "minimum": 0,
       "type": "number"
      },
      "table": {
       "description": "The table or view, with its schema if it needs one (sales.order_events).",
       "type": "string"
      },
      "timeout_seconds": {
       "default": 30,
       "description": "How long connecting, and each query, may take.",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "user": {
       "description": "A login that may only SELECT the table or view.",
