      "keepalive_s": {
       "default": 60,
       "maximum": 65535,
       "minimum": 5,
       "type": "integer"
      },
      "password": {
       "type": "string",
       "x-secret": true
      },
      "port": {
       "description": "Default 8883 with tls, 1883 without.",
       "maximum": 65535,
       "minimum": 1,
       "type": "integer"
      },
      "protocol": {
       "default": "3.1.1",
