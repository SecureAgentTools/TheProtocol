           }
          },
          "required": [
           "filter"
          ],
          "type": "object"
         }
        ]
       },
       "minItems": 1,
       "type": "array"
      },
      "username": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "host",
      "client_id",
      "topics"
     ],
     "type": "object"
    },
    "description": "Messages an MQTT broker delivers (MQTT 3.1.1 or 5, TLS with client certificates, QoS 0 and 1), acknowledged once in the outbox and resumed by the broker's persistent session",
    "internal": false,
