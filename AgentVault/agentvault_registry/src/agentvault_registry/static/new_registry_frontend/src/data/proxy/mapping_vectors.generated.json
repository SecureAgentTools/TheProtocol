    }
   },
   "expect": {
    "f": "ada lovelace"
   }
  },
  {
   "name": "case title",
   "covers": [
    "op:case:title"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "ada lovelace"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "case": "title"
    }
   },
   "expect": {
    "f": "Ada Lovelace"
   }
  },
  {
   "name": "title casing is Python's str.title: a new word after every character that is not a letter",
   "covers": [
    "op:case:title",
    "title-is-pythons"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "it's an O'NEIL-smith 3rd"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "case": "title"
    }
   },
   "expect": {
    "f": "It'S An O'Neil-Smith 3Rd"
   }
  },
  {
   "name": "case needs text",
   "covers": [
    "op:case:upper"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 5
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "case": "upper"
    }
   },
   "refusal": "f: case needs text"
  },
  {
   "name": "regex with no group takes the whole match",
   "covers": [
    "op:regex"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "tel: +49 30 1234"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "regex": "\\+[0-9 ]+"
    }
   },
   "expect": {
    "f": "+49 30 1234"
   }
  },
  {
   "name": "regex takes group 1 by default when the pattern has a group",
   "covers": [
    "op:regex"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "id=A-17;"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "regex": "id=(\\w+-\\d+);"
    }
   },
   "expect": {
    "f": "A-17"
   }
  },
  {
   "name": "regex group 0 is the whole match",
   "covers": [
    "op:regex",
    "op:regex:group"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "id=A-17;"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "regex": "id=(\\w+-\\d+);",
     "group": 0
    }
   },
   "expect": {
    "f": "id=A-17;"
   }
  },
  {
   "name": "regex group by number and by name",
   "covers": [
    "op:regex",
    "op:regex:group"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "2024-05-06"
    }
   },
   "fields": {
    "y": {
     "path": "$.payload.a",
     "regex": "(\\d+)-(\\d+)-(\\d+)",
     "group": 1
    },
    "m": {
     "path": "$.payload.a",
     "regex": "(\\d+)-(?P<month>\\d+)-(\\d+)",
     "group": "month"
    },
    "d": {
     "path": "$.payload.a",
     "regex": "(\\d+)-(\\d+)-(\\d+)",
     "group": 3
    }
   },
   "expect": {
    "y": "2024",
    "m": "05",
    "d": "06"
   }
  },
  {
   "name": "regex searches anywhere in the text",
   "covers": [
    "op:regex"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "xxabc123yy"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "regex": "\\d+"
    }
   },
   "expect": {
    "f": "123"
   }
  },
  {
   "name": "regex reads a number as its text",
