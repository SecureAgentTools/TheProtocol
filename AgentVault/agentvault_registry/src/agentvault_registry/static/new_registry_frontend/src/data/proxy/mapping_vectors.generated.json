   "covers": [
    "op:map"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "s": "X"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.s",
     "map": {
      "A": "active"
     }
    }
