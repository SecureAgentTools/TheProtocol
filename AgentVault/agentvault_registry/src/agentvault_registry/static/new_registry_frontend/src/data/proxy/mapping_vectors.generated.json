{
 "schema": "theprotocol.proxy.mapping-vectors/v1",
 "note": "Written by hand from mapping.py's documented behaviour; read by the SDK's tests and, copied into the console, by the TypeScript port's tests.",
 "cases": [
  {
   "name": "a path into the payload",
   "covers": [
    "path:payload"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "x"
    }
   },
   "fields": {
    "f": "$.payload.a"
   },
   "expect": {
    "f": "x"
   }
  },
  {
   "name": "a nested path and a list index",
   "covers": [
    "path:payload",
    "path:list-index"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": {
      "b": [
       10,
       20,
       {
        "c": "deep"
       }
      ]
     }
    }
   },
   "fields": {
    "x": "$.payload.a.b.1",
    "y": "$.payload.a.b.2.c"
   },
   "expect": {
    "x": 20,
    "y": "deep"
   }
  },
  {
   "name": "the record's own id, source and meta",
   "covers": [
    "path:record_id",
    "path:source",
    "path:meta"
   ],
   "record": {
    "record_id": "row-7",
    "source": "legacy",
    "meta": {
     "batch": 3
    },
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "id": "$.record_id",
    "src": "$.source",
    "m": "$.meta.batch"
   },
   "expect": {
    "id": "row-7",
    "src": "legacy",
    "m": 3
   }
  },
  {
   "name": "observed_at is the record's time as text",
   "covers": [
    "path:observed_at"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    },
    "observed_at": "2026-11-14T10:00:00+00:00"
   },
   "fields": {
    "t": "$.observed_at"
   },
   "expect": {
    "t": "2026-11-14T10:00:00+00:00"
   }
  },
  {
   "name": "a constant is a constant",
   "covers": [
    "constant"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "k": "HAM-CTA",
    "n": 5,
    "b": true,
    "z": null
   },
   "expect": {
    "k": "HAM-CTA",
    "n": 5,
    "b": true,
    "z": null
   }
  },
  {
   "name": "a nested object is mapped inside",
   "covers": [
    "nested:object"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "first": "Ada",
     "n": "7"
    }
   },
   "fields": {
    "customer": {
     "name": "$.payload.first",
     "age": {
      "path": "$.payload.n",
      "as": "int"
     }
    }
   },
   "expect": {
    "customer": {
     "name": "Ada",
     "age": 7
    }
   }
  },
  {
   "name": "a list is mapped inside",
   "covers": [
    "nested:list"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": " x ",
     "b": "2"
    }
   },
   "fields": {
    "lines": [
     {
      "path": "$.payload.a",
      "trim": true
     },
     {
      "path": "$.payload.b",
      "as": "int"
     },
     "k"
    ]
   },
   "expect": {
    "lines": [
     "x",
     2,
     "k"
    ]
   }
  },
  {
   "name": "a dict with a key that is no value key is a plain object, its paths still read",
   "covers": [
    "plain-dict-is-not-a-node"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "A"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "extra": 1
    }
   },
   "expect": {
    "f": {
     "path": "A",
     "extra": 1
    }
   }
  },
  {
   "name": "a missing path refuses the record naming the path and the field",
   "covers": [
    "path:missing"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "f": "$.payload.nope"
   },
   "refusal": "the record has no $.payload.nope (the mapping's field f)"
  },
  {
   "name": "a missing path inside a nested object names the dotted field",
   "covers": [
    "path:missing",
    "nested:object"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "o": {
     "p": "$.payload.nope"
    }
   },
   "refusal": "the record has no $.payload.nope (the mapping's field o.p)"
  },
  {
   "name": "a missing path in a list names the index",
   "covers": [
    "path:missing",
    "nested:list"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "l": [
     "$.payload.a",
     "$.payload.nope"
    ]
   },
   "refusal": "the record has no $.payload.nope (the mapping's field l[1])"
  },
  {
   "name": "a missing path in a value node refuses the same way",
   "covers": [
    "path:missing"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.nope",
     "trim": true
    }
   },
   "refusal": "the record has no $.payload.nope (the mapping's field f)"
  },
  {
   "name": "default is used when the path is missing",
   "covers": [
    "op:default"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.nope",
     "default": "x"
    }
   },
   "expect": {
    "f": "x"
   }
  },
  {
   "name": "default null is a null",
   "covers": [
    "op:default"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.nope",
     "default": null
    }
   },
   "expect": {
    "f": null
   }
  },
  {
   "name": "default is not applied to a present value",
   "covers": [
    "op:default"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "here"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "default": "x"
    }
   },
   "expect": {
    "f": "here"
   }
  },
  {
   "name": "required false makes a missing path a null",
   "covers": [
    "op:required_false"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.nope",
     "required": false
    }
   },
   "expect": {
    "f": null
   }
  },
  {
   "name": "required false changes nothing for a present value",
   "covers": [
    "op:required_false"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "v"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "required": false
    }
   },
   "expect": {
    "f": "v"
   }
  },
  {
   "name": "default skips the steps: it is the value",
   "covers": [
    "op:default",
    "order:null-stays-null"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 1
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.nope",
     "default": "x",
     "case": "upper",
     "as": "int"
    }
   },
   "expect": {
    "f": "x"
   }
  },
  {
   "name": "null_if one value",
   "covers": [
    "op:null_if"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "-"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "null_if": "-"
    }
   },
   "expect": {
    "f": null
   }
  },
  {
   "name": "null_if a list, a miss stays",
   "covers": [
    "op:null_if"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "N/A",
     "b": "ok"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "null_if": [
      "",
      "N/A"
     ]
    },
    "g": {
     "path": "$.payload.b",
     "null_if": [
      "",
      "N/A"
     ]
    }
   },
   "expect": {
    "f": null,
    "g": "ok"
   }
  },
  {
   "name": "null_if keeps false apart from the number 0",
   "covers": [
    "op:null_if",
    "bool-is-not-a-number"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": false,
     "b": 0
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "null_if": [
      0
     ]
    },
    "g": {
     "path": "$.payload.b",
     "null_if": [
      0
     ]
    },
    "h": {
     "path": "$.payload.a",
     "null_if": [
      false
     ]
    }
   },
   "expect": {
    "f": false,
    "g": null,
    "h": null
   }
  },
  {
   "name": "trim strips both ends of text",
   "covers": [
    "op:trim"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": "  \t x y \n"
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "trim": true
    }
   },
   "expect": {
    "f": "x y"
   }
  },
  {
   "name": "trim leaves a number alone",
   "covers": [
    "op:trim"
   ],
   "record": {
    "record_id": "r1",
    "source": "legacy",
    "meta": {},
    "payload": {
     "a": 5
    }
   },
   "fields": {
    "f": {
     "path": "$.payload.a",
     "trim": true
    }
   },
   "expect": {
    "f": 5
   }
  },
  {
