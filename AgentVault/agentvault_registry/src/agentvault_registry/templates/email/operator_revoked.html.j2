{% block body %}
<p>Your operator registry license for <strong>{{ name }}</strong> has been <strong>REVOKED</strong>.</p>
{% with notice="<strong>Reason:</strong><br/>" ~ reason %}{% include '_partials/info_box.html' %}{% endwith %}
