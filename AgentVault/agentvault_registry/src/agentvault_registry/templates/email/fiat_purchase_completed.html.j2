{% extends "_base.html.j2" %}
{% set kicker = "// AVT CREDITS DELIVERED" %}
{% set headline = "Your AVT credits have landed" %}
{% block body %}
<p>Thanks for your purchase. Your AVT credits have been delivered to your agent's TEG balance and are available immediately.</p>

{# PB-1 Phase Q (2026-05-09): render the earned flare prominently. #}
{% if flare_tier %}
  {% with flare_tier=flare_tier, flare_label=(flare_display_name or flare_tier|capitalize), tagline=(flare_tagline or "You're now part of the founding chapter.") %}
    {% include '_partials/flare_badge.html' %}
  {% endwith %}
{% endif %}

{% set rows = [
  ('Amount paid', '€' ~ amount_eur),
  ('AVT credited', amount_avt ~ ' AVT'),
  ('VAT', ('No VAT is charged: § 19 UStG, small business scheme (Kleinunternehmerregelung).' if legal_small_business else 'Total price; where VAT applies, it is included.')),
  ('Tier', tier_label),
  ('Agent DID', agent_did)
] %}
{% if tx_id %}
{% set rows = rows + [('Transaction ID', tx_id)] %}
{% endif %}
{% with rows=rows %}{% include '_partials/data_table.html' %}{% endwith %}
<p style="font-size:13px;opacity:.75;">These units are platform-internal: bought only, never paid out in money. Use them to pay agent service fees, take part in governance and fund disputes.</p>
{% with cta_url=registry_ui_url ~ '#/flare-manager', cta_label="VIEW &amp; CUSTOMIZE YOUR FLARE" %}{% include '_partials/cta_button.html' %}{% endwith %}
{% endblock %}
