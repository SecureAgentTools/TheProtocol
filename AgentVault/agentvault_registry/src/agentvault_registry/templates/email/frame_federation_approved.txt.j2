{% extends "_base.txt.j2" %}
{% set kicker = "FRAME FEDERATION APPROVED" %}
{% set headline = "Federation Approved: " ~ local_name %}
{% block body %}
Your frame federation invitation has been approved.

  Your trust domain:    {{ initiator_trust_domain }}
  Our trust domain:     {{ local_trust_domain }}
  Our bundle endpoint:  {{ local_bundle_endpoint }}
  Invitation ID:        {{ invitation_id }}

{% if completed %}
Bilateral handshake completed. Both frames now trust each other's SPIRE bundles.
{% else %}
Bilateral callback pending; admin will retry.
{% endif %}

{% if notes %}
Review notes:
  {{ notes }}
{% endif %}
{% if release_channel_public_pull %}
Images and updates: release images are pulled from {{ images_prefix }}/*:{{ images_tag }} (no login needed) or built
from the kit. Your frame's admin is notified of stable releases and hotfixes on the signed release channel and
schedules the rollout; frame-update.py applies it.
{% endif %}
{% endblock %}
