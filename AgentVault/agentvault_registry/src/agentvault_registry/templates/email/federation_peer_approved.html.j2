{% extends "_base.html.j2" %}
{% set theme = "neural" %}
{% set kicker = "// FEDERATION APPROVED" %}
{% set headline = "Your registry is now a peer" %}

{% block body %}
<p>Your registry's federation request has been <strong>approved</strong>. It is now an <strong>ACTIVE</strong> peer of {{ approving_registry | default('TheProtocol') }} and participates in card sync, discovery, and cross-registry routing.</p>

{% with rows=[
  ('Registry name', peer_name),
  ('Base URL', peer_base_url),
  ('Approved at', approved_at)
] %}
{% include '_partials/data_table.html' %}
{% endwith %}

{% with notice="Federation sync begins on the next cycle; your registry's public agent cards become discoverable across the federation, and peers' cards sync to you. No action is required on your side." %}
{% include '_partials/info_box.html' %}
{% endwith %}
{% endblock %}
