{% extends "_base.html.j2" %}
{% set theme = "sovereign" %}
{% set kicker = "// SECURITY ACTION REQUIRED" %}
{% set headline = "Password Reset Request" %}
{% block body %}
<p>Operator <strong>{{ username }}</strong>,</p>
<p>A password reset was requested for your account on <strong>TheProtocol</strong> ({{ registry_name }}). The link below is valid for <strong>{{ expiry_hours | default(24) }} hour{{ '' if expiry_hours == 1 else 's' }}</strong>. Do not share it.</p>
{% with cta_url=reset_link, cta_label="RESET PASSWORD" %}{% include '_partials/cta_button.html' %}{% endwith %}
{% with notice="If you did not request this reset, ignore this email and consider rotating your password from the account settings as a precaution. If you believe this is suspicious activity, contact your registry administrator immediately." %}{% include '_partials/info_box.html' %}{% endwith %}
{% endblock %}
