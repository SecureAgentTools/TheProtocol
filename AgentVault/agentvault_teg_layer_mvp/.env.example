# TEG Core Service Configuration
# Copy this file to .env and update values

# Database
DATABASE_URL=sqlite:///./teg_database.db

# Security
ADMIN_API_KEY=your-secure-admin-key-here

# Application
DEBUG=False
LOG_LEVEL=INFO

# Token Economy Settings
DEFAULT_TRANSFER_FEE=0.0
MIN_TRANSFER_AMOUNT=0.01
# MAX_TRANSFER_AMOUNT=  # Optional, no limit if not set

# Reputation Settings
W1_STAKE_WEIGHT=0.1
W2_ATTESTATION_WEIGHT=2.0
W3_SUCCESSFUL_TXN_WEIGHT=1.0
W4_FAILED_TXN_WEIGHT=2.0
W5_CRITICAL_FLAG_PENALTY=50.0
W6_NEGATIVE_DDR_PENALTY=100.0
MAX_STAKE_EFFECTIVE_FOR_REP=1000.0
MIN_REPUTATION_SCORE=0

# Reward Settings
ATTESTATION_SUBMISSION_REWARD=0.1
TEG_SYSTEM_TREASURY_DID=did:agentvault:teg_system_treasury

# AVTP Integration
AVTP_SYSTEM_API_KEY=your-secure-avtp-key-here
