# §ONESHOT P2.2 — the sidecar project's values (copy to .env.sidecars, mode 600; sidecars.wire() upserts the JSON lines)
# The Directory (directory/env.directory.example explains each key)
DIRECTORY_ANCHORS=
DIRECTORY_SYNC_SECONDS=60
DIRECTORY_MAX_HOPS=2
DIRECTORY_FULL_EVERY=30
DIRECTORY_HOPS_BY_REGISTRY={}
DIRECTORY_DB=/data/directory.db
DATABASE_URL=postgresql+asyncpg://unused:unused@127.0.0.1:1/unused
API_KEY_SECRET=directory-no-registry-access
# The auditor: one entry per frame, written by sidecars.wire() (DSN + key read from the frame's containers)
AUDITOR_EXTRA_FRAMES_JSON=[]
AUDITOR_ADMIN_TOKEN=
# Ports on this host (loopback) and where vmalert sends alerts
SIDECARS_PROM_PORT=9190
SIDECARS_VMALERT_PORT=8881
SIDECARS_AUDITOR_PORT=8045
SIDECARS_DIRECTORY_PORT=8600
SIDECARS_ALERTMANAGER_PORT=9094
SIDECARS_GRAFANA_PORT=3001
# Grafana: no default password — set one (the compose refuses to start without it)
SIDECARS_GRAFANA_ADMIN_USER=admin
SIDECARS_GRAFANA_ADMIN_PASSWORD=
SIDECARS_ALERTMANAGER_URL=http://alertmanager:9093
