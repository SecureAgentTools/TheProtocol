# =============================================================
# nginx mTLS Sidecar — THE DIRECTORY  (§MTLSGAP 2026-09-08, §SOVKIT T4 2026-09-14)
# =============================================================
# A TEMPLATE. `nginx-directory-entrypoint.sh` renders exactly ONE variable into it (the proxy trust
# marker below), then hands over to the shared sidecar entrypoint. The shared
# entrypoint substitutes nothing and nginx cannot read the environment, which is why this file is not
# `nginx-directory.conf` (that one stays as it was for `directory-legacy-nginx`, which binds it live).
#
# His question: *"i need to know if mtls is setup to directory otherwise we need to set this up
# too. everything is mtls enforced."* §MTLSGAP gave the index an identity and this read leg.
#
# WHY THE READ LEG IS THE ONE THAT MATTERS. The Directory is the single component that AGGREGATES
# every frame's cards, and `DISCOVERY_VIA_DIRECTORY` means registries render what it returns. An
# unauthenticated index is a place to INJECT.
#
# §SOVKIT T4: a verified handshake is not yet a READER. Every SVID of a trusted domain passes
# `ssl_verify_client on`, the operators that share their parent's trust domain included, so the
# Directory itself now decides who reads (`directory/reader_gate.py`): it believes the X-SSL-* headers
# only on a request that carries X-Directory-Proxy-Auth, which this file sets and a caller cannot,
# and it serves only the SPIFFE IDs in DIRECTORY_READERS. The plain 127.0.0.1:8600 publish that
# stood beside this sidecar "during the transition" is gone.
# =============================================================

# Health check server (plain HTTP, no mTLS) — this is what compose healthchecks. Deliberately NOT
# the mTLS port: a healthcheck that needs a client cert reports the CERT's state, not the proxy's.
server {
    listen 8080;
    server_name _;

    location /health {
        return 200 '{"status":"healthy","service":"nginx-directory","mode":"mtls-sidecar"}\n';
        add_header Content-Type application/json;
    }
}

server {
    listen 8443 ssl;
    server_name _;

    # --- Server certificate (the Directory's own SPIRE SVID, written by its cert-writer) ---
    ssl_certificate       /certs/svid.0.pem;
    ssl_certificate_key   /certs/svid.0.key;

    # --- Client certificate verification (mTLS) ---
    # `on`, not `optional_no_ca`: this is the read leg, and an unverified caller must be refused
    # at the handshake rather than reach a query. The bundle carries this frame's roots plus the
    # federated peer roots the cert-writer merges into it.
    ssl_client_certificate /certs/bundle.0.pem;
    ssl_verify_client      on;
    ssl_verify_depth       2;

    ssl_protocols          TLSv1.2 TLSv1.3;
    ssl_ciphers            HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache      shared:SSL:1m;
    ssl_session_timeout    5m;

    location / {
        # `resolver` is REQUIRED: without it nginx resolves the upstream once at config load and
        # caches the IP for ever, so any Directory recreate becomes a permanent 502. Every sibling
        # sidecar in this fleet carries the same note, each after learning it the hard way.
        resolver 127.0.0.11 valid=10s;
        set $upstream http://directory:8600;
        proxy_pass $upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Client cert forwarding: the Directory authorises the reader by the SPIFFE ID in this certificate.
        proxy_set_header X-SSL-Client-Cert   $ssl_client_escaped_cert;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-S-DN   $ssl_client_s_dn;

        # §SOVKIT T4: the proof that a request came through THIS terminator. proxy_set_header replaces
        # whatever a caller sent under the same name, so nobody who reaches the sidecar can supply it.
        proxy_set_header X-Directory-Proxy-Auth "${DIRECTORY_PROXY_TRUST_SECRET}";

        # mTLS is the authority on this hop: a caller must not be able to hand us a weaker one.
        proxy_set_header X-Internal-Key       "";
        proxy_set_header X-Federation-Secret  "";
        proxy_set_header X-Federation-License "";

        proxy_connect_timeout 15s;
        proxy_read_timeout    60s;
        proxy_send_timeout    30s;
    }
}
