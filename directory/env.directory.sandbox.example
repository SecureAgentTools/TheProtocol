# THE DIRECTORY — sandbox tier. No secrets in this file.
# Anchors are the two sandbox FRAMES; their operators are reached through the frames'
# federation tables (peer_type=cloud_operator, ACTIVE), exactly as EU/ASIA reach theirs.
# Measured before setting this: both anchors serve the public card, the agent-card index feed
# (with the `applied_filters` echo) and the federation profile over plain HTTPS, no client cert.
DIRECTORY_ANCHORS=https://sandbox-a.theprotocol.cloud,https://sandbox-b.theprotocol.cloud
DIRECTORY_SYNC_SECONDS=60
DIRECTORY_MAX_HOPS=2
# a full pass every 2 cycles so a gate run can observe one (the only pass that sees a deletion)
DIRECTORY_FULL_EVERY=2
# 0 for the two cloud operators: an operator's federation table names only its parent, so
# following it further is a walk back to where we started. Keyed by card name OR host —
# hosts here, because they are unambiguous (read off each operator's own public_url).
DIRECTORY_HOPS_BY_REGISTRY={"sbxalphaop.op.theprotocol.cloud": 0, "sbxbetaop.op.theprotocol.cloud": 0}
DIRECTORY_DB=/data/directory.db
# the registry package's config wants these at import; the Directory opens no registry database
DATABASE_URL=postgresql+asyncpg://unused:unused@127.0.0.1:1/unused
API_KEY_SECRET=directory-sandbox-no-registry-access
