# THE DIRECTORY (trial) — no secrets in this file
DIRECTORY_ANCHORS=https://eu.theprotocol.cloud,https://asia.theprotocol.cloud
DIRECTORY_SYNC_SECONDS=60
DIRECTORY_MAX_HOPS=2
# §DIRFEED — cycles between FULL passes (the only pass that can notice a card went away). 2 on the
# trial so a gate run can observe one; a real Directory wants 30-60 with a 60s cycle.
DIRECTORY_FULL_EVERY=2
# §DISCPANEL — hop depth PER SOURCE (his ask): the default above applies to anything not named here.
# A registry with hardware to spare can index further out than one without, and neither has to agree
# with the other. 0 = index that registry's own cards and follow nothing further from it — which is the
# honest setting for a cloud operator, whose federation table names only its parent.
DIRECTORY_HOPS_BY_REGISTRY={"amsterdam": 0, "lisbon": 0, "shenzhen": 0, "hochiminh": 0}
DIRECTORY_DB=/data/directory.db
# the registry package's config wants these at import; the Directory never opens a database of a registry
DATABASE_URL=postgresql+asyncpg://unused:unused@127.0.0.1:1/unused
API_KEY_SECRET=directory-trial-no-registry-access
